---
// src/components/Navbar.astro
import ThemeToggle from './ThemeToggle.astro';
import AnimToggle from './AnimToggle.astro';
const user = Astro.locals.user;
const profile = Astro.locals.profile;

// Naming dinámico según rol
function getPanelInfo(role: string | undefined) {
  switch (role) {
    case 'superadmin':
      return { primary: { href: '/admin', label: 'Panel Admin' }, secondary: { href: '/dashboard', label: 'Dashboard' } };
    case 'admin':
      return { primary: { href: '/admin', label: 'Panel Admin' }, secondary: null };
    case 'juez':
      return { primary: { href: '/evaluacion', label: 'Evaluación' }, secondary: null };
    case 'mentor':
      return { primary: { href: '/mentoria', label: 'Mentoría' }, secondary: null };
    default:
      return { primary: { href: '/dashboard', label: 'Panel' }, secondary: null };
  }
}

const panelInfo = user ? getPanelInfo(profile?.role) : null;
---

<nav class="navbar" id="navbar">
    <div class="container nav-c">
        <a href="/#inicio" class="nav-logo">
            <img src="/img/brand/MARCA_SIMPLE_NEGRO_SIN_FONDO.png" alt="Hackathon EduTech" class="brand-logo" />
        </a>
        
        <div class="nav-menu" id="navMenu">
            <ul class="nav-links">
                <li><a href="/#inicio">Inicio</a></li>
                <li><a href="/#acerca">Acerca</a></li>
                <li><a href="/#cronograma">Cronograma</a></li>
                <li><a href="/ediciones">Ediciones</a></li>
                <li><a href="/#faq">FAQ</a></li>
            </ul>
            <div class="nav-act" id="nav-auth-buttons">
                {user && panelInfo ? (
                    <div class="nav-act-logged">
                        <a href={panelInfo.primary.href} class="btn btn-primary">{panelInfo.primary.label}</a>
                        {panelInfo.secondary && (
                            <a href={panelInfo.secondary.href} class="btn btn-outline">{panelInfo.secondary.label}</a>
                        )}
                    </div>
                ) : (
                    <>
                        <a href="/login" class="btn btn-outline">Iniciar Sesión</a>
                        <a href="/registro" class="btn btn-primary">Registro</a>
                    </>
                )}
            </div>

            <!-- Sección inferior del menú móvil -->
            <div class="mobile-menu-footer">
                {user && (
                    <button class="mobile-logout-btn btn-logout">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Cerrar Sesión
                    </button>
                )}
                <div class="mobile-anim-row">
                    <span class="mobile-anim-label">Fondo Animado</span>
                    <AnimToggle />
                </div>
            </div>
        </div>

        <div class="nav-actions-container">
            <ThemeToggle />

            <!-- Mini-dropdown de usuario en escritorio -->
            <div class="user-dropdown" id="userDropdown" style={user ? "display: block;" : "display: none;"}>
                <button class="user-dropdown-trigger" id="userDropdownTrigger" aria-label="Menú de usuario" title="Cuenta">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </button>
                <div class="user-dropdown-menu" id="userDropdownMenu">
                    <a href={panelInfo?.primary?.href || "#"} id="dropdown-primary-link" class="dropdown-item" style={panelInfo?.primary ? "display: flex;" : "display: none;"}>
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2-2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        <span id="dropdown-primary-label">{panelInfo?.primary?.label || "Panel"}</span>
                    </a>
                    <a href={panelInfo?.secondary?.href || "#"} id="dropdown-secondary-link" class="dropdown-item" style={panelInfo?.secondary ? "display: flex;" : "display: none;"}>
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span id="dropdown-secondary-label">{panelInfo?.secondary?.label || "Dashboard"}</span>
                    </a>
                    <div class="dropdown-item dropdown-anim-item">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        <span style="flex-grow: 1; margin-right: 0.5rem;">Fondo Animado</span>
                        <AnimToggle />
                    </div>
                    <button class="dropdown-item dropdown-logout btn-logout">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Cerrar Sesión
                    </button>
                </div>
            </div>

            <button class="nav-toggle" id="navToggle" aria-label="Menú">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</nav>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-h);
        z-index: 1000;
        background: var(--bg-1);
        border-bottom: 1px solid transparent;
        transition: background var(--t-theme), border-color var(--t-base), box-shadow var(--t-base);
    }

    .navbar.scrolled {
        background: var(--bg-2);
        border-bottom-color: var(--brd-s);
        box-shadow: var(--sh-sm);
    }

    .nav-c {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--txt-1);
        z-index: 10;
    }

    .brand-logo {
        height: 32px;
        width: auto;
        transition: filter var(--t-theme);
    }

    :global([data-theme="brand-dark"]) .brand-logo {
        filter: invert(1) brightness(2);
    }

    .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        z-index: 10;
    }

    .nav-toggle span {
        width: 22px;
        height: 2px;
        background: var(--txt-1);
        border-radius: 2px;
        transition: all var(--t-base);
        transform-origin: center;
    }

    .nav-toggle.active span:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
    }

    .nav-toggle.active span:nth-child(2) {
        opacity: 0;
    }

    .nav-toggle.active span:nth-child(3) {
        transform: rotate(-45deg) translate(5px, -5px);
    }

    .nav-menu {
        display: flex;
        align-items: center;
        gap: 2.5rem;
    }

    .nav-actions-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        z-index: 10;
    }

    .desktop-only {
        display: block;
    }

    .mobile-menu-footer {
        display: none;
    }

    .nav-links {
        display: flex;
        list-style: none;
        gap: 1.5rem;
        padding: 0;
        margin: 0;
    }

    .nav-links a {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--txt-2);
        letter-spacing: 0.02em;
        padding: 0.25rem 0;
        position: relative;
        transition: color var(--t-fast);
    }

    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--c1);
        transition: width var(--t-base);
    }

    .nav-links a:hover {
        color: var(--txt-1);
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    .nav-act {
        display: flex;
        gap: 0.75rem;
    }

    .nav-act .btn {
        font-size: 0.75rem;
        padding: 0.5rem 1.25rem;
    }

    .nav-act-logged {
        display: flex;
        gap: 0.5rem;
    }

    /* ── Mini-dropdown de usuario (PC) ── */
    .user-dropdown {
        position: relative;
    }

    .user-dropdown-trigger {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--bg-card);
        border: 1px solid var(--brd);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--txt-1);
        box-shadow: var(--sh-sm);
        transition: all var(--t-base);
    }

    .user-dropdown-trigger:hover,
    .user-dropdown-trigger:focus-visible {
        border-color: var(--c1);
        color: var(--c1);
        transform: scale(1.05);
        outline: none;
    }

    .user-dropdown-menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        min-width: 180px;
        background: var(--bg-card);
        border: 1px solid var(--brd);
        border-radius: var(--r-md);
        box-shadow: var(--sh-lg);
        padding: 0.375rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px) scale(0.96);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 100;
    }

    .user-dropdown.open .user-dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        width: 100%;
        padding: 0.625rem 0.75rem;
        border: none;
        background: none;
        color: var(--txt-1);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--r-sm);
        cursor: pointer;
        transition: background var(--t-fast), color var(--t-fast);
        text-decoration: none;
    }

    .dropdown-item:hover {
        background: rgba(136, 0, 123, 0.08);
        color: var(--c1);
    }

    .dropdown-anim-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.25rem 0.75rem;
        color: var(--txt-1);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--r-sm);
        transition: background var(--t-fast), color var(--t-fast);
    }

    .dropdown-anim-item:hover {
        background: rgba(136, 0, 123, 0.08);
        color: var(--c1);
    }

    .dropdown-logout {
        color: var(--txt-m);
        border-top: 1px solid var(--brd);
        margin-top: 0.25rem;
        padding-top: 0.75rem;
        border-radius: 0 0 var(--r-sm) var(--r-sm);
    }

    .dropdown-logout:hover {
        background: rgba(220, 38, 38, 0.08);
        color: #dc2626;
    }

    /* ── Accessibility focus-visible ── */
    .nav-links a:focus-visible,
    .nav-logo:focus-visible,
    .nav-toggle:focus-visible,
    .nav-act .btn:focus-visible,
    .nav-act-logged .btn:focus-visible,
    .user-dropdown-trigger:focus-visible {
        outline: 2px solid var(--c1);
        outline-offset: 4px;
        border-radius: var(--r-sm);
    }

    /* ── PC ── */
    @media (min-width: 860px) {
        .nav-toggle {
            display: none !important;
        }
        .nav-menu {
            display: flex !important;
            transform: none !important;
            position: static;
            background: none;
            flex-direction: row;
        }
        .mobile-menu-footer {
            display: none !important;
        }
        /* Ocultar botones de Auth en PC si está logueado */
        .navbar.logged-in #nav-auth-buttons {
            display: none !important;
        }
    }

    /* ── Móvil ── */
    @media (max-width: 859px) {
        .nav-toggle {
            display: flex;
        }
        .user-dropdown {
            display: none;
        }
        .nav-menu {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--bg-1);
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            transform: translateX(100%);
            transition: transform 0.4s var(--ease);
            z-index: 5;
            padding: 2rem;
        }
        .nav-menu.active {
            transform: translateX(0);
        }
        .nav-links {
            flex-direction: column;
            align-items: center;
            gap: 1.75rem;
        }
        .nav-links a {
            font-size: 1.25rem;
        }
        .nav-act {
            flex-direction: column;
            align-items: center;
            gap: 0;
        }
        .nav-act-logged {
            flex-direction: column;
            align-items: center;
            gap: 1.75rem;
        }
        .nav-act-logged .btn {
            /* Resetear estilo de botón para que parezca un link de navegación */
            all: unset;
            cursor: pointer;
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: var(--c1);
            text-align: center;
            padding: 0.25rem 0;
            position: relative;
            transition: color var(--t-fast), opacity var(--t-fast);
        }
        .nav-act-logged .btn:hover {
            opacity: 0.75;
        }
        /* Subrayado animado igual que los nav-links */
        .nav-act-logged .btn::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--c1);
            transition: width var(--t-base);
        }
        .nav-act-logged .btn:hover::after {
            width: 100%;
        }
        .desktop-only {
            display: none !important;
        }

        /* Sección inferior del menú móvil */
        .mobile-menu-footer {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            width: 80%;
            max-width: 260px;
            border-top: 1px solid var(--brd);
            padding-top: 1.5rem;
            margin-top: 0.5rem;
        }

        .mobile-logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.625rem 1rem;
            font-family: var(--font-body);
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--txt-m);
            background: none;
            border: 1px solid var(--brd);
            border-radius: var(--r-md);
            cursor: pointer;
            transition: all var(--t-fast);
        }

        .mobile-logout-btn:hover {
            color: #dc2626;
            border-color: #dc2626;
            background: rgba(220, 38, 38, 0.06);
        }

        .mobile-anim-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .mobile-anim-label {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--txt-m);
            font-weight: 500;
        }
    }
</style>

<script>
    const navbar = document.getElementById('navbar');
    
    // Scroll effect
    window.addEventListener('scroll', () => {
        const y = window.scrollY;
        if (navbar) {
            navbar.classList.toggle('scrolled', y > 50);
        }
    });

    // Mobile Menu
    const navToggle = document.getElementById('navToggle');
    const navMenu = document.getElementById('navMenu');
    
    if (navToggle && navMenu) {
        navToggle.addEventListener('click', () => {
            navToggle.classList.toggle('active');
            navMenu.classList.toggle('active');
            document.body.style.overflow = navMenu.classList.contains('active') ? 'hidden' : '';
        });

        navMenu.querySelectorAll('a').forEach(a => {
            a.addEventListener('click', () => {
                navToggle.classList.remove('active');
                navMenu.classList.remove('active');
                document.body.style.overflow = '';
            });
        });
    }

    // Mini-dropdown de usuario (PC)
    const dropdownTrigger = document.getElementById('userDropdownTrigger');
    const dropdown = document.getElementById('userDropdown');

    if (dropdownTrigger && dropdown) {
        dropdownTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('open');
        });

        // Cerrar al hacer clic fuera
        document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target as Node)) {
                dropdown.classList.remove('open');
            }
        });

        // Cerrar con Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                dropdown.classList.remove('open');
            }
        });
    }
</script>

<script>
    // Update Auth buttons on client-side (important for SSG landing page)
    import { createBrowserClient } from '@supabase/ssr';

    const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    // Naming dinámico por rol (mirror de la función del servidor)
    function getClientPanelInfo(role: string | undefined) {
        switch (role) {
            case 'superadmin':
                return { primary: { href: '/admin', label: 'Panel Admin' }, secondary: { href: '/dashboard', label: 'Dashboard' } };
            case 'admin':
                return { primary: { href: '/admin', label: 'Panel Admin' }, secondary: null };
            case 'juez':
                return { primary: { href: '/evaluacion', label: 'Evaluación' }, secondary: null };
            case 'mentor':
                return { primary: { href: '/mentoria', label: 'Mentoría' }, secondary: null };
            default:
                return { primary: { href: '/dashboard', label: 'Panel' }, secondary: null };
        }
    }

    async function checkAuth() {
        try {
            const { data: { session } } = await supabase.auth.getSession();
            const navbarEl = document.getElementById('navbar');
            const authContainer = document.getElementById('nav-auth-buttons');
            const userDropdown = document.getElementById('userDropdown');
            
            if (session) {
                // Agregar clase de estado de sesión activa al navbar
                navbarEl?.classList.add('logged-in');

                const { data: profile } = await supabase
                    .from('profiles')
                    .select('role')
                    .eq('id', session.user.id)
                    .single();

                const info = getClientPanelInfo(profile?.role);
                
                // Móvil: Inyectar links verticales en el menú
                if (authContainer) {
                    authContainer.innerHTML = `
                        <div class="nav-act-logged">
                            <a href="${info.primary.href}" class="btn btn-primary">${info.primary.label}</a>
                            ${info.secondary ? `<a href="${info.secondary.href}" class="btn btn-outline">${info.secondary.label}</a>` : ''}
                        </div>
                    `;
                }

                // Desktop: Mostrar y sincronizar dropdown
                if (userDropdown) {
                    userDropdown.style.display = 'block';

                    const primaryLink = document.getElementById('dropdown-primary-link') as HTMLAnchorElement | null;
                    const primaryLabel = document.getElementById('dropdown-primary-label');
                    if (primaryLink && primaryLabel) {
                        primaryLink.style.display = 'flex';
                        primaryLink.href = info.primary.href;
                        primaryLabel.textContent = info.primary.label;
                    }

                    const secondaryLink = document.getElementById('dropdown-secondary-link') as HTMLAnchorElement | null;
                    const secondaryLabel = document.getElementById('dropdown-secondary-label');
                    if (secondaryLink) {
                        if (info.secondary) {
                            secondaryLink.style.display = 'flex';
                            secondaryLink.href = info.secondary.href;
                            if (secondaryLabel) secondaryLabel.textContent = info.secondary.label;
                        } else {
                            secondaryLink.style.display = 'none';
                        }
                    }
                }
            } else {
                // Limpiar clase de estado y ocultar dropdown
                navbarEl?.classList.remove('logged-in');
                if (userDropdown) {
                    userDropdown.style.display = 'none';
                }
                // Restaurar botones de auth públicos
                if (authContainer) {
                    authContainer.innerHTML = `
                        <a href="/login" class="btn btn-outline">Iniciar Sesión</a>
                        <a href="/registro" class="btn btn-primary">Registro</a>
                    `;
                }
            }
        } catch (e) {
            console.error("Auth check failed", e);
        }
    }
    
    checkAuth();

    // Logout global: cerrar menú móvil + feedback visual + signOut
    document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement | null;
        const logoutBtn = target?.closest('.btn-logout') as HTMLButtonElement | null;
        if (!logoutBtn) return;
        
        e.preventDefault();
        
        // 1. Cerrar menú móvil y dropdown de escritorio inmediatamente
        const navToggle = document.getElementById('navToggle');
        const navMenu = document.getElementById('navMenu');
        const dropdown = document.getElementById('userDropdown');
        navToggle?.classList.remove('active');
        navMenu?.classList.remove('active');
        dropdown?.classList.remove('open');
        document.body.style.overflow = '';
        
        // 2. Feedback visual
        const originalText = logoutBtn.textContent;
        logoutBtn.textContent = 'Saliendo...';
        logoutBtn.disabled = true;
        
        // 3. Ejecutar signOut y redirigir
        try {
            await supabase.auth.signOut();
            window.location.href = '/';
        } catch (err) {
            console.error("Error signing out", err);
            logoutBtn.textContent = originalText;
            logoutBtn.disabled = false;
        }
    });
</script>
