---
// src/components/NewsSection.astro

// Cada noticia puede tener:
//   url    -> enlace externo (prensa). La tarjeta se vuelve clickeable.
//   fuente -> nombre del medio, se muestra en el "Leer más".
// Sin `url`, la tarjeta es un aviso informativo y no muestra el "Leer más".
// Ordenar siempre de más nueva a más vieja.
const NOTICIAS = [
  {
    fecha: "27 de Julio, 2026",
    titulo: "Educación: así es la inédita convocatoria que busca usar tecnología para la resolución de desafíos reales",
    extracto: "Los Andes cubrió la Hackathon EduTech 2026: equipos interdisciplinarios de estudiantes de tecnología, educación, comunicación, matemáticas y administración trabajando tres jornadas sobre desafíos educativos reales.",
    categoria: "Prensa",
    color: "var(--c1)",
    url: "https://www.losandes.com.ar/sociedad/educacion-asi-es-la-inedita-convocatoria-que-busca-usar-tecnologia-la-resolucion-desafios-reales-n6000024",
    fuente: "Los Andes"
  },
  {
    fecha: "24 de Mayo, 2026",
    titulo: "Nuevas Sedes Confirmadas para la Edición 2026",
    extracto: "Oficializamos las sedes de esta edición presencial: IES 9-023 y el Auditorio Municipal Marciano Cantero de Maipú. ¡Dos locaciones espectaculares para un evento intensivo!",
    categoria: "Sedes",
    color: "var(--c2)"
  },
  {
    fecha: "15 de Mayo, 2026",
    titulo: "Apertura de Inscripciones para Participantes",
    extracto: "Ya podés registrarte y postularte para formar parte de la Hackathon. Creá tu cuenta, completá tu perfil disciplinar y preparate para idear soluciones con impacto real.",
    categoria: "Registro",
    color: "var(--c1)"
  }
];
---

<section class="news" id="noticias">
  <div class="container">
    <div class="news-hdr reveal">
      <span class="section-label">Avisos del Evento</span>
      <h2 class="section-title text-gradient">Últimas Noticias</h2>
      <p class="section-desc">Mantenete al día con las novedades, anuncios oficiales y novedades clave para la hackathon.</p>
    </div>

    <div class="news-grid">
      {NOTICIAS.map((n, idx) => {
        // Con enlace la tarjeta entera es un <a>; sin enlace queda como <article>.
        const Tag = n.url ? 'a' : 'article';
        return (
          <Tag
            class={`card news-card reveal rd${idx + 1}${n.url ? ' news-card-link' : ''}`}
            href={n.url}
            target={n.url ? '_blank' : undefined}
            rel={n.url ? 'noopener noreferrer' : undefined}
          >
            <div class="news-card-header">
              <span class="news-badge" style={`background: rgba(var(--c${idx % 2 === 0 ? '2' : '1'}r), 0.08); color: ${n.color}; border: 1px solid rgba(var(--c${idx % 2 === 0 ? '2' : '1'}r), 0.15);`}>
                {n.categoria}
              </span>
              <time class="news-date" datetime={n.fecha}>{n.fecha}</time>
            </div>
            <h3 class="news-card-title">{n.titulo}</h3>
            <p class="news-card-excerpt">{n.extracto}</p>
            {n.url && (
              <div class="news-card-footer">
                <span class="news-read-more">
                  {n.fuente ? `Leer en ${n.fuente}` : 'Leer más'}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </span>
              </div>
            )}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .news {
    padding: var(--section-pad-y) 0;
    position: relative;
    overflow: hidden;
  }

  .news-hdr {
    margin-bottom: 5rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
    border: 1px solid var(--brd);
    position: relative;
    background: var(--bg-card);
  }

  /* La tarjeta con enlace externo es un <a>: neutralizamos estilos de link */
  .news-card-link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .news-card-link:focus-visible {
    outline: 2px solid var(--c1);
    outline-offset: 3px;
  }

  .news-card:hover {
    transform: translateY(-6px);
    border-color: var(--c1);
    box-shadow: 0 12px 30px -10px rgba(var(--c1r), 0.15);
  }

  .news-card:hover:nth-child(even) {
    border-color: var(--c2);
    box-shadow: 0 12px 30px -10px rgba(var(--c2r), 0.15);
  }

  .news-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .news-badge {
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .news-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--txt-m);
  }

  .news-card-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--txt-1);
    margin: 0 0 1rem 0;
    transition: color 0.3s ease;
  }

  .news-card:hover .news-card-title {
    color: var(--c1);
  }
  .news-card:hover:nth-child(even) .news-card-title {
    color: var(--c2);
  }

  .news-card-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--txt-2);
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  /* Sin footer no hace falta el espacio inferior del extracto */
  .news-card:not(.news-card-link) .news-card-excerpt {
    margin-bottom: 0;
  }

  .news-card-footer {
    margin-top: auto;
  }

  .news-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--txt-1);
    transition: transform 0.3s var(--ease), color 0.3s var(--ease);
  }

  .news-read-more svg {
    transition: transform 0.3s var(--ease);
  }

  .news-card:hover .news-read-more {
    color: var(--c1);
  }
  .news-card:hover:nth-child(even) .news-read-more {
    color: var(--c2);
  }

  .news-card:hover .news-read-more svg {
    transform: translateX(4px);
  }
</style>
