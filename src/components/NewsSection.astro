---
// src/components/NewsSection.astro
// Bloque del home: muestra las 3 noticias más recientes.
// Las noticias viven en src/content/noticias/ (un .md por noticia).
// Ver src/content.config.ts para los tipos de noticia y sus campos.
import { getNoticias } from '../utils/noticias';
import NewsCard from './NewsCard.astro';

const DESTACADAS = 3;
const todas = await getNoticias();
const noticias = todas.slice(0, DESTACADAS);
const hayMas = todas.length > DESTACADAS;
---

<section class="news" id="noticias">
  <div class="container">
    <div class="news-hdr reveal">
      <span class="section-label">Avisos del Evento</span>
      <h2 class="section-title text-gradient">Últimas Noticias</h2>
      <p class="section-desc">Mantenete al día con las novedades, anuncios oficiales y novedades clave para la hackathon.</p>
    </div>

    <div class="news-grid">
      {noticias.map((noticia, idx) => <NewsCard noticia={noticia} idx={idx} />)}
    </div>

    {hayMas && (
      <div class="news-cta reveal">
        <a href="/noticias" class="btn btn-outline">Ver todas las noticias</a>
      </div>
    )}
  </div>
</section>

<style>
  .news {
    padding: var(--section-pad-y) 0;
    position: relative;
    overflow: hidden;
  }

  .news-hdr {
    margin-bottom: 5rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news-cta {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }
</style>
