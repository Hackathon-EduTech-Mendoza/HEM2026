---
// src/components/Organizers.astro
---

<section class="organizers" id="organizan">
    <div class="container">
        <div class="org-hdr reveal">
            <span class="section-label">Instituciones</span>
            <h2 class="section-title">Organizan</h2>
            <p class="section-desc">La Hackathon EduTech es posible gracias al trabajo conjunto de dos instituciones de Nivel Superior de Mendoza.</p>
        </div>

        <div class="org-grid">
            <a href="https://ies9023-infd.mendoza.edu.ar/sitio/" target="_blank" rel="noopener noreferrer" class="card org-card reveal rd1">
                <div class="org-ico">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 6 3 6 3s6-1 6-3v-5"/></svg>
                </div>
                <h3>IES N°9-023</h3>
                <p>Instituto de Educación Superior de Maipú, Mendoza. Formación docente y técnica con compromiso social e innovación pedagógica.</p>
                <span class="org-link">Visitar sitio &rarr;</span>
            </a>

            <a href="https://superior.fundacionedison.org.ar/" target="_blank" rel="noopener noreferrer" class="card org-card reveal rd2">
                <div class="org-ico">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 6 3 6 3s6-1 6-3v-5"/></svg>
                </div>
                <h3>IES Tomás Alva Edison</h3>
                <p>Instituto de Educación Superior ubicado en Guaymallén, Mendoza. Referente en formación técnica, tecnológica e innovación educativa.</p>
                <span class="org-link">Visitar sitio &rarr;</span>
            </a>
        </div>
    </div>
</section>

<style>
    .organizers {
        padding: var(--section-pad-y) 0;
    }

    .org-hdr {
        margin-bottom: 6rem;
    }

    .org-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .org-card {
        padding: 2.5rem;
        text-align: center;
        text-decoration: none;
        color: inherit;
        transition: transform var(--ease) 0.3s, box-shadow var(--ease) 0.3s, border-color var(--ease) 0.3s;
    }

    .org-card:hover {
        transform: translateY(-4px);
        border-color: var(--c1);
    }

    .org-card:nth-child(2):hover {
        border-color: var(--c2);
    }

    .org-ico {
        width: 64px;
        height: 64px;
        border-radius: var(--r-md);
        background: rgba(var(--c1r), 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        transition: background var(--t-theme);
    }

    .org-ico svg {
        stroke: var(--c1);
        transition: stroke var(--t-theme);
    }

    .org-card:nth-child(2) .org-ico {
        background: rgba(var(--c2r), 0.1);
    }

    .org-card:nth-child(2) .org-ico svg {
        stroke: var(--c2);
    }

    .org-card h3 {
        font-family: var(--font-heading);
        font-size: 1.3rem;
        margin-bottom: 0.75rem;
        color: var(--txt-1);
    }

    .org-card p {
        font-size: 0.95rem;
        line-height: 1.75;
        color: var(--txt-2);
        margin: 0 0 1.5rem;
    }

    .org-link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--c1);
        letter-spacing: 0.05em;
        transition: color var(--t-fast);
    }

    .org-card:nth-child(2) .org-link {
        color: var(--c2);
    }

    @media (min-width: 768px) {
        .org-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
