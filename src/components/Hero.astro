---
// src/components/Hero.astro

/**
 * ESTADO POST-EVENTO (21/09/2026). La 2da edición terminó el 29 de agosto y el
 * Hero pasó a contarla en pasado. Qué se fue de acá, y por qué:
 *
 * - El cronómetro y el botón de la sala virtual. Con la fecha ya cumplida, el
 *   Hero venía anunciando "¡El evento ha comenzado!" tres semanas después del
 *   cierre, que es peor que no decir nada. Ojo: `eventDate` NO se "arregló"
 *   apuntándola a una fecha futura — la 3ra edición todavía no tiene fecha, y
 *   un countdown hacia un dato que nadie confirmó es justo el error que
 *   advertía el comentario anterior. Cuando haya fecha, el bloque vuelve.
 *
 * - El aviso de cupo (`AvisoCupo.astro`). El componente queda en el repo pero
 *   sin usar: este era su único punto de montaje, así que la barra fija también
 *   se retiró del sitio. Se vuelve a importar cuando abra la próxima edición.
 *
 * Los números del resumen son literales a propósito. El sitio público se
 * prerenderiza, así que leerlos de la base los congelaría igual en el build, y
 * a esta altura ya son definitivos (verificados en producción el 21/09: 130
 * participantes con equipo, 25 equipos, 25 proyectos entregados).
 */
const RESUMEN = [
  { valor: "130", etiqueta: "Participantes" },
  { valor: "25", etiqueta: "Equipos" },
  { valor: "25", etiqueta: "Proyectos" },
];
---

<section class="hero" id="inicio">
  <div class="container hero-c">
    <h1 class="hero-title">
      <span class="t-hackathon">HACKATHON</span>
      <span class="t-edutech">EDUTECH</span>
    </h1>
    <div class="hero-badge">
      <span class="badge-dot"></span>
      2da Edición &mdash; Finalizada
    </div>
    <p class="hero-desc">
      Del 26 al 29 de agosto de 2026, equipos interdisciplinarios del Nivel
      Superior de Mendoza trabajaron cuatro días para diseñar soluciones
      tecnológicas a los desafíos actuales de la educación. Estos fueron los
      resultados.
    </p>

    {/* Resumen de la edición. Ocupa el lugar que tenía el cronómetro, con la
       misma jerarquía visual: es lo primero que mira quien entra. */}
    <div class="hero-stats">
      {
        RESUMEN.map((dato) => (
          <div class="stat-item">
            <span class="stat-val">{dato.valor}</span>
            <span class="stat-label">{dato.etiqueta}</span>
          </div>
        ))
      }
    </div>

    <div class="hero-dates">
      <div class="date-chip">
        <strong>26-29 Ago 2026</strong> &mdash; Maipú, Mendoza
      </div>
      <div class="date-chip"><strong>10</strong> &mdash; Finalistas</div>
    </div>

    <div class="hero-act">
      <a href="/ganadores" class="btn btn-primary btn-lg glow-btn"
        >Ver los ganadores &rarr;</a
      >
      <a href="/noticias" class="btn btn-outline btn-lg">Cobertura y noticias</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    padding-top: var(--nav-h);
  }

  /* Claude-style radial gradient + Mimo-style theme handling */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 20% 0%,
        rgba(var(--c1r), 0.08),
        transparent 50%
      ),
      radial-gradient(circle at 80% 0%, rgba(var(--c2r), 0.08), transparent 50%);
    pointer-events: none;
    z-index: 0;
    transition: background var(--t-theme);
  }

  .hero-c {
    padding: 2rem 0;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c1);
    background: linear-gradient(
      135deg,
      rgba(var(--c1r), 0.08) 0%,
      rgba(var(--c2r), 0.08) 100%
    );
    border: 1px solid rgba(var(--c1r), 0.2);
    padding: 0.5rem 1rem;
    border-radius: var(--r-full);
    margin-bottom: 2.5rem;
    letter-spacing: 0.05em;
    transition: all var(--t-theme);

    opacity: 0;
    animation: fadeUp 0.7s var(--ease) forwards;
    animation-delay: 0.2s;
  }

  /* El punto ya no late: la pulsación decía "esto está pasando ahora" y la
     edición está cerrada. Queda como viñeta del badge. */
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c2);
    transition: background var(--t-theme);
  }

  .hero-title {
    /* ✨ VARIABLES PARA AJUSTAR EL ESPACIADO ENTRE "HACKATHON" Y "EDUTECH" ✨ */
    /* 1. Ajusta la separación general (usa px, rem, o negativos si quieres que se superpongan) */
    --espaciado-palabras: 0px;
    /* 2. Ajusta la altura de línea de cada palabra (menor valor = más juntas) */
    --altura-linea: 0.9;

    font-size: clamp(3rem, 8vw, 6rem);
    line-height: var(--altura-linea);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--espaciado-palabras);

    opacity: 0;
    animation: fadeUp 0.7s var(--ease) forwards;
    animation-delay: 0.2s;
  }

  .t-hackathon {
    font-family: var(--font-body);
    font-weight: 200;
    color: var(--c2);
    transition: color var(--t-theme);
  }

  .t-edutech {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--c1);
    transition: color var(--t-theme);
    font-size: clamp(4rem, 11vw, 9rem);
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--txt-2);
    max-width: 650px;
    line-height: 1.8;
    margin-bottom: 2.5rem;

    opacity: 0;
    animation: fadeUp 0.7s var(--ease) forwards;
    animation-delay: 0.55s;
  }

  /* Resumen de la edición: hereda el tratamiento que tenía el cronómetro
     (dígito grande con degradado + etiqueta en versalitas). */
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;

    opacity: 0;
    animation: fadeUp 0.7s var(--ease) forwards;
    animation-delay: 0.65s;
  }

  .stat-item {
    text-align: center;
  }

  .stat-val {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--c1) 0%, var(--c2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--txt-2);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  /* Claude-style Dates */
  .hero-dates {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 2.5rem;

    opacity: 0;
    animation: fadeUp 0.7s var(--ease) forwards;
    animation-delay: 0.75s;
  }

  .date-chip {
    padding: 10px 20px;
    background: var(--bg-card);
    border: 1px solid var(--brd);
    border-radius: var(--r-full);
    font-size: 0.9rem;
    color: var(--txt-2);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .date-chip strong {
    font-weight: 600;
  }

  .date-chip:nth-child(1) strong {
    color: var(--c2);
  }

  .date-chip:nth-child(2) strong {
    color: var(--c1);
  }

  .hero-act {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;

    opacity: 0;
    animation: fadeUp 0.7s var(--ease) forwards;
    animation-delay: 0.85s;
  }

  .glow-btn {
    animation: btnGlow 5s ease-in-out infinite;
  }

  @keyframes btnGlow {
    0%,
    100% {
      box-shadow: 0 4px 12px rgba(var(--c1r), 0.2);
    }
    50% {
      box-shadow:
        0 6px 32px rgba(var(--c1r), 0.4),
        0 0 16px rgba(var(--c1r), 0.15);
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 1024px) {
    .hero-c {
      padding: 4rem 0;
    }
  }
  @media (max-width: 640px) {
    .hero-stats {
      gap: 12px;
    }
  }
  @media (max-width: 360px) {
    .hero-stats {
      gap: 8px;
    }
    .stat-val {
      font-size: 1.75rem;
    }
    .stat-label {
      font-size: 0.6rem;
      letter-spacing: 0.05em;
    }
    .hero-dates {
      gap: 8px;
    }
    .date-chip {
      padding: 8px 14px;
      font-size: 0.8rem;
    }
  }
</style>
