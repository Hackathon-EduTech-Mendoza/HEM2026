---
// src/components/Footer.astro
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/Logo_Tema_Claro.png';
import logoDark from '../assets/brand/Logo_Tema_Oscuro.png';
import { EMAIL } from '../utils/contacto';
---

<footer class="site-footer">
    <div class="container">
        <div class="ftr-top">
            <div class="ftr-brand">
                <a href="/#inicio" class="nav-logo" style="margin-bottom: 0.5rem;">
                    <Image src={logoLight} alt="Hackathon EduTech" width={240} height={64} densities={[1, 2]} format="webp" class="brand-logo logo-light" loading="lazy" />
                    <Image src={logoDark} alt="Hackathon EduTech" width={240} height={64} densities={[1, 2]} format="webp" class="brand-logo logo-dark" loading="lazy" />
                </a>
                <p>HACKATHON EDUTECH 2026 - Segunda Edición. Organizada por el IES 9-023 de Maipú y el IES Tomás Alva Edison.</p>
            </div>
            <div class="ftr-links">
                <div class="ftr-col">
                    <p class="ftr-heading">Evento</p>
                    <ul>
                        <li><a href="/#acerca">Acerca</a></li>
                        <li><a href="/#cronograma">Cronograma</a></li>
                        <li><a href="/ganadores">Ganadores</a></li>
                        <li><a href="/recursos">Recursos</a></li>
                        <li><a href="/noticias">Noticias</a></li>
                        <li><a href="/ediciones">Ediciones anteriores</a></li>
                        <li><a href="/#faq">Preguntas frecuentes</a></li>
                    </ul>
                </div>
                <div class="ftr-col">
                    <p class="ftr-heading">Participá</p>
                    <ul>
                        <li><a href="/registro">Inscripción</a></li>
                        <li><a href="/bases-y-condiciones">Bases y Condiciones</a></li>
                        <li><a href="/#consultas">Consultas</a></li>
                        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
                    </ul>
                </div>
                <div class="ftr-col">
                    <p class="ftr-heading">Organizan</p>
                    <ul>
                        <li>
                            <a href="https://ies9023-infd.mendoza.edu.ar/sitio/" target="_blank" rel="noopener noreferrer">IES N°9-023 Maipú</a>
                            <a href="https://www.instagram.com/ies9023maipu/" target="_blank" rel="noopener noreferrer" class="ftr-instagram-link" title="Instagram IES N°9-023 Maipú" aria-label="Instagram IES N°9-023 Maipú" style="margin-left: 0.5rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                            </a>
                        </li>
                        <li>
                            <a href="https://superior.fundacionedison.org.ar/" target="_blank" rel="noopener noreferrer">IES Tomás Alva Edison</a>
                            <a href="https://www.instagram.com/superioredison/" target="_blank" rel="noopener noreferrer" class="ftr-instagram-link" title="Instagram IES Tomás Alva Edison" aria-label="Instagram IES Tomás Alva Edison" style="margin-left: 0.5rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="ftr-bot">
            <p class="ftr-aval">
                Propuesta avalada y autorizada por la <strong>Dirección de Educación Superior (DGE)</strong>,
                con <strong>puntaje docente y aval técnico</strong> —
                <a href="/docs/resolucion-0180-2026-puntaje-docente.pdf" target="_blank" rel="noopener noreferrer">Res. N.º 0180/2026</a>, curso N.º 7812.
                Sujeto a <a href="/bases-y-condiciones#art-premios">requisitos de acreditación</a>.
            </p>
            <p class="ftr-copy ftr-copyright">&copy; 2026 Hackathon EduTech Mendoza. Todos los derechos reservados.</p>
            <div class="ftr-copy ftr-credits">
                <span>Plataforma diseñada y desarrollada por<br /><span class="ftr-author"><a href="https://www.linkedin.com/in/nahuel-ghilardi/" target="_blank" rel="noopener noreferrer" class="author-link">Matías Nahuel Ghilardi</a>.</span></span>
                <span>Testing y QA por el Equipo EduTech.</span>
            </div>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        padding: 1.5rem 0 1rem;
        border-top: 1px solid var(--brd);
        position: relative;
        z-index: 1;
        transition: border-color var(--t-theme);
        background: var(--bg-1);
    }

    .ftr-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 3rem;
        margin-bottom: 1.5rem;
    }

    .ftr-brand {
        max-width: 300px;
    }

    .ftr-brand p {
        font-size: 0.875rem;
        margin-top: 1rem;
        color: var(--txt-2);
        line-height: 1.6;
    }

    .ftr-socials {
        display: flex;
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .ftr-social-link {
        color: var(--txt-2);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--r-sm);
        border: 1px solid var(--brd);
        transition: all var(--t-fast);
    }

    .ftr-social-link:hover {
        color: var(--c1);
        border-color: var(--c1);
        background: rgba(var(--c1r), 0.05);
        transform: translateY(-2px);
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--txt-1);
    }

    .brand-logo {
        height: 32px;
        width: auto;
    }

    .logo-dark {
        display: none !important;
    }

    :global([data-theme="brand-dark"]) .logo-light {
        display: none !important;
    }

    :global([data-theme="brand-dark"]) .logo-dark {
        display: block !important;
    }

    .ftr-links {
        display: flex;
        gap: 3rem;
        flex-wrap: wrap;
    }

    .ftr-col .ftr-heading {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--txt-m);
        margin-bottom: 1rem;
    }

    .ftr-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .ftr-col li {
        margin-bottom: 0.5rem;
    }

    .ftr-col a {
        font-size: 0.875rem;
        color: var(--txt-2);
        transition: color var(--t-fast);
        text-decoration: none;
    }

    .ftr-col a:hover {
        color: var(--c1);
    }

    /* Tres columnas con el copyright exactamente al medio de la página: el
       `auto` del centro se lleva su ancho de contenido y los dos `1fr` se
       reparten el resto en partes iguales.
       `baseline` y no `center`: las tres columnas tienen distinta cantidad de
       renglones, así que centrarlas dejaba el copyright a la altura del último
       renglón de los costados. Alineado por línea de base, arranca parejo con
       el primero de cada columna aunque cambien las tipografías y los cuerpos. */
    .ftr-bot {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: baseline;
        gap: 1rem 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--brd-s);
    }

    .ftr-copyright {
        text-align: center;
        margin: 0;
    }

    /* El nombre no se parte: sin esto el apellido cae solo a un renglón. */
    .ftr-author {
        white-space: nowrap;
    }

    .ftr-credits {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        text-align: right;
        color: var(--txt-2);
        margin: 0;
    }

    /* La línea del aval es una oración, no un crédito: sale del mono y del
       letter-spacing de .ftr-copy, que a dos renglones se leen pesados. */
    .ftr-aval {
        font-family: var(--font-body, inherit);
        font-size: 0.75rem;
        letter-spacing: normal;
        line-height: 1.7;
        max-width: 46ch;
        margin: 0;
        color: var(--txt-2);
    }

    .ftr-aval a {
        color: var(--txt-2);
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color var(--t-fast);
    }

    .ftr-aval a:hover {
        color: var(--c1);
    }

    .author-link {
        color: var(--c1);
        text-decoration: none;
        font-weight: 500;
        transition: opacity var(--t-fast);
    }
    .author-link:hover {
        opacity: 0.8;
    }

    .ftr-copy {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--txt-m);
        letter-spacing: 0.05em;
    }

    /* Por debajo de ~900px las tres columnas dejan el aval en una tira de 4 o 5
       renglones. Se apila y se centra, con el copyright al final: en columna, el
       orden útil es información primero y firma después. */
    @media (max-width: 900px) {
        .ftr-bot {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
            gap: 1.25rem;
        }
        .ftr-aval {
            order: 1;
            max-width: 60ch;
        }
        .ftr-credits {
            order: 2;
            text-align: center;
        }
        .ftr-copyright {
            order: 3;
        }
    }

    @media (max-width: 767px) {
        .ftr-top {
            flex-direction: column;
            gap: 2rem;
        }
        .ftr-links {
            width: 100%;
            gap: 2.5rem;
            flex-direction: column;
        }
    .ftr-col li:has(.ftr-instagram-link) {
        display: flex;
        align-items: center;
    }
    .ftr-instagram-link {
        color: var(--txt-2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color var(--t-fast), transform var(--t-fast);
    }
    .ftr-instagram-link:hover {
        color: var(--c1);
        transform: scale(1.15) translateY(-1px);
    }
    }
</style>
