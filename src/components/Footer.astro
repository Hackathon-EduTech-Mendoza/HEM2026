---
// src/components/Footer.astro
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/Logo_Tema_Claro.png';
import logoDark from '../assets/brand/Logo_Tema_Oscuro.png';
import { WHATSAPP_URL, WHATSAPP_VISIBLE, EMAIL } from '../utils/contacto';
---

<footer class="site-footer">
    <div class="container">
        <div class="ftr-top">
            <div class="ftr-brand">
                <a href="/#inicio" class="nav-logo" style="margin-bottom: 0.5rem;">
                    <Image src={logoLight} alt="Hackathon EduTech" width={240} height={64} densities={[1, 2]} format="webp" class="brand-logo logo-light" loading="lazy" />
                    <Image src={logoDark} alt="Hackathon EduTech" width={240} height={64} densities={[1, 2]} format="webp" class="brand-logo logo-dark" loading="lazy" />
                </a>
                <p>HACKATHON EDUTECH 2026 - Segunda Edición. Organizada por el IES 9-023 de Maipú y el IES Tomás Alva Edison.</p>
            </div>
            <div class="ftr-links">
                <div class="ftr-col">
                    <p class="ftr-heading">Evento</p>
                    <ul>
                        <li><a href="/#acerca">Acerca</a></li>
                        <li><a href="/#cronograma">Cronograma</a></li>
                        <li><a href="/ediciones">Ediciones anteriores</a></li>
                        <li><a href="/#faq">Preguntas frecuentes</a></li>
                    </ul>
                </div>
                <div class="ftr-col">
                    <p class="ftr-heading">Participá</p>
                    <ul>
                        <li><a href="/registro">Inscripción</a></li>
                        <li><a href="/bases-y-condiciones">Bases y Condiciones</a></li>
                        <li><a href={`mailto:${EMAIL}`}>Contacto</a></li>
                        <li>
                            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="ftr-whatsapp">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.358.101 11.943c0 2.096.549 4.142 1.595 5.945L0 24l6.305-1.654a11.9 11.9 0 0 0 5.734 1.46h.005c6.584 0 11.946-5.359 11.949-11.945a11.9 11.9 0 0 0-3.473-8.412"/></svg>
                                {WHATSAPP_VISIBLE}
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="ftr-col">
                    <p class="ftr-heading">Organizan</p>
                    <ul>
                        <li>
                            <a href="https://ies9023-infd.mendoza.edu.ar/sitio/" target="_blank" rel="noopener noreferrer">IES N°9-023 Maipú</a>
                            <a href="https://www.instagram.com/ies9023maipu/" target="_blank" rel="noopener noreferrer" class="ftr-instagram-link" title="Instagram IES N°9-023 Maipú" aria-label="Instagram IES N°9-023 Maipú" style="margin-left: 0.5rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                            </a>
                        </li>
                        <li>
                            <a href="https://superior.fundacionedison.org.ar/" target="_blank" rel="noopener noreferrer">IES Tomás Alva Edison</a>
                            <a href="https://www.instagram.com/superioredison/" target="_blank" rel="noopener noreferrer" class="ftr-instagram-link" title="Instagram IES Tomás Alva Edison" aria-label="Instagram IES Tomás Alva Edison" style="margin-left: 0.5rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="ftr-bot">
            <div class="ftr-copy ftr-credits">
                <span>&copy; 2026 Hackathon EduTech Mendoza. Todos los derechos reservados.</span>
                <span>Plataforma diseñada y desarrollada por <a href="https://www.linkedin.com/in/nahuel-ghilardi/" target="_blank" rel="noopener noreferrer" class="author-link">Matías Nahuel Ghilardi</a>.</span>
                <span>Testing y QA por el Equipo EduTech.</span>
            </div>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        padding: 1.5rem 0 1rem;
        border-top: 1px solid var(--brd);
        position: relative;
        z-index: 1;
        transition: border-color var(--t-theme);
        background: var(--bg-1);
    }

    .ftr-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 3rem;
        margin-bottom: 1.5rem;
    }

    .ftr-brand {
        max-width: 300px;
    }

    .ftr-brand p {
        font-size: 0.875rem;
        margin-top: 1rem;
        color: var(--txt-2);
        line-height: 1.6;
    }

    .ftr-socials {
        display: flex;
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .ftr-social-link {
        color: var(--txt-2);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--r-sm);
        border: 1px solid var(--brd);
        transition: all var(--t-fast);
    }

    .ftr-social-link:hover {
        color: var(--c1);
        border-color: var(--c1);
        background: rgba(var(--c1r), 0.05);
        transform: translateY(-2px);
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--txt-1);
    }

    .brand-logo {
        height: 32px;
        width: auto;
    }

    .logo-dark {
        display: none !important;
    }

    :global([data-theme="brand-dark"]) .logo-light {
        display: none !important;
    }

    :global([data-theme="brand-dark"]) .logo-dark {
        display: block !important;
    }

    .ftr-links {
        display: flex;
        gap: 3rem;
        flex-wrap: wrap;
    }

    .ftr-col .ftr-heading {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--txt-m);
        margin-bottom: 1rem;
    }

    .ftr-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .ftr-col li {
        margin-bottom: 0.5rem;
    }

    .ftr-col a {
        font-size: 0.875rem;
        color: var(--txt-2);
        transition: color var(--t-fast);
        text-decoration: none;
    }

    .ftr-col a:hover {
        color: var(--c1);
    }

    .ftr-bot {
        display: flex;
        justify-content: center;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid var(--brd-s);
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ftr-credits {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        text-align: center;
        color: var(--txt-2);
        margin: 0;
    }

    .author-link {
        color: var(--c1);
        text-decoration: none;
        font-weight: 500;
        transition: opacity var(--t-fast);
    }
    .author-link:hover {
        opacity: 0.8;
    }

    .ftr-copy {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--txt-m);
        letter-spacing: 0.05em;
    }

    @media (max-width: 767px) {
        .ftr-top {
            flex-direction: column;
            gap: 2rem;
        }
        .ftr-links {
            width: 100%;
            gap: 2.5rem;
            flex-direction: column;
        }
        .ftr-bot {
            flex-direction: column;
            text-align: center;
        }
    .ftr-col li:has(.ftr-instagram-link) {
        display: flex;
        align-items: center;
    }
    .ftr-whatsapp {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .ftr-whatsapp svg {
        flex-shrink: 0;
    }

    .ftr-instagram-link {
        color: var(--txt-2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color var(--t-fast), transform var(--t-fast);
    }
    .ftr-instagram-link:hover {
        color: var(--c1);
        transform: scale(1.15) translateY(-1px);
    }
    }
</style>
