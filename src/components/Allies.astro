<section class="allies" id="aliados">
    <div class="container">
        <!-- La cabecera sí usa reveal (solo afecta al div, no al marquee) -->
        <div class="allies-hdr reveal">
            <span class="section-label">Red de Apoyo</span>
            <h2 class="section-title">Aliados Estratégicos</h2>
            <p class="section-desc">Instituciones que impulsan la innovación aportando mentorías, capacitaciones y premios.</p>
        </div>
    </div>

    <!--
        IMPORTANTE: No usar la clase "reveal" sobre el marquee-track ni allies-marquee.
        La clase reveal aplica transform: translateY() que entraría en conflicto con
        el transform: translateX() de la animación del carrusel, dejándolo estático.
        El marquee arranca visible directamente.
    -->
    <div class="allies-marquee">
        <div class="marquee-track">
            <!-- Set 1 -->
            <a href="https://www.underc0de.org/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <span class="undercode-bg">
                    <img src="/img/allies/fundacion-undercode.webp" alt="Fundación Undercode" class="marquee-logo" />
                </span>
            </a>
            <a href="https://edu.google.com/intl/es-419_ALL/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/google-for-education.webp" alt="Google for Education" class="marquee-logo" />
            </a>
            <a href="https://www.pmiandespatagonia.org/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/pmi-andes-patagonia.webp" alt="PMI Andes Patagonia" class="marquee-logo" />
            </a>
            <a href="https://21.edu.ar/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/universidad-siglo-21.webp" alt="Universidad Siglo 21" class="marquee-logo" />
            </a>

            <!-- Set 2 (duplicado para el loop infinito) -->
            <a href="https://www.underc0de.org/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <span class="undercode-bg">
                    <img src="/img/allies/fundacion-undercode.webp" alt="Fundación Undercode" class="marquee-logo" />
                </span>
            </a>
            <a href="https://edu.google.com/intl/es-419_ALL/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/google-for-education.webp" alt="Google for Education" class="marquee-logo" />
            </a>
            <a href="https://www.pmiandespatagonia.org/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/pmi-andes-patagonia.webp" alt="PMI Andes Patagonia" class="marquee-logo" />
            </a>
            <a href="https://21.edu.ar/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/universidad-siglo-21.webp" alt="Universidad Siglo 21" class="marquee-logo" />
            </a>

            <!-- Set 3 (duplicado para el loop infinito) -->
            <a href="https://www.underc0de.org/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <span class="undercode-bg">
                    <img src="/img/allies/fundacion-undercode.webp" alt="Fundación Undercode" class="marquee-logo" />
                </span>
            </a>
            <a href="https://edu.google.com/intl/es-419_ALL/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/google-for-education.webp" alt="Google for Education" class="marquee-logo" />
            </a>
            <a href="https://www.pmiandespatagonia.org/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/pmi-andes-patagonia.webp" alt="PMI Andes Patagonia" class="marquee-logo" />
            </a>
            <a href="https://21.edu.ar/" target="_blank" rel="noopener noreferrer" class="marquee-item">
                <img src="/img/allies/universidad-siglo-21.webp" alt="Universidad Siglo 21" class="marquee-logo" />
            </a>
        </div>
    </div>
</section>

<style>
    .allies {
        padding: 8rem 0;
        width: 100%;
        overflow: hidden;
    }

    .allies-hdr {
        margin-bottom: 4rem;
    }

    /* =============================================
       MARQUEE CONTAINER
       ============================================= */
    .allies-marquee {
        position: relative;
        width: 100%;
        padding: 2.5rem 0;
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    /* Gradiente difuminado en los bordes */
    .allies-marquee::before,
    .allies-marquee::after {
        content: "";
        position: absolute;
        top: 0;
        width: 12%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }

    .allies-marquee::before {
        left: 0;
        background: linear-gradient(to right, var(--bg-1) 0%, transparent 100%);
    }

    .allies-marquee::after {
        right: 0;
        background: linear-gradient(to left, var(--bg-1) 0%, transparent 100%);
    }

    /* =============================================
       MARQUEE TRACK — la animación corre aquí
       ============================================= */
    .marquee-track {
        display: flex;
        width: max-content;
        gap: 5rem;
        /* La animación de translateX NO puede estar en el mismo elemento
           que tenga un transform de reveal, por eso el marquee wrapper
           no lleva la clase .reveal */
        animation: scroll-marquee 28s linear infinite;
        will-change: transform;
    }

    .allies-marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    /* =============================================
       ITEMS
       ============================================= */
    .marquee-item {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 90px;
        width: 260px;
        flex-shrink: 0;
        text-decoration: none;
        outline: none;
    }

    /* =============================================
       LOGOS — filtro grayscale por defecto
       ============================================= */
    .marquee-logo {
        height: 65px;
        width: auto;
        max-width: 220px;
        object-fit: contain;
        display: block;
        filter: grayscale(1) opacity(0.6);
        transition: filter 0.3s ease, transform 0.3s ease;
    }

    .marquee-item:hover .marquee-logo {
        filter: grayscale(0) opacity(1);
        transform: scale(1.06);
    }

    /* =============================================
       UNDERCODE — el logo es blanco nativo.
       En lugar de invertirlo (que deforma colores),
       usamos un contenedor con fondo oscuro redondeado
       que funciona en AMBOS temas.
       ============================================= */
    .undercode-bg {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #1a1a2e;
        border-radius: 12px;
        padding: 10px 16px;
        height: 65px;
        width: auto;
        min-width: 160px;
        /* Aplicamos el grayscale+opacity al wrapper para que el hover funcione en cadena */
        filter: grayscale(1) opacity(0.6);
        transition: filter 0.3s ease, transform 0.3s ease;
    }

    .undercode-bg .marquee-logo {
        /* El img dentro del wrapper no necesita filtro propio */
        filter: none !important;
        height: 45px;
        transition: none;
    }

    .marquee-item:hover .undercode-bg {
        filter: grayscale(0) opacity(1);
        transform: scale(1.06);
    }

    .marquee-item:hover .undercode-bg .marquee-logo {
        transform: none;
    }

    /* =============================================
       DARK THEME — los logos oscuros se aclaran
       ============================================= */
    :global([data-theme="brand-dark"]) .marquee-logo {
        filter: grayscale(1) invert(1) brightness(1.8) opacity(0.6);
    }

    :global([data-theme="brand-dark"]) .marquee-item:hover .marquee-logo {
        filter: grayscale(0) invert(0) brightness(1) opacity(1);
    }

    /* En dark, el fondo oscuro del undercode sigue siendo oscuro (correcto) */
    :global([data-theme="brand-dark"]) .undercode-bg {
        background-color: #1a1a2e;
        filter: grayscale(1) opacity(0.7);
    }

    :global([data-theme="brand-dark"]) .undercode-bg .marquee-logo {
        filter: none !important;
    }

    :global([data-theme="brand-dark"]) .marquee-item:hover .undercode-bg {
        filter: grayscale(0) opacity(1);
    }

    /* =============================================
       KEYFRAMES
       ============================================= */
    @keyframes scroll-marquee {
        from { transform: translateX(0); }
        to   { transform: translateX(-33.3333%); }
    }

    /* =============================================
       RESPONSIVE
       ============================================= */
    @media (max-width: 768px) {
        .allies { padding: 60px 0; }

        .marquee-item {
            height: 70px;
            width: 190px;
        }

        .marquee-logo {
            height: 48px;
            max-width: 160px;
        }

        .undercode-bg {
            height: 52px;
            min-width: 120px;
            padding: 8px 12px;
        }

        .undercode-bg .marquee-logo {
            height: 36px;
        }

        .marquee-track {
            gap: 3.5rem;
        }
    }
</style>
