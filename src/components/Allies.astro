            </div>
            <div class="marquee-item">
                <img src="/img/allies/universidad-siglo-21.webp" alt="Universidad Siglo 21" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
        </div>
    </div>
</section>

<style>
    .allies {
        padding: 8rem 0;
        width: 100%;
        overflow: hidden;
    }

    .allies-hdr {
        margin-bottom: 4rem;
    }

    /* Marquee container - simplified, removed viewport margin hack since it is already outside container */
    .allies-marquee {
        position: relative;
        width: 100%;
        padding: 2rem 0;
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    /* Gradients to fade out edges */
    .allies-marquee::before,
    .allies-marquee::after {
        content: "";
        position: absolute;
        top: 0;
        width: 15%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }

    .allies-marquee::before {
        left: 0;
        background: linear-gradient(to right, var(--bg-1) 0%, transparent 100%);
    }

    .allies-marquee::after {
        right: 0;
        background: linear-gradient(to left, var(--bg-1) 0%, transparent 100%);
    }

    /* Scrolling track */
    .marquee-track {
        display: flex;
        width: max-content;
        animation: scroll-marquee 25s linear infinite;
        gap: 6rem;
    }

    /* Marquee hover pause */
    .allies-marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-item {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 80px;
        width: 220px;
        flex-shrink: 0;
    }

    .marquee-logo {
        height: 55px;
        width: auto;
        object-fit: contain;
        /* Default state: slightly dimmed and grayscale for sleek corporate look */
        filter: grayscale(1) opacity(0.65);
        transition: filter var(--t-base), opacity var(--t-base), transform var(--t-base);
    }

    /* Hover effect: reveal original colors and scale up slightly */
    .marquee-item:hover .marquee-logo {
        filter: grayscale(0) opacity(1);
        transform: scale(1.05);
    }

    /* Theme adaptive styling for dark theme to guarantee readability */
    :global([data-theme="brand-dark"]) .marquee-logo {
        /* In dark theme, if the logos are black/dark, we make them white/light */
        filter: grayscale(1) invert(0.8) brightness(1.5) opacity(0.7);
    }

    :global([data-theme="brand-dark"]) .marquee-item:hover .marquee-logo {
        filter: grayscale(0) invert(0) brightness(1) opacity(1);
    }

    @keyframes scroll-marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            /* Since we have 3 identical sets, moving by exactly 1/3 (one set) creates a perfect infinite loop */
            transform: translateX(-33.3333%);
        }
    }

    @media (max-width: 768px) {
        .allies {
            padding: 60px 0;
        }
        .marquee-item {
            height: 60px;
            width: 160px;
        }
        .marquee-logo {
            height: 40px !important;
        }
        .marquee-track {
            gap: 4rem;
        }
    }
</style>
