        <div class="marquee-track">
            <!-- Set 1 -->
            <div class="marquee-item">
                <img src="/img/allies/fundacion-undercode.webp" alt="Fundación Undercode" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/google-for-education.webp" alt="Google for Education" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/pmi-andes-patagonia.webp" alt="PMI Andes Patagonia" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/universidad-siglo-21.webp" alt="Universidad Siglo 21" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>

            <!-- Set 2 -->
            <div class="marquee-item">
                <img src="/img/allies/fundacion-undercode.webp" alt="Fundación Undercode" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/google-for-education.webp" alt="Google for Education" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/pmi-andes-patagonia.webp" alt="PMI Andes Patagonia" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/universidad-siglo-21.webp" alt="Universidad Siglo 21" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>

            <!-- Set 3 -->
            <div class="marquee-item">
                <img src="/img/allies/fundacion-undercode.webp" alt="Fundación Undercode" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
                <img src="/img/allies/google-for-education.webp" alt="Google for Education" class="marquee-logo" style="height: 55px; width: auto; object-fit: contain;" />
            </div>
            <div class="marquee-item">
