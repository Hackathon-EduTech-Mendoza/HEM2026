---
// src/components/Allies.astro

const allies = [
  {
    name: "Fundación Undercode",
    href: "https://www.underc0de.org/",
    logoLight: "/img/allies/fundacion-underc0de-negro.webp",
    logoDark: "/img/allies/fundacion-underc0de-blanco.webp",
    isDoubleLogo: true,
    height: "90px",
  },
  {
    name: "Google Partner",
    href: "https://edu.google.com/intl/es-419_ALL/",
    logoLight: "/img/allies/Google_Partner.webp",
    height: "90px",
  },
  {
    name: "DGE Mendoza",
    href: "https://www.mendoza.edu.ar/",
    logoLight: "/img/allies/DGE-Mendoza.webp",
    height: "90px",
  },
  {
    name: "EMESA",
    href: "https://emesa.com.ar/",
    logoLight: "/img/allies/EMESA.webp",
    height: "90px",
  },
  {
    name: "Gobierno de Mendoza",
    href: "https://www.mendoza.gob.ar/",
    logoLight: "/img/allies/Gobierno_Mendoza.webp",
    height: "90px",
  },
  {
    name: "City Pooling",
    href: "https://citypooling.com/",
    logoLight: "/img/allies/City_Pooling.webp",
    height: "90px",
  },
  {
    name: "Pronectis",
    href: "https://pronectis.com/",
    logoLight: "/img/allies/Pronectis.webp",
    height: "90px",
  },
  {
    name: "PMI Andes Patagonia",
    href: "https://www.pmiandespatagonia.org/",
    logoLight: "/img/allies/pmi-andes-patagonia.webp",
    height: "90px",
  },
  {
    name: "Universidad Siglo 21",
    href: "https://21.edu.ar/",
    logoLight: "/img/allies/universidad-siglo-21.webp",
    height: "90px",
  },
  {
    name: "Cuyo Connect",
    href: "https://cuyoconnect.com/",
    logoLight: "/img/allies/CuyoConnect.webp",
    height: "120px",
  },
  {
    /* Marca apilada (bajada + nombre + sello de la radio) en un lienzo casi
       cuadrado: a 90px el texto queda ilegible, porque la altura se reparte
       entre las tres líneas. Va a 130px, como Cuyo Connect, que tiene el mismo
       problema. */
    name: "El Cruce MDZ",
    href: "https://www.mdzol.com/mdzradio-programas",
    logoLight: "/img/allies/Marca-El-Cruce_MDZ.webp",
    height: "130px",
  },
  {
    /* Logotipo en una línea (10:1). El flex del item lo encierra en 250px, así
       que termina rindiendo a ~24px de alto: es lo que da el formato.
       Va con doble archivo porque el "INNOVA" es negro puro y en tema oscuro el
       invert del hover lo devuelve a negro sobre negro. La variante blanca
       conserva el azul de marca. */
    name: "Aureo Innova",
    href: "https://aureoinnova.com/",
    logoLight: "/img/allies/Aureo_Innova.webp",
    logoDark: "/img/allies/Aureo_Innova-blanco.webp",
    isDoubleLogo: true,
    height: "90px",
  },
];
---

<section class="allies" id="aliados">
  <div class="container">
    <div class="allies-hdr reveal">
      <span class="section-label">Red de Apoyo</span>
      <h2 class="section-title">Aliados Estratégicos</h2>
      <p class="section-desc">
        Instituciones que impulsan la innovación aportando mentorías,
        capacitaciones y premios.
      </p>
    </div>
  </div>

  <!-- Infinite Marquee Section (Full width, outside container for edge-to-edge scroll) -->
  <div class="allies-marquee reveal rd2">
    <div class="marquee-track">
      {/* Render 3 identical sets for infinite loop logic */}
      {
        [1, 2, 3].map(() =>
          allies.map((ally) => (
            <a
              href={ally.href}
              target="_blank"
              rel="noopener noreferrer"
              class="marquee-item"
            >
              {ally.isDoubleLogo ? (
                <>
                  <img
                    src={ally.logoLight}
                    alt={ally.name}
                    class="marquee-logo logo-light-theme"
                    loading="lazy"
                    decoding="async"
                    style={`height: ${ally.height}; width: auto; object-fit: contain;`}
                  />
                  <img
                    src={ally.logoDark}
                    alt={ally.name}
                    class="marquee-logo logo-no-invert logo-dark-theme"
                    loading="lazy"
                    decoding="async"
                    style={`height: ${ally.height}; width: auto; object-fit: contain;`}
                  />
                </>
              ) : (
                <img
                  src={ally.logoLight}
                  alt={ally.name}
                  class="marquee-logo"
                  loading="lazy"
                  decoding="async"
                  style={`height: ${ally.height}; width: auto; object-fit: contain;`}
                />
              )}
            </a>
          )),
        )
      }
    </div>
  </div>
</section>

<style>
  .allies {
    padding: var(--section-pad-y) 0;
    width: 100%;
    overflow: hidden;
  }

  .allies-hdr {
    margin-bottom: 4rem;
  }

  /* Marquee container */
  .allies-marquee {
    position: relative;
    width: 100%;
    padding: 2.5rem 0;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* Gradients to fade out edges */
  .allies-marquee::before,
  .allies-marquee::after {
    content: "";
    position: absolute;
    top: 0;
    width: 15%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .allies-marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--bg-1) 0%, transparent 100%);
  }

  .allies-marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--bg-1) 0%, transparent 100%);
  }

  /* Scrolling track */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll-marquee 25s linear infinite;
    gap: 6rem;
  }

  /* Marquee hover pause */
  .allies-marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 90px;
    width: 250px;
    flex-shrink: 0;
    cursor: pointer;
    text-decoration: none;
    outline: none;
  }

  /* --- BASE LOGO STYLING (Light Theme Default) --- */
  .marquee-logo {
    height: 65px;
    width: auto;
    object-fit: contain;
    /* Standard logos (Google, PMI, Siglo 21, Undercode Light) have dark text, visible as-is in light mode */
    filter: grayscale(1) opacity(0.65);
    transition:
      filter var(--t-base),
      opacity var(--t-base),
      transform var(--t-base);
  }

  /* Hover effect: reveal original colors and scale up slightly */
  .marquee-item:hover .marquee-logo {
    filter: grayscale(0) opacity(1);
    transform: scale(1.05);
  }

  /* Toggle logos based on theme */
  :global(.logo-dark-theme) {
    display: none !important;
  }
  :global(.logo-light-theme) {
    display: block !important;
  }

  :global([data-theme="brand-dark"] .logo-dark-theme) {
    display: block !important;
  }
  :global([data-theme="brand-dark"] .logo-light-theme) {
    display: none !important;
  }

  /* --- DARK THEME ADJUSTMENTS --- */
  /* In dark theme, invert the dark logos (Google, PMI, Siglo 21) so they become white/light */
  :global([data-theme="brand-dark"]) .marquee-logo:not(.logo-no-invert) {
    filter: grayscale(1) invert(0.8) brightness(1.5) opacity(0.7);
  }

  :global([data-theme="brand-dark"])
    .marquee-item:hover
    .marquee-logo:not(.logo-no-invert) {
    filter: grayscale(0) invert(0) brightness(1) opacity(1);
  }

  /* Los que ya traen archivo claro propio (Undercode, Áureo Innova) no se invierten */
  :global([data-theme="brand-dark"]) .logo-no-invert {
    filter: grayscale(1) opacity(0.7);
  }

  :global([data-theme="brand-dark"]) .marquee-item:hover .logo-no-invert {
    filter: grayscale(0) opacity(1);
  }

  @keyframes scroll-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Since we have 3 identical sets, moving by exactly 1/3 (one set) creates a perfect infinite loop */
      transform: translateX(-33.3333%);
    }
  }

  @media (max-width: 768px) {
    .allies {
      padding: 60px 0;
    }
    .marquee-item {
      height: 70px;
      width: 180px;
    }
    .marquee-logo {
      height: 48px !important;
    }
    .marquee-track {
      gap: 4rem;
    }
  }
</style>

<script>
  function initMarqueeSync() {
    const track = document.querySelector(
      ".marquee-track",
    ) as HTMLElement | null;
    if (!track) return;

    const STORAGE_KEY = "edutech-animations";

    function getEnabled(): boolean {
      return localStorage.getItem(STORAGE_KEY) !== "false";
    }

    function setGlobalClass(enabled: boolean) {
      document.documentElement.classList.toggle("animations-paused", !enabled);
    }

    function restartMarquee() {
      track.style.animationName = "none";
      track.style.animationPlayState = "";
      void track.offsetWidth;
      track.style.animationName = "";
    }

    function syncMarquee(enabled: boolean) {
      setGlobalClass(enabled);
      if (enabled) {
        restartMarquee();
      } else {
        track.style.animationPlayState = "paused";
      }
    }

    syncMarquee(getEnabled());

    window.addEventListener("edutech-animations-changed", (e: any) => {
      syncMarquee(e.detail.enabled);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMarqueeSync);
  } else {
    initMarqueeSync();
  }
</script>
