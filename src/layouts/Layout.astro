---
interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
}

const { 
	title, 
	description = 'Participá de la Hackathon EduTech Mendoza 2026. Estudiantes de nivel superior diseñan soluciones tecnológicas para transformar la educación. ¡Inscribite!',
	image = '/img/og-image.jpg',
	canonical
} = Astro.props;

const siteUrl = 'https://www.hackathonedutech.com.ar';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image.startsWith('http') ? image : new URL(image, siteUrl).href;

import '../styles/global.css';
import '@fontsource/lexend/200.css';
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/600.css';
import '@fontsource/lexend/900.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GooeyBackground from '../components/GooeyBackground.astro';
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="es" data-theme="brand-light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#7c3aed" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logo oficial de la Hackathon EduTech Mendoza 2026" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Hackathon EduTech Mendoza" />
		<meta property="og:locale" content="es_AR" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Prevenir FOUC -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('edutech-theme')) {
					return localStorage.getItem('edutech-theme');
				}
				return 'brand-light';
			})();
			document.documentElement.setAttribute('data-theme', theme);
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
		<GooeyBackground />
		<Navbar />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
		<Analytics />
		
		<script>
			// Intersection Observer for scroll animations
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('revealed');
					}
				});
			}, { threshold: 0.15 });

			const initReveal = () => {
				document.querySelectorAll('.reveal').forEach((el) => {
					observer.observe(el);
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initReveal);
			} else {
				initReveal();
			}
		</script>
	</body>
</html>
