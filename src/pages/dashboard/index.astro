<script>
  import { createBrowserClient } from '@supabase/ssr';

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('profile-form') as HTMLFormElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.style.display = 'none';

    // Obtener los valores del formulario
    const dni = (form.querySelector('#dni') as HTMLInputElement).value.trim();
    const institution = (form.querySelector('#institution') as HTMLSelectElement).value;
    const year_of_study = (form.querySelector('#year_of_study') as HTMLSelectElement).value;
    const disciplinary_profile = (form.querySelector('#disciplinary_profile') as HTMLSelectElement).value;
    const is_egresado = (form.querySelector('#is_egresado') as HTMLInputElement).checked;

    if (!dni || !institution || !year_of_study || !disciplinary_profile) {
      errorDiv.textContent = 'Por favor, completá todos los campos obligatorios.';
      errorDiv.style.display = 'block';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Guardando datos...';

    // Obtener el ID del usuario actual desde la sesión
    const { data: { session }, error: sessionError } = await supabase.auth.getSession();
    
    if (sessionError || !session) {
      errorDiv.textContent = 'Error de autenticación. Por favor recargá la página.';
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirmar Inscripción';
      return;
    }

    const userId = session.user.id;

    // Actualizar el perfil en Supabase
    const { error: updateError } = await supabase
      .from('profiles')
      .update({
        dni,
        institution,
        year_of_study,
        disciplinary_profile,
        is_egresado,
        registration_status: 'aprobado'
      })
      .eq('id', userId);

    if (updateError) {
      console.error(updateError);
      errorDiv.textContent = updateError.message.includes('unique') 
        ? 'Este DNI ya está registrado por otro usuario.'
        : 'Hubo un error al guardar tus datos. Intentá nuevamente.';
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirmar Inscripción';
      return;
    }

    // Éxito: recargar la página para que el servidor Astro renderice la vista "Completo"
    window.location.reload();
  });

  // Lógica del formulario de actualización de contacto
  const updateForm = document.getElementById('update-contact-form') as HTMLFormElement;
  const updateErrorDiv = document.getElementById('update-error') as HTMLDivElement;
  const updateBtn = document.getElementById('update-btn') as HTMLButtonElement;

  updateForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    updateErrorDiv.style.display = 'none';

    const phone_whatsapp = (updateForm.querySelector('#phone_whatsapp') as HTMLInputElement).value.trim();
    const instagram_handle = (updateForm.querySelector('#instagram_handle') as HTMLInputElement).value.trim();

    updateBtn.disabled = true;
    updateBtn.textContent = 'Actualizando...';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const { error: updateError } = await supabase
      .from('profiles')
      .update({ phone_whatsapp, instagram_handle })
      .eq('id', session.user.id);

    if (updateError) {
      console.error(updateError);
      updateErrorDiv.textContent = 'Hubo un error al actualizar tus datos.';
      updateErrorDiv.style.display = 'block';
      updateBtn.disabled = false;
      updateBtn.textContent = 'Actualizar Contacto';
      return;
    }

    updateBtn.textContent = '¡Actualizado!';
    updateBtn.classList.remove('btn-outline');
    updateBtn.classList.add('btn-primary');
    
    setTimeout(() => {
      updateBtn.disabled = false;
      updateBtn.textContent = 'Actualizar Contacto';
      updateBtn.classList.remove('btn-primary');
      updateBtn.classList.add('btn-outline');
    }, 3000);
  });

// --- SOS Logic (T5.3) ---
const sosContainer = document.getElementById('sos-container');
const sosBtn = document.getElementById('sos-btn') as HTMLButtonElement;
const sosStatusText = document.getElementById('sos-status-text');
const sosTimerVal = document.getElementById('sos-timer-val');

if (sosContainer && sosBtn) {
  const teamId = sosContainer.dataset.teamId;
  const sessionDuration = parseInt(sosContainer.dataset.sessionDuration || '15', 10);
  let currentStatus = sosContainer.dataset.initialStatus || '';
  let startedAt = sosContainer.dataset.startedAt || '';
  let timerInterval: ReturnType<typeof setInterval> | null = null;

  function resetSosUI() {
    currentStatus = '';
    startedAt = '';
    sosBtn.disabled = false;
    sosBtn.textContent = 'Pedir Ayuda (SOS)';
    sosBtn.classList.remove('btn-disabled');
    sosBtn.classList.add('btn-danger');
    if (sosStatusText) {
      sosStatusText.textContent = '¿Necesitan ayuda técnica o de negocio? Pidan un SOS y su mentor vendrá a su mesa.';
      sosStatusText.classList.add('sos-status-fade');
      setTimeout(() => sosStatusText?.classList.remove('sos-status-fade'), 400);
    }
    removeTimerDisplay();
  }

  function showTimerDisplay() {
    let timerEl = sosContainer.querySelector('.sos-timer') as HTMLDivElement | null;
    if (!timerEl) {
      timerEl = document.createElement('div');
      timerEl.className = 'sos-timer';
      timerEl.innerHTML = '⏱️ Tiempo restante: <span id="sos-timer-val">--:--</span>';
      const sosInfo = sosContainer.querySelector('.sos-info');
      sosInfo?.appendChild(timerEl);
    }
  }

  function removeTimerDisplay() {
    const timerEl = sosContainer.querySelector('.sos-timer');
    if (timerEl) timerEl.remove();
  }

  function showWaitingDisplay() {
    let waitEl = sosContainer.querySelector('.sos-waiting') as HTMLDivElement | null;
    if (!waitEl) {
      waitEl = document.createElement('div');
      waitEl.className = 'sos-waiting';
      waitEl.innerHTML = '<span class="sos-waiting-dot"></span> Esperando mentor…';
      const sosInfo = sosContainer.querySelector('.sos-info');
      sosInfo?.appendChild(waitEl);
    }
  }

  function removeWaitingDisplay() {
    const waitEl = sosContainer.querySelector('.sos-waiting');
    if (waitEl) waitEl.remove();
  }

  async function requestHelp() {
    sosBtn.disabled = true;
    sosBtn.textContent = 'Enviando...';

    const { data, error } = await supabase.rpc('request_help');

    if (error || !data?.ok) {
      alert(data?.error || error?.message || 'Error al pedir ayuda.');
      sosBtn.disabled = false;
      sosBtn.textContent = 'Pedir Ayuda (SOS)';
      return;
    }

    currentStatus = 'pendiente';
    sosBtn.textContent = 'Pedido Enviado ✓';
    sosBtn.classList.remove('btn-danger');
    sosBtn.classList.add('btn-disabled');
    if (sosStatusText) {
      sosStatusText.textContent = '🔔 Pedido enviado. Tu mentor vendrá en cuanto esté libre.';
      sosStatusText.classList.add('sos-status-fade');
      setTimeout(() => sosStatusText?.classList.remove('sos-status-fade'), 400);
    }
    showWaitingDisplay();
  }

  sosBtn.addEventListener('click', requestHelp);

  // Realtime subscription for ticket status
  if (teamId) {
    supabase
      .channel(`sos-${teamId}`)
      .on('postgres_changes', {
        event: '*',
        schema: 'public',
        table: 'help_requests',
        filter: `team_id=eq.${teamId}`
      }, (payload: any) => {
        const ticket = payload.new;
        if (!ticket) return;

        if (ticket.status === 'finalizado') {
          removeWaitingDisplay();
          removeTimerDisplay();
          if (sosStatusText) {
            sosStatusText.textContent = '✅ Sesión finalizada. Podés pedir ayuda nuevamente si lo necesitás.';
            sosStatusText.classList.add('sos-status-fade');
            setTimeout(() => sosStatusText?.classList.remove('sos-status-fade'), 400);
          }
          resetSosUI();
          return;
        }

        if (ticket.status === 'expirado') {
          removeWaitingDisplay();
          removeTimerDisplay();
          if (sosStatusText) {
            sosStatusText.textContent = '⏰ Tiempo agotado. Podés volver a pedir ayuda si lo necesitás.';
            sosStatusText.classList.add('sos-status-fade');
            setTimeout(() => sosStatusText?.classList.remove('sos-status-fade'), 400);
          }
          resetSosUI();
          return;
        }

        currentStatus = ticket.status;
        startedAt = ticket.started_at;

        if (ticket.status === 'pendiente') {
          removeTimerDisplay();
          showWaitingDisplay();
          if (sosStatusText) {
            sosStatusText.textContent = '🔔 Pedido enviado. Tu mentor vendrá en cuanto esté libre.';
            sosStatusText.classList.add('sos-status-fade');
            setTimeout(() => sosStatusText?.classList.remove('sos-status-fade'), 400);
          }
          sosBtn.disabled = true;
          sosBtn.textContent = 'Pedido Activo';
          sosBtn.classList.remove('btn-danger');
          sosBtn.classList.add('btn-disabled');
        }

        if (ticket.status === 'en_camino') {
          removeWaitingDisplay();
          showTimerDisplay();
          if (sosStatusText) {
            sosStatusText.textContent = '🏃‍♂️ ¡Tu mentor está en camino! Prepará tus dudas.';
            sosStatusText.classList.add('sos-status-fade');
            setTimeout(() => sosStatusText?.classList.remove('sos-status-fade'), 400);
          }
          sosBtn.disabled = true;
          sosBtn.textContent = 'Pedido Activo';
          sosBtn.classList.remove('btn-danger');
          sosBtn.classList.add('btn-disabled');
        }
      })
      .subscribe();
  }

  // Countdown timer
  timerInterval = setInterval(() => {
    const timerSpan = document.getElementById('sos-timer-val');
    if (currentStatus === 'en_camino' && startedAt && timerSpan) {
      const startTime = new Date(startedAt).getTime();
      const now = Date.now();
      const elapsedSecs = Math.floor((now - startTime) / 1000);
      const totalSecs = sessionDuration * 60;
      const remainingSecs = Math.max(0, totalSecs - elapsedSecs);
      const mins = Math.floor(remainingSecs / 60);
      const secs = remainingSecs % 60;
      timerSpan.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
    }
  }, 1000);
}

// --- Tabs Logic ---
const tabButtons = document.querySelectorAll('.tab-btn');
const tabContents = document.querySelectorAll('.tab-content');

tabButtons.forEach(btn => {
  btn.addEventListener('click', () => {
    const targetTab = btn.getAttribute('data-tab');
    
    tabButtons.forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    tabContents.forEach(c => c.classList.remove('active'));

    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    const targetContent = document.getElementById(`tab-${targetTab}`);
    if (targetContent) {
      targetContent.classList.add('active');
    }
  });
});
</script>
