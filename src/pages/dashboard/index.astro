                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                    <a href="https://www.adobe.com/products/xd.html" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#FF26BE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4" fill="#470137" stroke="none"/><path d="M7 8h1.5a2.5 2.5 0 0 1 2.5 2.5v1a2.5 2.5 0 0 1-2.5 2.5H7V8z"/><path d="M13 8c1 0 2 1.5 2 3.5s-1 3.5-2 3.5"/><path d="M13 8h1a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1"/></svg>
                      </span>
                      <span>Adobe XD</span>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                    <a href="https://www.canva.com/es_ar/pizarra-online/" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" fill="url(#canva-grad-wb)"/><path d="M15 14.5c-0.8 0.8-2 1.2-3.2 1.2-2.4 0-4-1.6-4-4s1.6-4 4-4c1.2 0 2.4 0.4 3.2 1.2" stroke="white" stroke-width="1.8" stroke-linecap="round"/><defs><linearGradient id="canva-grad-wb" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse"><stop stop-color="#00C4CC"/><stop offset="1" stop-color="#7D2AE8"/></linearGradient></defs></svg>
                      </span>
                      <span>Canva Whiteboards</span>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                  </div>
                </div>

                <!-- Categoría 2: No-Code y Low-Code -->
                <div class="category-card">
                  <h3>
                    <svg class="category-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    No-Code y Low-Code
                  </h3>
                  <div class="tools-pill-container">
                    <a href="https://www.glideapps.com" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 7l10 5 10-5-10-5z" fill="#FF5A5F"/><path d="M2 17l10 5 10-5" stroke="#FF5A5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12l10 5 10-5" stroke="#FF5A5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                      <span>Glide Apps</span>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                    <a href="https://flutterflow.io" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.9 2.5L18.4 8H12.9L7.4 2.5h5.5z" fill="#10B981"/><path d="M7.4 8.5L12.9 14H7.4L1.9 8.5h5.5z" fill="#3B82F6"/><path d="M12.9 14.5L18.4 20H12.9l-5.5-5.5h5.5z" fill="#6366F1"/></svg>
                      </span>
                      <span>FlutterFlow</span>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                    <a href="https://bubble.io" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#00C4CC" stroke-width="2"><circle cx="9" cy="14" r="5" fill="#00C4CC" fill-opacity="0.2"/><circle cx="15" cy="9" r="5" fill="#7D2AE8" fill-opacity="0.2"/><circle cx="9" cy="14" r="5"/><circle cx="15" cy="9" r="5"/></svg>
                      </span>
                      <span>Bubble</span>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
