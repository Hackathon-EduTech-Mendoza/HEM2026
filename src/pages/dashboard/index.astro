---
// src/pages/dashboard/index.astro
import Layout from '../../layouts/Layout.astro';
import TeamManager from '../../components/TeamManager.astro';
import { createServerClient, parseCookieHeader } from '@supabase/ssr';

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        try {
          return parseCookieHeader(Astro.request.headers.get('Cookie') ?? '');
        } catch {
          return [];
        }
      },
      setAll() {}
    }
  }
);

const user = Astro.locals.user;
const profile = Astro.locals.profile;

// Redirigir a login si no hay sesión (esto ya lo hace el middleware, pero por seguridad de tipos)
if (!user || !profile) {
  return Astro.redirect('/login');
}

// Lógica para determinar si el perfil está completo
const isProfileComplete = !!(profile.first_name && profile.last_name);

// Fetch teams_enabled and team config from event_config
let teamsEnabled = false;
let projectsEnabled = false;
let helpEnabled = false;
let maxTeamSize = 5;
let minTeamSize = 3;
let mentorSessionDuration = 15;

if (isProfileComplete && profile.registration_status === 'aprobado') {
  const { data: configRows } = await supabase
    .from('event_config')
    .select('key, value')
    .in('key', [
      'teams_enabled', 
      'project_submission_enabled', 
      'max_team_size', 
      'min_team_size',
      'help_enabled',
      'mentor_session_duration'
    ]);
    
  if (configRows) {
    for (const row of configRows) {
      if (row.key === 'teams_enabled') teamsEnabled = row.value === 'true';
      if (row.key === 'project_submission_enabled') projectsEnabled = row.value === 'true';
      if (row.key === 'help_enabled') helpEnabled = row.value === 'true';
      if (row.key === 'max_team_size') maxTeamSize = parseInt(row.value) || 5;
      if (row.key === 'min_team_size') minTeamSize = parseInt(row.value) || 3;
      if (row.key === 'mentor_session_duration') mentorSessionDuration = parseInt(row.value) || 15;
    }
  }
}

// Fetch assigned mentor if user has a team
let mentor = null;
if (profile.team_id) {
  const { data: teamData } = await supabase
    .from('teams')
    .select('mentor_id')
    .eq('id', profile.team_id)
    .single();
  
  if (teamData?.mentor_id) {
    const { data: mentorData } = await supabase
      .from('profiles')
      .select('full_name, phone_whatsapp, instagram_handle')
      .eq('id', teamData.mentor_id)
      .single();
    
    if (mentorData) {
      mentor = mentorData;
    }
  }
}

// Fetch active help request for the team
let activeHelpRequest = null;
if (profile.team_id && helpEnabled) {
  const { data: helpData } = await supabase
    .from('help_requests')
    .select('*')
    .eq('team_id', profile.team_id)
    .in('status', ['pendiente', 'en_camino'])
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();
  
  activeHelpRequest = helpData;
}
---

<Layout title="Dashboard | HEM2026">
  <main class="dashboard-page">
    <div class="container">
      
      {!isProfileComplete ? (
        <!-- Vista Perfil Incompleto -->
        <div class="dashboard-card card">
          <div class="dash-header">
            <h1>¡Te damos la bienvenida, {profile.full_name}!</h1>
            <p class="dash-subtitle">Completá tus datos para confirmar tu inscripción al Hackathon EduTech.</p>
          </div>

          <form id="profile-form" class="dash-form">
            <div class="form-row">
              <div class="form-group">
                <label for="dni">DNI (Sin puntos)</label>
                <input type="text" id="dni" name="dni" placeholder="Ej: 30123456" required pattern="[0-9]+" inputmode="numeric" title="Ingresá solo números, sin puntos ni espacios" />
              </div>

              <div class="form-group">
                <label for="institution">Institución</label>
                <select id="institution" name="institution" required>
                  <option value="" disabled selected>Seleccioná tu institución</option>
                  <option value="ies_9023_maipu">IES 9-023 Maipú</option>
                  <option value="ies_edison">IES Tomás Alva Edison</option>
                  <option value="otra">Otra institución</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="year_of_study">Año de cursado</label>
                <select id="year_of_study" name="year_of_study" required>
                  <option value="" disabled selected>Seleccioná tu año</option>
                  <option value="primero">Primer año</option>
                  <option value="segundo">Segundo año</option>
                  <option value="tercero">Tercer año (o superior)</option>
                  <option value="otro">Otro / No aplica</option>
                </select>
              </div>

              <div class="form-group">
                <label for="disciplinary_profile">Perfil disciplinar</label>
                <select id="disciplinary_profile" name="disciplinary_profile" required>
                  <option value="" disabled selected>Seleccioná tu perfil</option>
                  <option value="tecnico">Técnico / IT</option>
                  <option value="docente">Docente / Educación</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
            </div>

            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" id="is_egresado" name="is_egresado" />
                <span class="custom-checkbox"></span>
                ¿Sos egresado/a? (Importante para la conformación de equipos)
              </label>
            </div>

            <div id="form-error" class="form-error" style="display: none;"></div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-lg" id="submit-btn">
                Confirmar Inscripción
              </button>
            </div>
          </form>
        </div>
      ) : (profile.role === 'juez' || profile.role === 'mentor') && profile.registration_status === 'pendiente' ? (
        <!-- Vista En Revisión para Jueces/Mentores -->
        <div class="pending-container animate-fade-in">
          <div class="dashboard-card card pending-card">
            <div class="pending-info">
              <div class="pending-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <h2>Tu solicitud está en revisión</h2>
              <p class="pending-text">
                El equipo organizador está revisando tu perfil como <strong>{profile.role === 'juez' ? 'Juez' : 'Mentor'}</strong>. Te notificaremos cuando tu registro sea aprobado.
              </p>
              <div class="support-info">
                <span>Si tenés dudas, escribinos a: </span>
                <a href="mailto:hackathonedutech@gmail.com" class="support-email">hackathonedutech@gmail.com</a>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <!-- Vista Perfil Completo con Pestañas -->
        <div class="tabs-container">
          <nav class="tabs-nav" role="tablist">
            <button class="tab-btn active" data-tab="perfil" role="tab" aria-selected="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span>Mi Perfil</span>
            </button>
            <button class="tab-btn" data-tab="equipo" role="tab" aria-selected="false">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>Mi Equipo</span>
            </button>
            <button class="tab-btn" data-tab="recursos" role="tab" aria-selected="false">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>Recursos</span>
            </button>
            {helpEnabled && (
              <button class="tab-btn" data-tab="sos" role="tab" aria-selected="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>SOS</span>
              </button>
            )}
          </nav>

          <!-- Tab 1: Perfil -->
          <div class="tab-content active" id="tab-perfil" role="tabpanel">
            <div class="tab-profile-layout">
              <div class="welcome-card card">
                <h2>¡Hola, {profile.first_name || profile.full_name}!</h2>
                <p class="welcome-intro">Te damos la bienvenida a la <strong>Hackathon EduTech Mendoza 2026</strong>. Tu inscripción está confirmada.</p>
                
                <div class="quick-links">
                  <h3>Enlaces rápidos:</h3>
                  <ul>
                    <li><a href="/#faq" class="quick-link">&rarr; Preguntas Frecuentes (FAQ)</a></li>
                    <li><a href="/#bases" class="quick-link">&rarr; Bases y Condiciones</a></li>
                    <li><a href="/#schedule" class="quick-link">&rarr; Cronograma del Evento</a></li>
                  </ul>
                </div>
              </div>

              <details class="profile-details-collapsible">
                <summary class="details-summary-btn btn btn-outline">Editar datos de contacto</summary>
                <div class="dashboard-card card profile-card" style="margin-top: 1rem;">
                  <form id="update-contact-form" class="dash-form">
                    <h3 class="section-label">Tus Datos Fijos</h3>
                    <div class="form-row">
                      <div class="form-group">
                        <label for="display_dni">DNI</label>
                        <input type="text" id="display_dni" value={profile.dni} disabled />
                      </div>
                      <div class="form-group">
                        <label for="display_inst">Institución</label>
                        <input type="text" id="display_inst" value={profile.institution === 'ies_9023_maipu' ? 'IES 9-023 Maipú' : profile.institution === 'ies_edison' ? 'IES Tomás Alva Edison' : 'Otra'} disabled />
                      </div>
                    </div>
                    <div class="form-group checkbox-group">
                      <label class="checkbox-label" style="opacity: 0.7; cursor: default;">
                        <input type="checkbox" checked={profile.is_egresado} disabled />
                        <span class="custom-checkbox"></span>
                        Egresado/a
                      </label>
                    </div>
                    
                    <h3 class="section-label" style="margin-top: 1rem;">Datos de Contacto (Editables)</h3>
                    <div class="form-row">
                      <div class="form-group">
                        <label for="phone_whatsapp">Teléfono (WhatsApp)</label>
                        <input type="text" id="phone_whatsapp" name="phone_whatsapp" placeholder="Ej: 2611234567" value={profile.phone_whatsapp || ''} />
                      </div>
                      <div class="form-group">
                        <label for="instagram_handle">Instagram</label>
                        <input type="text" id="instagram_handle" name="instagram_handle" placeholder="Ej: @usuario" value={profile.instagram_handle || ''} />
                      </div>
                    </div>

                    <div id="update-error" class="form-error" style="display: none;"></div>
                    
                    <div class="form-actions" style="margin-top: 0.5rem; justify-content: flex-start;">
                      <button type="submit" class="btn btn-outline" id="update-btn">
                        Actualizar Contacto
                      </button>
                    </div>
                  </form>
                </div>
              </details>
            </div>
          </div>

          <!-- Tab 2: Equipo -->
          <div class="tab-content" id="tab-equipo" role="tabpanel">
            {teamsEnabled && profile.registration_status === 'aprobado' ? (
              <TeamManager
                userId={user.id}
                teamId={profile.team_id}
                isEgresado={profile.is_egresado}
                fullName={profile.full_name}
                maxTeamSize={maxTeamSize}
                minTeamSize={minTeamSize}
                projectsEnabled={projectsEnabled}
              />
            ) : !teamsEnabled && profile.registration_status === 'aprobado' ? (
              <div class="team-locked-msg">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>La formación de equipos se habilitará próximamente.</span>
              </div>
            ) : (
              <div class="team-locked-msg">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>Tu inscripción debe estar aprobada para participar de un equipo.</span>
              </div>
            )}
          </div>

          <!-- Tab 3: Recursos (Toolkit) -->
          <div class="tab-content" id="tab-recursos" role="tabpanel">
            <div class="card profile-card" style="padding: 2rem;">
              <h3 class="section-label" style="font-size: 1.3rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" style="color: var(--c1);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                Toolkit del Competidor
              </h3>
              <p style="color: var(--txt-2); font-size: 0.95rem; margin-bottom: 2rem;">
                Accedé a herramientas de prototipado, documentación técnica y materiales oficiales de la Hackathon para impulsar el proyecto de tu equipo.
              </p>

              <div class="toolkit-categories-grid">
                <!-- Categoría 1: Diseño y Prototipado -->
                <div class="category-card">
                  <h3>
                    <svg class="category-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C17.52 22 22 17.52 22 12S17.52 2 12 2 2 6.48 2 12c0 2.37 1.08 4.49 2.78 5.88.24.2.22.58-.03.77A4.27 4.27 0 0 1 2 21.8c-.16.08-.2.28-.08.41C2.04 22.34 2.2 22 2.5 22H12z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="11.5" cy="7.5" r="1"/><circle cx="16.5" cy="9.5" r="1"/><circle cx="15.5" cy="14.5" r="1"/></svg>
                    Diseño y Prototipado
                  </h3>
                  <div class="tools-pill-container">
                    <a href="https://www.figma.com" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z"/><path d="M12 2h3.5A3.5 3.5 0 1 1 12 5.5V2z"/><path d="M12 12.5a3.5 3.5 0 1 1 3.5-3.5V12.5H12z"/><path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z"/><path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z"/></svg>
                      </span>
                      <span>Figma</span>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                    <a href="https://penpot.app" target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <span class="tool-logo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#05C3B6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 12 14 9 21"/></svg>
                      </span>
