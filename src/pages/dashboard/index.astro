                            ? '🔔 Pedido enviado. Tu mentor vendrá en cuanto esté libre.'
                            : '🏃‍♂️ ¡Tu mentor está en camino! Prepará tus dudas.'}
                        </p>
                        {activeHelpRequest?.status === 'pendiente' && (
                          <div class="sos-waiting">
                            <span class="sos-waiting-dot"></span> Esperando mentor…
                          </div>
                        )}
                        {activeHelpRequest?.status === 'en_camino' && (
                          <div class="sos-timer">
                            ⏱️ Tiempo restante: <span id="sos-timer-val">--:--</span>
                          </div>
                        )}
                      </div>
                      <button 
                        id="sos-btn" 
                        class={`btn ${activeHelpRequest ? 'btn-disabled' : 'btn-danger'}`} 
                        disabled={!!activeHelpRequest}
                      >
                        {activeHelpRequest ? 'Pedido Activo' : 'Pedir Ayuda (SOS)'}
                      </button>
                    </div>
                  </div>
                ) : !profile.team_id ? (
                  <div class="mentor-empty" style="margin-top: 1rem;">
                    <p>Para solicitar un SOS, primero debés conformar o unirte a un equipo en la pestaña <strong>Mi Equipo</strong>.</p>
                  </div>
                ) : (
                  <div class="mentor-empty" style="margin-top: 1rem;">
                    <p>El sistema de ayuda SOS se activará cuando tu equipo tenga un mentor asignado.</p>
                  </div>
                )}
              </div>
            </div>
          )}

        </div>
      )}
      
    </div>
  </main>
</Layout>

