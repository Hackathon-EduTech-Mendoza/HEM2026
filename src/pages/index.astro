---
// Página pública sin datos de servidor: se prerenderiza y se sirve estática desde el CDN.
// El estado de sesión del navbar lo resuelve checkAuth() en el cliente.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import InfoCards from '../components/InfoCards.astro';
import Schedule from '../components/Schedule.astro';
import FAQ from '../components/FAQ.astro';
import Prizes from '../components/Prizes.astro';
import Organizers from '../components/Organizers.astro';
import Allies from '../components/Allies.astro';
import NewsSection from '../components/NewsSection.astro';
import VibeCheck from '../components/VibeCheck.astro';
import Consultas from '../components/Consultas.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Hackathon EduTech Mendoza 2026",
  "description": "Un espacio intensivo de trabajo colaborativo donde equipos interdisciplinarios del Nivel Superior diseñan soluciones tecnológicas innovadoras para los desafíos actuales de la educación.",
  "startDate": "2026-08-26T19:00:00-03:00",
  "endDate": "2026-08-29T18:00:00-03:00",
  "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": [
    {
      "@type": "Place",
      "name": "IES 9-023",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dionisio Herrero 303",
        "addressLocality": "Maipú",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    {
      "@type": "Place",
      "name": "Auditorio Municipal de Maipú, Marciano Cantero",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Mercedes Tomasa de San Martín 1050",
        "addressLocality": "Maipú",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    }
  ],
  "organizer": [
    {
      "@type": "EducationalOrganization",
      "name": "IES N°9-023 de Maipú",
      "url": "https://ies9023-infd.mendoza.edu.ar/sitio/"
    },
    {
      "@type": "EducationalOrganization",
      "name": "IES Tomás Alva Edison",
      "url": "https://superior.fundacionedison.org.ar/"
    }
  ],
  "isAccessibleForFree": true,
  "inLanguage": "es"
};
---

<Layout title="HEM2026 | Hackathon EduTech Mendoza">
	<div>
		<Hero />
		<InfoCards />
		<Prizes />
		<NewsSection />
		<Schedule />
		<Organizers />
		<Allies />
		<VibeCheck />
		<FAQ />
		<Consultas />
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
