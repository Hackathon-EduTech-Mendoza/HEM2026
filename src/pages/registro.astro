---
// src/pages/registro.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro | HEM2026">
  <div class="auth-page">
    <div class="container">
      <div class="auth-card card">
        <div class="auth-header">
          <a href="/" class="auth-back">&larr; Volver al inicio</a>
          <h1 id="auth-title">Crear cuenta</h1>
          <p class="auth-subtitle" id="auth-subtitle">Registrate para participar de la Hackathon EduTech 2026</p>
        </div>

        <!-- Aviso del rol elegido: qué implica registrarse como mentor o juez. -->
        <p class="rol-aviso" id="rol-aviso" hidden></p>

        <form id="register-form" class="auth-form" novalidate>

          <!-- Selector de rol.
               Antes el único modo de entrar como mentor o juez era el parámetro
               `?rol=`, que no está linkeado en ningún lado: con la inscripción de
               participantes cerrada, un mentor que llegaba por la web veía el
               cartel de "cupo completo" y se daba media vuelta. Ya pasó.

               ⚠️ Esto es una comodidad de la interfaz, NO el control de acceso.
               Quien manda sigue siendo la base: `handle_new_user` filtra el rol
               del metadata contra su propia lista blanca y
               `enforce_max_participants` cuenta el cupo. Tocar estos radios con
               el inspector no destraba nada. -->
          <fieldset class="rol-selector" id="rol-selector">
            <legend>¿Cómo te registrás?</legend>

            <label class="rol-opcion" for="rol-usuario" id="rol-opcion-usuario">
              <input type="radio" name="rol" value="usuario" id="rol-usuario" checked />
              <span class="rol-opcion-cuerpo">
                <span class="rol-opcion-titulo">
                  Participante
                  <span class="rol-badge" id="rol-badge-usuario" hidden>Completo</span>
                </span>
                <span class="rol-opcion-desc" id="rol-desc-usuario">
                  Armás equipo y presentás un proyecto en la hackathon.
                </span>
              </span>
            </label>

            <label class="rol-opcion" for="rol-mentor">
              <input type="radio" name="rol" value="mentor" id="rol-mentor" />
              <span class="rol-opcion-cuerpo">
                <span class="rol-opcion-titulo">Mentor</span>
                <span class="rol-opcion-desc">
                  Acompañás a los equipos durante las jornadas.
                </span>
              </span>
            </label>

            <label class="rol-opcion" for="rol-juez">
              <input type="radio" name="rol" value="juez" id="rol-juez" />
              <span class="rol-opcion-cuerpo">
                <span class="rol-opcion-titulo">Jurado</span>
                <span class="rol-opcion-desc">
                  Evalúás los proyectos con la rúbrica oficial.
                </span>
              </span>
            </label>
          </fieldset>

          <!-- Inscripción de participantes cerrada. Lo enciende el script
               consultando /api/cupo. El candado de verdad es el trigger
               `enforce_max_participants`: esto es para que se entienda antes de
               tipear una contraseña.

               Vive DENTRO del formulario y a la altura de `#campos-cuenta`, no
               en lugar del formulario entero: el selector de arriba tiene que
               seguir en pantalla para que un mentor pueda cambiar de opción. -->
          <div class="registro-cerrado" id="registro-cerrado" hidden>
            <h2 id="registro-cerrado-titulo">Inscripción de participantes cerrada</h2>
            <p>
              Se completaron los <strong>300</strong> lugares para participantes.
              Por el espacio de la sede no podemos sumar más gente.
            </p>
            <p>
              <strong>¿Sos mentor o jurado?</strong> Elegí tu rol acá arriba: esos
              lugares no ocupan cupo y siguen abiertos.
            </p>
            <p>
              Si ya creaste tu cuenta, tu lugar está guardado:
              <a href="/login" class="auth-link">iniciá sesión</a> y completá tu perfil.
            </p>
            <p>
              ¿Dudas? <a href="/contacto" class="auth-link">Escribinos</a>.
            </p>
          </div>

          <div class="campos-cuenta" id="campos-cuenta">

          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tu@email.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <div class="password-wrapper">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Mínimo 8 caracteres"
                required
                minlength="8"
                autocomplete="new-password"
              />
              <button type="button" class="toggle-password" id="togglePassword" aria-label="Mostrar contraseña">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </div>
          </div>

          <div id="form-error" class="form-error" style="display: none;" role="alert" aria-live="assertive"></div>
          <div id="form-success" class="form-success" style="display: none;" role="status" aria-live="polite"></div>

          <button type="submit" class="btn btn-primary btn-lg btn-full" id="submit-btn">
            Crear cuenta
          </button>

          </div><!-- /#campos-cuenta -->
        </form>

        <div class="auth-footer">
          <p>¿Ya tenés cuenta? <a href="/login" class="auth-link">Iniciar sesión</a></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-page {
    min-height: calc(100vh - var(--nav-h));
    padding: calc(var(--nav-h) + 2rem) 0 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-card {
    max-width: 480px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem;
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-back {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--txt-m);
    margin-bottom: 1.5rem;
    transition: color var(--t-fast);
  }

  .auth-back:hover {
    color: var(--c1);
  }

  .auth-header h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .auth-subtitle {
    color: var(--txt-2);
    font-size: 0.95rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--txt-1);
  }

  .form-group input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--brd);
    border-radius: var(--r-md);
    background: var(--bg-input);
    color: var(--txt-1);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
    outline: none;
  }

  .form-group input::placeholder {
    color: var(--txt-m);
  }

  .form-group input:focus {
    border-color: var(--c1);
    box-shadow: 0 0 0 3px rgba(var(--c1r), 0.12);
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .password-wrapper input {
    width: 100%;
    padding-right: 3rem;
  }

  .toggle-password {
    position: absolute;
    right: 0.5rem;
    background: none;
    border: none;
    color: var(--txt-2);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--t-fast);
  }

  .toggle-password:hover {
    color: var(--c1);
  }

  .toggle-password svg {
    width: 20px;
    height: 20px;
  }

  .form-error {
    background: rgba(var(--danger-r), 0.1);
    border: 1px solid rgba(var(--danger-r), 0.3);
    color: var(--danger);
    padding: 0.75rem 1rem;
    border-radius: var(--r-md);
    font-size: 0.9rem;
  }

  .form-success {
    background: rgba(var(--c2r), 0.1);
    border: 1px solid rgba(var(--c2r), 0.3);
    color: var(--c2-text);
    padding: 0.75rem 1rem;
    border-radius: var(--r-md);
    font-size: 0.9rem;
  }

  .btn-full {
    width: 100%;
  }

  .btn-full:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .auth-footer {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--brd);
    font-size: 0.9rem;
    color: var(--txt-2);
  }

  .auth-link {
    color: var(--c1);
    font-weight: 600;
  }

  .auth-link:hover {
    text-decoration: underline;
  }

  /* ⚠️ `.auth-form` fija `display: flex`, y eso le gana al `display: none` que
     el navegador aplica por el atributo `hidden`: sin esta regla el formulario
     se sigue viendo con la inscripción cerrada. Mismo problema que el padding
     de `.admin-card`. */
  .auth-form[hidden] {
    display: none;
  }

  /* ---------------------------------------------------------------
     Selector de rol
     --------------------------------------------------------------- */

  .rol-selector {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border: 0;
    margin: 0;
    padding: 0;
  }

  .rol-selector legend {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--txt-1);
    padding: 0;
    margin-bottom: 0.4rem;
  }

  .rol-opcion {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--brd);
    border-radius: var(--r-md);
    background: var(--bg-input);
    cursor: pointer;
    transition: border-color var(--t-fast), background var(--t-fast);
  }

  .rol-opcion:hover {
    border-color: rgba(var(--c1r), 0.45);
  }

  .rol-opcion input {
    /* `accent-color` en vez de un radio dibujado a mano: mantiene el control
       nativo (foco, teclado, lectores de pantalla) y sólo le cambia el color. */
    accent-color: var(--c1);
    width: 1.05rem;
    height: 1.05rem;
    margin: 0.15rem 0 0;
    flex-shrink: 0;
    cursor: inherit;
  }

  .rol-opcion:has(input:checked) {
    border-color: var(--c1);
    background: color-mix(in srgb, var(--c1) 8%, var(--bg-input));
  }

  /* El foco va al <label> entero porque el radio real es chico y el área
     clickeable es la tarjeta: sin esto, navegando con teclado no se ve dónde
     estás parado. */
  .rol-opcion:has(input:focus-visible) {
    border-color: var(--c1);
    box-shadow: 0 0 0 3px rgba(var(--c1r), 0.12);
  }

  .rol-opcion-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .rol-opcion-titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--txt-1);
  }

  .rol-opcion-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--txt-2);
  }

  /* --- Opción agotada (participante con el cupo lleno).

     El gris es la misma señal que da el chip del hero cuando el cupo se llena
     (`.cupo-chip[data-estado='completo']`): fondo apagado, borde neutro, texto
     secundario. Son la misma información en dos superficies, así que se leen
     igual.

     ⚠️ El color NO es el mensaje: el badge "Completo" dice lo mismo en texto y
     el radio queda `disabled`, que es lo que anuncian los lectores de pantalla.
     Nadie depende de ver el gris. */
  .rol-opcion:has(input:disabled) {
    background: var(--bg-3);
    border-color: var(--brd);
    cursor: not-allowed;
  }

  .rol-opcion:has(input:disabled):hover {
    border-color: var(--brd);
  }

  .rol-opcion:has(input:disabled) .rol-opcion-titulo,
  .rol-opcion:has(input:disabled) .rol-opcion-desc {
    color: var(--txt-m);
  }

  .rol-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-full);
    background: var(--bg-2);
    border: 1px solid var(--brd);
    color: var(--txt-2);
    white-space: nowrap;
  }

  /* Mismo problema que en `.auth-form`: `display: flex` le gana al `hidden`. */
  .campos-cuenta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .campos-cuenta[hidden] {
    display: none;
  }

  .rol-aviso {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--c1) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c1) 35%, transparent);
    color: var(--txt-2);
    font-size: 0.9rem;
    text-align: center;
  }

  .registro-cerrado h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--txt-1);
    margin-bottom: 0.75rem;
  }

  .registro-cerrado p {
    color: var(--txt-2);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .registro-cerrado p:last-child {
    margin-bottom: 0;
  }
</style>

<script>
  import { createBrowserClient } from '@supabase/ssr';

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;
  const successDiv = document.getElementById('form-success') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const subtituloEl = document.getElementById('auth-subtitle') as HTMLParagraphElement;
  const rolAvisoEl = document.getElementById('rol-aviso') as HTMLParagraphElement;
  const cerradoEl = document.getElementById('registro-cerrado') as HTMLDivElement;
  const camposEl = document.getElementById('campos-cuenta') as HTMLDivElement;
  const radioUsuario = document.getElementById('rol-usuario') as HTMLInputElement;
  const badgeUsuario = document.getElementById('rol-badge-usuario') as HTMLSpanElement;
  const descUsuario = document.getElementById('rol-desc-usuario') as HTMLSpanElement;
  const radios = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="rol"]'),
  );

  /** Subtítulo por defecto, para poder volver a él al cambiar de rol. */
  const SUBTITULO_BASE = subtituloEl.textContent ?? '';

  const CUPO_LLENO =
    'La inscripción está cerrada: se completaron los 300 lugares para participantes. ' +
    'Si ya creaste tu cuenta, iniciá sesión para completar tu perfil.';

  /**
   * Roles que NO ocupan cupo y por eso conservan la puerta abierta con la
   * inscripción de participantes cerrada. La lista es blanca a propósito:
   * `handle_new_user` en la base vuelve a filtrar contra estos mismos valores,
   * así que un rol inventado —en la barra de direcciones o tocando el DOM— no
   * escala nada.
   *
   * Y tampoco sirve para colarse al cupo: quien nace mentor y después intenta
   * pasarse a participante cae en el trigger `enforce_max_participants` con
   * `OLD.role <> 'usuario'`, que lo rechaza.
   */
  const ROLES_SIN_CUPO = ['mentor', 'juez'];
  const ETIQUETA_ROL: Record<string, string> = { mentor: 'mentor', juez: 'juez' };

  /** El rol tildado ahora mismo, o '' si el usuario todavía no eligió. */
  function rolElegido(): string {
    return radios.find((r) => r.checked)?.value ?? '';
  }

  /** El rol a mandarle a la base, sólo si está en la lista blanca. */
  function rolAlta(): string | null {
    const rol = rolElegido();
    return ROLES_SIN_CUPO.includes(rol) ? rol : null;
  }

  /**
   * `?rol=mentor|juez` sigue funcionando: los links ya repartidos por WhatsApp
   * no se pueden despublicar. Ahora es un atajo que pretilda la opción, no el
   * único camino.
   */
  const rolPedido = new URLSearchParams(window.location.search).get('rol') || '';
  if (ROLES_SIN_CUPO.includes(rolPedido)) {
    const radio = radios.find((r) => r.value === rolPedido);
    if (radio) radio.checked = true;
  }

  /**
   * Estado de la página según el rol elegido y el cupo. Es la única función que
   * muestra y esconde cosas, para que no queden dos caminos que se pisen.
   */
  let cupoLlenoConfirmado = false;

  function aplicarEstado() {
    const alta = rolAlta();

    if (alta) {
      const etiqueta = ETIQUETA_ROL[alta];
      subtituloEl.textContent = `Creá tu cuenta como ${etiqueta} de la Hackathon EduTech 2026`;
      rolAvisoEl.textContent =
        `Te estás registrando como ${etiqueta}. Tu inscripción queda pendiente de aprobación ` +
        'del equipo organizador.';
      rolAvisoEl.hidden = false;
    } else {
      subtituloEl.textContent = SUBTITULO_BASE;
      rolAvisoEl.hidden = true;
    }

    // Con el cupo lleno, participante queda deshabilitado y sin tildar: acá el
    // rol elegido es '' y no hay a quién dejar seguir hasta que elija mentor o
    // jurado.
    const bloqueado = cupoLlenoConfirmado && !alta;
    camposEl.hidden = bloqueado;
    cerradoEl.hidden = !bloqueado;
    subtituloEl.hidden = bloqueado;
  }

  radios.forEach((r) => r.addEventListener('change', aplicarEstado));
  aplicarEstado();

  /**
   * Apaga la opción de participante si ya no quedan lugares.
   *
   * ⚠️ El formulario arranca ABIERTO y se cierra recién al confirmar que no hay
   * lugar, nunca al revés. Si `/api/cupo` se cae —ya pasó, un 503 por una env
   * var faltante— el modo de falla tiene que ser "se puede intentar" y que
   * decida la base, no "nadie se registra nunca".
   */
  async function chequearCupo() {
    let cupo: { hayLugar?: boolean };
    try {
      const res = await fetch('/api/cupo');
      if (!res.ok) return;
      cupo = await res.json();
    } catch {
      return;
    }

    if (cupo?.hayLugar !== false) return;

    cupoLlenoConfirmado = true;

    // Gris + badge "Completo", el mismo lenguaje que el chip del hero cuando el
    // cupo se llena. `disabled` es lo que hace el trabajo de verdad: saca la
    // opción del recorrido de teclado y los lectores de pantalla la anuncian.
    radioUsuario.disabled = true;
    radioUsuario.checked = false;
    badgeUsuario.hidden = false;
    descUsuario.textContent = 'Se completaron los 300 lugares. No quedan cupos.';

    aplicarEstado();
  }

  chequearCupo();

  /** Repregunta puntual para no atribuirle al cupo un error que no es suyo. */
  async function cupoLleno(): Promise<boolean> {
    try {
      const res = await fetch('/api/cupo');
      if (!res.ok) return false;
      return (await res.json())?.hayLugar === false;
    } catch {
      return false;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.style.display = 'none';
    successDiv.style.display = 'none';

    const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
    const password = (form.querySelector('#password') as HTMLInputElement).value;

    // Validación básica del lado del cliente
    if (!email || !password) {
      errorDiv.textContent = 'Por favor, completá todos los campos.';
      errorDiv.style.display = 'block';
      return;
    }

    if (password.length < 8) {
      errorDiv.textContent = 'La contraseña debe tener al menos 8 caracteres.';
      errorDiv.style.display = 'block';
      return;
    }

    // Sin rol elegido no hay alta: sólo pasa con el cupo lleno, donde
    // participante quedó deshabilitado y todavía no tildaron otra opción.
    const rolPara = rolAlta();
    if (!rolPara && cupoLlenoConfirmado) {
      errorDiv.textContent = 'Elegí si te registrás como mentor o como jurado.';
      errorDiv.style.display = 'block';
      return;
    }

    // Estado de carga
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creando cuenta...';

    // El rol viaja en la metadata del signup y lo lee `handle_new_user`. Sin
    // esto toda cuenta nueva nace como 'usuario' (el DEFAULT de la columna) y
    // el trigger del cupo la rechazaría con la inscripción cerrada.
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      ...(rolPara ? { options: { data: { role: rolPara } } } : {}),
    });

    if (error) {
      let msg = error.message;
      if (error.message.includes('Email logins are disabled')) {
        msg = 'El registro con email está desactivado en la configuración de Supabase.';
      } else if (/max_participants/i.test(error.message)) {
        // El trigger habla: llegó entero hasta acá.
        msg = CUPO_LLENO;
      } else if (/Database error saving new user/i.test(error.message)) {
        // Supabase Auth esconde el detalle del trigger detrás de este texto
        // genérico, así que no se puede afirmar que sea el cupo: se vuelve a
        // preguntar antes de echarle la culpa. Cualquier otra falla de base
        // sigue mostrando su mensaje real en vez de una excusa inventada.
        msg = (await cupoLleno()) ? CUPO_LLENO : msg;
      }
      errorDiv.textContent = msg;
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear cuenta';
      return;
    }

    // Registro exitoso
    if (data.user?.identities?.length === 0) {
      // El email ya existe en Supabase
      errorDiv.textContent = 'Ya existe una cuenta con este correo electrónico.';
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear cuenta';
      return;
    }

    successDiv.textContent = '¡Cuenta creada! Redirigiendo...';
    successDiv.style.display = 'block';
    submitBtn.textContent = 'Cuenta creada ✓';

    // Redirigir al onboarding tras el signup exitoso
    setTimeout(() => { window.location.href = '/onboarding'; }, 800);
  });

  // Password Visibility Toggle
  const togglePassword = document.getElementById('togglePassword');
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  togglePassword?.addEventListener('click', () => {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    togglePassword.setAttribute('aria-label', type === 'text' ? 'Ocultar contraseña' : 'Mostrar contraseña');

    // Update icon
    if (type === 'text') {
      togglePassword.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
    } else {
      togglePassword.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
    }
  });
</script>
