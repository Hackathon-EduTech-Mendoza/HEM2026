---
// src/pages/mentoria.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { createServerClient, parseCookieHeader } from '@supabase/ssr';

const user = Astro.locals.user;
const profile = Astro.locals.profile;

// Doble validación de seguridad
if (!user || (profile?.role !== 'mentor' && profile?.role !== 'admin' && profile?.role !== 'superadmin')) {
  return Astro.redirect('/dashboard');
}

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        try {
          return parseCookieHeader(Astro.request.headers.get('Cookie') ?? '');
        } catch {
          return [];
        }
      },
      setAll() {}
    }
  }
);

// Obtener equipos asignados al mentor logueado
const { data: assignedTeamsData, error: teamsError } = await supabase
  .from('teams')
  .select(`
    id,
    name,
    join_code,
    leader_id,
    mentor_id,
    mentor_id_2,
    profiles:profiles!team_id (
      id,
      full_name,
      disciplinary_profile,
      is_egresado
    ),
    projects (
      id,
      title,
      description_problem,
      description_solution,
      prototype_url,
      support_url
    )
  `)
  .or(`mentor_id.eq.${user.id},mentor_id_2.eq.${user.id}`)
  .order('name', { ascending: true });

if (teamsError) {
  console.error("Error fetching assigned teams:", teamsError);
}

const assignedTeams = assignedTeamsData || [];
---

<Layout title="Panel de Mentoría | HEM2026">
  <main class="mentor-page">
    <div class="container mentor-container">
      <div class="mentor-header">
        <h1>Panel de Mentoría</h1>
        <p class="mentor-subtitle">Revisá los equipos asignados a tu tutoría, sus integrantes y el estado de sus proyectos.</p>
      </div>

      <div class="mentor-sections">
        <section class="mentor-section">
          <h2 class="section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Mis Equipos Asignados
            <span class="badge badge-active">{assignedTeams.length}</span>
          </h2>

          <div class="assigned-teams-grid">
            {assignedTeams.length === 0 ? (
              <div class="empty-state card">
                <div class="empty-icon">👥</div>
                <p>No tenés equipos asignados en este momento.</p>
                <small>Cuando la organización te asigne un equipo, lo verás reflejado aquí.</small>
              </div>
            ) : (
              assignedTeams.map(team => {
                // Determinar el slot del mentor actual para este equipo
                const isMentor1 = team.mentor_id === user.id;
                const isMentor2 = team.mentor_id_2 === user.id;
                let roleBadgeLabel = "Mentor";
                let roleBadgeClass = "badge-mentor-general";
                
                if (isMentor1 && isMentor2) {
                  roleBadgeLabel = "Mentor Técnico & Pedagógico";
                  roleBadgeClass = "badge-mentor-both";
                } else if (isMentor1) {
                  roleBadgeLabel = "Mentor Técnico (Slot 1)";
                  roleBadgeClass = "badge-mentor-tecnico";
                } else if (isMentor2) {
                  roleBadgeLabel = "Mentor Pedagógico (Slot 2)";
                  roleBadgeClass = "badge-mentor-pedagogico";
                }

                // Obtener el proyecto (se espera relación de 1-1, pero PostgREST puede devolverlo como array u objeto)
                const project = Array.isArray(team.projects) ? team.projects[0] : team.projects;

                return (
                  <div class="team-card card">
                    <div class="team-card-header">
                      <div class="team-title-row">
                        <h3>{team.name}</h3>
                        <span class={`mentor-slot-badge ${roleBadgeClass}`}>{roleBadgeLabel}</span>
                      </div>
                      <div class="team-code-row">
                        <span class="code-label">Código de unión:</span>
                        <code class="code-value">{team.join_code || '------'}</code>
                      </div>
                    </div>

                    <div class="team-card-body">
                      <!-- Integrantes -->
                      <div class="team-section-block">
                        <h4>Integrantes ({team.profiles?.length || 0})</h4>
                        {(!team.profiles || team.profiles.length === 0) ? (
                          <p class="text-muted small">No hay integrantes en este equipo aún.</p>
                        ) : (
                          <ul class="member-list-mini">
                            {team.profiles.map(m => {
                              const isLeader = m.id === team.leader_id;
                              const displayName = m.full_name || 'Sin nombre';
                              const initials = displayName.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
                              
                              return (
                                <li class="member-item-mini">
                                  <span class="member-avatar-mini">{initials}</span>
                                  <div class="member-info-mini">
                                    <span class="member-name-mini">{displayName}</span>
                                    <div class="member-badges-mini">
                                      {isLeader && <span class="member-badge-mini badge-leader">Líder</span>}
                                      {m.is_egresado && <span class="member-badge-mini badge-egresado">Egresado</span>}
                                      {m.disciplinary_profile && (
                                        <span class={`member-badge-mini badge-profile-mini badge-profile-mini-${m.disciplinary_profile}`}>
                                          {m.disciplinary_profile === 'tecnico' ? 'Técnico' : m.disciplinary_profile === 'docente' ? 'Docente' : 'Otro'}
                                        </span>
                                      )}
                                    </div>
                                  </div>
                                </li>
                              );
                            })}
                          </ul>
                        )}
                      </div>

                      <!-- Proyecto -->
                      <div class="team-section-block project-block">
                        <h4>Proyecto</h4>
                        {project ? (
                          <div class="project-details-mini">
                            <h5 class="project-title-mini">{project.title}</h5>
                            
                            {project.description_problem && (
                              <div class="project-desc-item">
                                <strong>Problema:</strong>
                                <p>{project.description_problem}</p>
                              </div>
                            )}
                            
                            {project.description_solution && (
                              <div class="project-desc-item">
                                <strong>Solución:</strong>
                                <p>{project.description_solution}</p>
                              </div>
                            )}

                            <div class="project-actions-mini">
                              {project.prototype_url && (
                                <a href={project.prototype_url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm project-link-btn">
                                  🌐 Ver Prototipo
                                </a>
                              )}
                              {project.support_url && (
                                <a href={project.support_url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm project-link-btn">
                                  📁 Material de Apoyo
                                </a>
                              )}
                            </div>
                          </div>
                        ) : (
                          <div class="no-project-state">
                            <span class="no-project-icon">📝</span>
                            <p>El equipo aún no ha subido su proyecto.</p>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  .mentor-page {
    min-height: calc(100vh - var(--nav-h));
    padding: calc(var(--nav-h) + 2rem) 0 4rem;
    background: var(--bg-3);
  }

  .mentor-container {
    max-width: 1200px;
  }

  .mentor-header {
    margin-bottom: 2.5rem;
  }

  .mentor-header h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--txt-1);
  }

  .mentor-subtitle {
    color: var(--txt-2);
    font-size: 1.1rem;
  }

  .mentor-sections {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    font-size: 1.5rem;
    color: var(--txt-1);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-active {
    background: var(--c1);
    color: white;
    padding: 0.1rem 0.6rem;
    border-radius: var(--r-full);
    font-size: 0.9rem;
  }

  /* Assigned Teams Grid */
  .assigned-teams-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .assigned-teams-grid {
      grid-template-columns: repeat(auto-fill, minmax(540px, 1fr));
    }
  }

  .team-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--brd);
    border-radius: var(--r-lg);
    overflow: hidden;
    height: 100%;
  }

  .team-card-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--brd);
    background: rgba(var(--c3r), 0.02);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .team-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .team-title-row h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--txt-1);
  }

  .mentor-slot-badge {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: var(--r-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-mentor-tecnico {
    background: rgba(136, 0, 123, 0.1);
    color: var(--c1);
    border: 1px solid rgba(136, 0, 123, 0.25);
  }

  .badge-mentor-pedagogico {
    background: rgba(159, 198, 55, 0.1);
    color: var(--c2);
    border: 1px solid rgba(159, 198, 55, 0.25);
  }

  .badge-mentor-both {
    background: rgba(var(--c3r), 0.1);
    color: var(--c3);
    border: 1px solid rgba(var(--c3r), 0.2);
  }

  .badge-mentor-general {
    background: var(--bg-2);
    color: var(--txt-2);
    border: 1px solid var(--brd);
  }

  .team-code-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .code-label {
    color: var(--txt-m);
  }

  .code-value {
    font-family: monospace;
    font-weight: 700;
    color: var(--txt-1);
    background: var(--bg-2);
    padding: 0.1rem 0.4rem;
    border-radius: var(--r-sm);
    letter-spacing: 0.05em;
  }

  .team-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex-grow: 1;
  }

  .team-section-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .team-section-block h4 {
    font-size: 0.95rem;
    color: var(--txt-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--brd);
    padding-bottom: 0.25rem;
    margin-bottom: 0.25rem;
  }

  /* Member List styling */
  .member-list-mini {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .member-item-mini {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .member-avatar-mini {
    width: 32px;
    height: 32px;
    background: var(--bg-2);
    color: var(--txt-1);
    border: 1px solid var(--brd);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
    border-radius: var(--r-full);
  }

  .member-info-mini {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-grow: 1;
  }

  .member-name-mini {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--txt-1);
    line-height: 1.2;
  }

  .member-badges-mini {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.15rem;
  }

  .member-badge-mini {
    font-size: 0.7rem;
    padding: 0.05rem 0.4rem;
    border-radius: var(--r-sm);
    font-weight: 600;
    line-height: 1.2;
  }

  .badge-leader {
    background: rgba(234, 179, 8, 0.15);
    color: #ca8a04;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }

  .badge-egresado {
    background: rgba(136, 0, 123, 0.1);
    color: var(--c1);
    border: 1px solid rgba(136, 0, 123, 0.2);
  }

  .badge-profile-mini {
    text-transform: capitalize;
  }

  .badge-profile-mini-tecnico {
    background: rgba(59, 130, 246, 0.1);
    color: #2563eb;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }

  .badge-profile-mini-docente {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .badge-profile-mini-otro {
    background: var(--bg-3);
    color: var(--txt-2);
    border: 1px solid var(--brd);
  }

  /* Project styling */
  .project-block {
    margin-top: auto;
  }

  .project-details-mini {
    background: rgba(var(--c3r), 0.015);
    border: 1px solid var(--brd);
    border-radius: var(--r-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-title-mini {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--txt-1);
    margin-bottom: 0.25rem;
  }

  .project-desc-item {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .project-desc-item strong {
    color: var(--txt-2);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.1rem;
  }

  .project-desc-item p {
    color: var(--txt-1);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-actions-mini {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .project-link-btn {
    flex: 1;
    font-size: 0.8rem;
    padding: 0.5rem;
    text-align: center;
    border-radius: var(--r-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    font-weight: 600;
    transition: all var(--t-fast);
  }

  .btn-primary {
    background: var(--c1);
    color: white;
    border: 1px solid var(--c1);
  }
  .btn-primary:hover {
    background: transparent;
    color: var(--c1);
  }

  .btn-secondary {
    background: transparent;
    color: var(--txt-1);
    border: 1px solid var(--brd);
  }
  .btn-secondary:hover {
    background: var(--bg-2);
    border-color: var(--txt-2);
  }

  .no-project-state {
    padding: 1.5rem;
    text-align: center;
    background: rgba(var(--c3r), 0.01);
    border: 1px dashed var(--brd);
    border-radius: var(--r-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .no-project-icon {
    font-size: 1.5rem;
  }

  .no-project-state p {
    font-size: 0.85rem;
    color: var(--txt-m);
    margin: 0;
  }

  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    border: 2px dashed var(--brd);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .empty-state p {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--txt-1);
    margin: 0;
  }

  .empty-state small {
    color: var(--txt-m);
    font-size: 0.9rem;
  }
</style>

<script>
  window.addEventListener('focus', () => {
    document.title = 'Panel de Mentoría | HEM2026';
  }, { once: true });
</script>
