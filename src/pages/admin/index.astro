            </p>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Toast Notification -->
    <div id="toast" class="toast" role="status" aria-live="polite">
      <span id="toast-msg">Cambios guardados</span>
    </div>
  </div>
</Layout>

