              <option value="juez">Juez</option>
              <option value="admin">Admin</option>
              <option value="superadmin">Superadmin</option>
            </select>
            <select id="filter-status" class="filter-select">
              <option value="all">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="aprobado">Aprobado</option>
              <option value="rechazado">Rechazado</option>
            </select>
            <select id="filter-completitud" class="filter-select">
              <option value="all">Completos e incompletos</option>
              <option value="completo">Solo perfiles completos</option>
              <option value="incompleto">Solo registros incompletos</option>
            </select>
            {/* Pedido de Martín (22/08): sobre todo para contar cuántos mentores
                técnicos y cuántos docentes hay. Combinado con el filtro de rol,
                el contador de abajo da el número. */}
            <select id="filter-perfil" class="filter-select">
              <option value="all">Todos los perfiles</option>
              <option value="tecnico">Perfil técnico</option>
              <option value="docente">Perfil docente</option>
              <option value="otro">Perfil otro</option>
              <option value="sin-perfil">Sin perfil cargado</option>
            </select>
          </div>
          <button id="bulk-approve-btn" class="btn btn-primary" disabled>
