<script>
  import { createBrowserClient } from "@supabase/ssr";
  import { showConfirm } from "../../utils/alerts.js";

  // --- Lógica de Tabs ---
  const tabBtns = document.querySelectorAll(".tab-btn");
  const tabContents = document.querySelectorAll(".tab-content");

  function activateTab(targetId: string) {
    tabBtns.forEach((b) => {
      if (b.getAttribute("data-target") === targetId) {
        b.classList.add("active");
      } else {
        b.classList.remove("active");
      }
    });

    tabContents.forEach((c) => {
      if (c.getAttribute("id") === targetId) {
        c.classList.add("active");
      } else {
        c.classList.remove("active");
      }
    });

    localStorage.setItem("admin-active-tab", targetId);
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      if (targetId) {
        activateTab(targetId);
      }
    });
  });

  // Restaurar pestaña activa al cargar
  const savedTab = localStorage.getItem("admin-active-tab");
  if (savedTab && document.getElementById(savedTab)) {
    activateTab(savedTab);
  } else {
    activateTab("tab-metricas");
  }

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const toast = document.getElementById("toast");
  const toastMsg = document.getElementById("toast-msg");
  let toastTimeout: ReturnType<typeof setTimeout>;

  function showToast(message: string, isError = false) {
    if (!toast || !toastMsg) return;

    toastMsg.textContent = message;

    if (isError) {
      toast.classList.add("error");
    } else {
      toast.classList.remove("error");
    }

    toast.classList.add("show");

    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toast.classList.remove("show");
    }, 3000);
  }

  // ──────────────────────────────────────────────────
  // Consultas del sitio: cambiar el estado
  // El CHECK `consultas_respondida_check` exige que responded_at vaya con
  // valor sólo cuando el estado es 'respondida', así que se manda siempre
  // el par completo y no sólo el estado.
  // ──────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".js-consulta-estado").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.id;
      const nuevoEstado = btn.dataset.estado;
      if (!id || !nuevoEstado) return;

      const fila = btn.closest("tr");
      const botones = fila?.querySelectorAll<HTMLButtonElement>(".js-consulta-estado");
      botones?.forEach((b) => (b.disabled = true));

      const { data: { user: adminUser } } = await supabase.auth.getUser();

      const { error } = await supabase
        .from("consultas")
        .update({
          estado: nuevoEstado,
          responded_at: nuevoEstado === "respondida" ? new Date().toISOString() : null,
          responded_by: nuevoEstado === "respondida" ? adminUser?.id ?? null : null,
        })
        .eq("id", id);

      if (error) {
        console.error("Error al actualizar la consulta:", error);
        showToast("No se pudo actualizar la consulta.", true);
        botones?.forEach((b) => (b.disabled = false));
        return;
      }

      showToast(
        nuevoEstado === "respondida"
          ? "Consulta marcada como respondida."
          : nuevoEstado === "archivada"
            ? "Consulta archivada."
            : "Consulta reabierta.",
      );

      // Se recarga en vez de repintar la fila a mano: el badge del tab, el
      // contador de nuevas y los botones disponibles dependen del estado.
      setTimeout(() => window.location.reload(), 700);
    });
  });

  // Escuchar cambios en los selects de rol y estado
  document
    .querySelectorAll("select.status-select, select.role-select")
    .forEach((select) => {
      select.addEventListener("change", async (e) => {
        const target = e.target as HTMLSelectElement;
        const newValue = target.value;
        const originalValue = target.getAttribute("data-original-val");
        const tr = target.closest("tr");
        const userId = tr?.getAttribute("data-user-id");
        const isRole = target.classList.contains("role-select");
        const field = isRole ? "role" : "registration_status";

        if (!userId || newValue === originalValue) return;

        target.disabled = true;

        // Actualizar en Supabase
        const { error } = await supabase
          .from("profiles")
          .update({ [field]: newValue })
          .eq("id", userId);

        target.disabled = false;

        if (error) {
          console.error("Update error:", error);
          showToast("Error al actualizar. Permisos insuficientes.", true);
          target.value = originalValue || ""; // Revertir visualmente
        } else {
          target.setAttribute("data-original-val", newValue);
          tr?.setAttribute(isRole ? "data-role" : "data-status", newValue); // Update DOM state for filters
          showToast(`Usuario actualizado correctamente`);
        }
      });
    });

  // Lógica de Filtros + Buscador
  const filterRole = document.getElementById(
    "filter-role",
  ) as HTMLSelectElement;
  const filterStatus = document.getElementById(
    "filter-status",
  ) as HTMLSelectElement;
  const searchInput = document.getElementById(
    "search-users",
  ) as HTMLInputElement;
  const filterCompletitud = document.getElementById(
    "filter-completitud",
  ) as HTMLSelectElement;
  // Acotado a la tabla de Usuarios: la clase .user-row también la usan las filas
  // de los rankings de Resultados, que quedaban ocultas al filtrar por rol.
  const rows = document.querySelectorAll("#tab-usuarios .user-row");

  function applyFilters() {
    const roleVal = filterRole.value;
    const statusVal = filterStatus.value;
    const completitudVal = filterCompletitud?.value || "all";
    const searchQuery = (searchInput?.value || "").toLowerCase().trim();

    rows.forEach((row) => {
      const rRole = row.getAttribute("data-role");
      const rStatus = row.getAttribute("data-status");
      const rCompletitud = row.getAttribute("data-completitud");

      const matchRole = roleVal === "all" || rRole === roleVal;
      const matchStatus = statusVal === "all" || rStatus === statusVal;
      const matchCompletitud =
        completitudVal === "all" || rCompletitud === completitudVal;

      // Buscar en nombre y DNI
      let matchSearch = true;
      if (searchQuery) {
        const cells = row.querySelectorAll("td");
        const nameText = (cells[1]?.textContent || "").toLowerCase();
        const dniText = (cells[2]?.textContent || "").toLowerCase();
        matchSearch = nameText.includes(searchQuery) || dniText.includes(searchQuery);
      }

      const isVisible = matchRole && matchStatus && matchCompletitud && matchSearch;
      (row as HTMLElement).style.display = isVisible ? "" : "none";

      // Uncheck if hidden
      if (!isVisible) {
        const cb = row.querySelector(".row-checkbox") as HTMLInputElement;
        if (cb) cb.checked = false;
      }
    });
    actualizarContador();
    updateBulkBtn();
  }

  // Cuántas filas quedaron a la vista. Con el listado scrolleando dentro de su
  // caja no se puede estimar el total de un vistazo, y el filtro deja de dar
  // señal de si acotó mucho o poco.
  const contador = document.getElementById("users-count");

  function actualizarContador() {
    if (!contador) return;
    const visibles = Array.from(rows).filter(
      (r) => (r as HTMLElement).style.display !== "none",
    ).length;
    contador.innerHTML =
      visibles === rows.length
        ? `<strong>${rows.length}</strong> usuarios`
        : `<strong>${visibles}</strong> de ${rows.length} usuarios`;
  }

  actualizarContador();

  filterRole?.addEventListener("change", applyFilters);
  filterStatus?.addEventListener("change", applyFilters);
  filterCompletitud?.addEventListener("change", applyFilters);
  searchInput?.addEventListener("input", applyFilters);

  // Atajo del aviso de Métricas: salta a Usuarios ya filtrado por incompletos.
  document.querySelector("[data-goto-incompletos]")?.addEventListener("click", () => {
    (document.querySelector('.tab-btn[data-target="tab-usuarios"]') as HTMLElement)?.click();
    if (filterCompletitud) {
      filterCompletitud.value = "incompleto";
      applyFilters();
    }
  });

  // Lógica de Acciones Masivas
  const selectAll = document.getElementById("select-all") as HTMLInputElement;
  const rowCheckboxes = document.querySelectorAll(
    ".row-checkbox",
  ) as NodeListOf<HTMLInputElement>;
  const bulkApproveBtn = document.getElementById(
    "bulk-approve-btn",
  ) as HTMLButtonElement;

  function updateBulkBtn() {
    const checkedCount = Array.from(rowCheckboxes).filter(
      (cb) => cb.checked,
    ).length;
    if (bulkApproveBtn) {
      bulkApproveBtn.disabled = checkedCount === 0;
      bulkApproveBtn.textContent = `Aprobar Seleccionados (${checkedCount})`;
    }
  }

  selectAll?.addEventListener("change", (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    rowCheckboxes.forEach((cb) => {
      const row = cb.closest("tr");
      // Seleccionar solo filas visibles
      if (row && row.style.display !== "none") {
        cb.checked = checked;
      }
    });
    updateBulkBtn();
  });

  rowCheckboxes.forEach((cb) => {
    cb.addEventListener("change", () => {
      const allVisible = Array.from(rows).filter(
        (r) => (r as HTMLElement).style.display !== "none",
      );
      const checkedVisible = Array.from(rowCheckboxes).filter(
        (c) => c.checked && c.closest("tr")?.style.display !== "none",
      );
      if (selectAll)
        selectAll.checked =
          allVisible.length > 0 && allVisible.length === checkedVisible.length;
      updateBulkBtn();
    });
  });

  bulkApproveBtn?.addEventListener("click", async () => {
    const selectedIds = Array.from(rowCheckboxes)
      .filter((cb) => cb.checked)
      .map((cb) => cb.value);

    if (selectedIds.length === 0) return;

    bulkApproveBtn.disabled = true;
    bulkApproveBtn.textContent = "Aprobando...";

    const { error } = await supabase
      .from("profiles")
      .update({ registration_status: "aprobado" })
      .in("id", selectedIds);

    if (error) {
      console.error("Bulk update error:", error);
      showToast("Error al actualizar registros masivamente", true);
      bulkApproveBtn.disabled = false;
      updateBulkBtn();
    } else {
      showToast(`${selectedIds.length} usuarios aprobados con éxito`);

      // Update DOM
      selectedIds.forEach((id) => {
        const row = document.querySelector(`tr[data-user-id="${id}"]`);
        if (row) {
          row.setAttribute("data-status", "aprobado");
          const select = row.querySelector(
            ".status-select",
          ) as HTMLSelectElement;
          if (select) {
            select.value = "aprobado";
            select.setAttribute("data-original-val", "aprobado");
          }
        }
      });

      // Reset
      if (selectAll) selectAll.checked = false;
      rowCheckboxes.forEach((cb) => (cb.checked = false));
      updateBulkBtn();
    }
  });

  // Lógica del Toggle de Equipos
  const teamsToggle = document.getElementById(
    "teams-enabled-toggle",
  ) as HTMLInputElement;
  teamsToggle?.addEventListener("change", async (e) => {
    const target = e.target as HTMLInputElement;
    const newValue = target.checked ? "true" : "false";
    target.disabled = true;

    const { error } = await supabase
      .from("event_config")
      .update({ value: newValue })
      .eq("key", "teams_enabled");

    if (error) {
      console.error("Update config error:", error);
      showToast("Error al actualizar configuración.", true);
      target.checked = !target.checked; // Revertir visualmente
    } else {
      showToast(
        newValue === "true"
          ? "Formación de equipos habilitada"
          : "Formación de equipos deshabilitada",
      );
    }
    target.disabled = false;
  });

  // Lógica del Toggle de Proyectos
  const projectsToggle = document.getElementById(
    "projects-enabled-toggle",
  ) as HTMLInputElement;
  projectsToggle?.addEventListener("change", async (e) => {
    const target = e.target as HTMLInputElement;
    const newValue = target.checked ? "true" : "false";
    target.disabled = true;

    const { error } = await supabase
      .from("event_config")
      .update({ value: newValue })
      .eq("key", "project_submission_enabled");

    if (error) {
      console.error("Update config error:", error);
      showToast("Error al actualizar configuración.", true);
      target.checked = !target.checked; // Revertir visualmente
    } else {
      showToast(
        newValue === "true"
          ? "Recepción de proyectos habilitada"
          : "Recepción de proyectos deshabilitada",
      );
    }
    target.disabled = false;
  });

  // Lógica del Selector de Fase de Evaluación
  const phaseSelect = document.getElementById(
    "evaluation-phase-select",
  ) as HTMLSelectElement;
  const phaseLabels: Record<string, string> = {
    cerrada: "Evaluación cerrada",
    preclasificacion: "Fase de Preclasificación habilitada",
    deliberacion: "Votación pausada (deliberación)",
    final: "Ronda Final habilitada",
  };
  phaseSelect?.addEventListener("change", async (e) => {
    const target = e.target as HTMLSelectElement;
    const previousValue = target.getAttribute("data-original-val") || target.value;
    const newValue = target.value;
    target.disabled = true;

    const { error } = await supabase
      .from("event_config")
      .update({ value: newValue })
      .eq("key", "evaluation_phase");

    if (error) {
      console.error("Update config error:", error);
      showToast("Error al actualizar configuración.", true);
      target.value = previousValue; // Revertir visualmente
    } else {
      target.setAttribute("data-original-val", newValue);
      showToast(phaseLabels[newValue] || "Fase actualizada");
    }
    target.disabled = false;
  });

  // Lógica del Toggle de Ayuda SOS
  const helpToggle = document.getElementById(
    "help-enabled-toggle",
  ) as HTMLInputElement;
  helpToggle?.addEventListener("change", async (e) => {
    const target = e.target as HTMLInputElement;
    const newValue = target.checked ? "true" : "false";
    target.disabled = true;

    const { error } = await supabase
      .from("event_config")
      .update({ value: newValue })
      .eq("key", "help_enabled");

    if (error) {
      console.error("Update config error:", error);
      showToast("Error al actualizar configuración.", true);
      target.checked = !target.checked;
    } else {
      showToast(
        newValue === "true"
          ? "Pedidos de ayuda SOS habilitados"
          : "Pedidos de ayuda SOS deshabilitados",
      );
    }
    target.disabled = false;
  });

  // Lógica de Inputs Numéricos
  const durationInput = document.getElementById("mentor-duration-input") as HTMLInputElement;
  const cooldownInput = document.getElementById("help-cooldown-input") as HTMLInputElement;
  const maxEgresadosInput = document.getElementById("max-egresados-input") as HTMLInputElement;
  const maxTecnicosInput = document.getElementById("max-tecnicos-input") as HTMLInputElement;
  const maxDocentesInput = document.getElementById("max-docentes-input") as HTMLInputElement;
  const finalistsCountInput = document.getElementById("finalists-count-input") as HTMLInputElement;
  const minTeamSizeInput = document.getElementById("min-team-size-input") as HTMLInputElement;
  const maxParticipantsInput = document.getElementById("max-participants-input") as HTMLInputElement;

  const keyMap: Record<string, string> = {
    "mentor-duration-input": "mentor_session_duration",
    "help-cooldown-input": "help_cooldown_minutes",
    "max-egresados-input": "max_egresados_per_team",
    "max-tecnicos-input": "max_tecnicos_per_team",
    "max-docentes-input": "max_docentes_per_team",
    "finalists-count-input": "finalists_count",
    "min-team-size-input": "min_team_size",
    "max-participants-input": "max_participants"
  };

  [durationInput, cooldownInput, maxEgresadosInput, maxTecnicosInput, maxDocentesInput, finalistsCountInput, minTeamSizeInput, maxParticipantsInput].forEach(input => {
    input?.addEventListener("change", async () => {
      const key = keyMap[input.id];
      if (!key) return;

      const value = input.value;
      input.disabled = true;

      const { error } = await supabase
        .from("event_config")
        .update({ value: value })
        .eq("key", key);

      if (error) {
        showToast("Error al guardar configuración", true);
      } else {
        showToast("Configuración guardada");
      }
      input.disabled = false;
    });
  });

  // Lógica de selección de finalistas (ranking de preclasificación)
  const autoselectBtn = document.getElementById("autoselect-finalists-btn") as HTMLButtonElement;
  const saveFinalistsBtn = document.getElementById("save-finalists-btn") as HTMLButtonElement;
  const finalistCheckboxes = () =>
    Array.from(document.querySelectorAll<HTMLInputElement>(".finalist-checkbox"));

  // Marca los primeros N del ranking (las filas ya vienen ordenadas por puntaje)
  autoselectBtn?.addEventListener("click", async () => {
    const { data: countData } = await supabase
      .from("event_config")
      .select("value")
      .eq("key", "finalists_count")
      .single();
    const count = parseInt(countData?.value || "10", 10);

    finalistCheckboxes().forEach((cb, index) => {
      cb.checked = index < count;
    });
    showToast(`Top ${count} marcado. Ajustá si hace falta y guardá.`);
  });

  saveFinalistsBtn?.addEventListener("click", async () => {
    const checkboxes = finalistCheckboxes();
    if (checkboxes.length === 0) return;

    const selectedIds = checkboxes.filter((cb) => cb.checked).map((cb) => cb.dataset.projectId);
    const unselectedIds = checkboxes.filter((cb) => !cb.checked).map((cb) => cb.dataset.projectId);

    saveFinalistsBtn.disabled = true;
    saveFinalistsBtn.textContent = "Guardando...";

    let hadError = false;

    if (selectedIds.length > 0) {
      const { error } = await supabase
        .from("projects")
        .update({ is_finalist: true })
        .in("id", selectedIds);
      if (error) hadError = true;
    }

    if (unselectedIds.length > 0) {
      const { error } = await supabase
        .from("projects")
        .update({ is_finalist: false })
        .in("id", unselectedIds);
      if (error) hadError = true;
    }

    if (hadError) {
      showToast("Error al guardar finalistas.", true);
      saveFinalistsBtn.disabled = false;
      saveFinalistsBtn.textContent = "Guardar Finalistas";
    } else {
      showToast(`Finalistas guardados: ${selectedIds.length} proyectos.`);
      setTimeout(() => window.location.reload(), 1000);
    }
  });

  // Lógica de guardado de asignaciones manuales de mentores
  const saveAllMentorsBtn = document.getElementById("save-all-mentors-btn") as HTMLButtonElement;
  saveAllMentorsBtn?.addEventListener("click", async () => {
    saveAllMentorsBtn.disabled = true;
    saveAllMentorsBtn.textContent = "Guardando...";

    const rows = document.querySelectorAll(".team-mentor-row");
    const updates = Array.from(rows).map(async (row) => {
      const teamId = row.getAttribute("data-team-id");
      const mentorId = (row.querySelector(".mentor-select-1") as HTMLSelectElement).value || null;
      const mentorId2 = (row.querySelector(".mentor-select-2") as HTMLSelectElement).value || null;

      const originalMentorId = row.querySelector(".mentor-select-1")?.getAttribute("data-original-val") || null;
      const originalMentorId2 = row.querySelector(".mentor-select-2")?.getAttribute("data-original-val") || null;

      if (mentorId !== originalMentorId || mentorId2 !== originalMentorId2) {
        const { error } = await supabase
          .from("teams")
          .update({
            mentor_id: mentorId,
            mentor_id_2: mentorId2
          })
          .eq("id", teamId);

        if (error) {
          console.error(`Error al actualizar equipo ${teamId}:`, error);
          throw error;
        }

        row.querySelector(".mentor-select-1")?.setAttribute("data-original-val", mentorId || "");
        row.querySelector(".mentor-select-2")?.setAttribute("data-original-val", mentorId2 || "");
      }
    });

    try {
      await Promise.all(updates);
      showToast("Asignaciones de mentores guardadas correctamente");
    } catch (e) {
      showToast("Error al guardar algunas asignaciones", true);
    } finally {
      saveAllMentorsBtn.disabled = false;
      saveAllMentorsBtn.textContent = "Guardar Asignaciones";
    }
  });

  // Lógica de Asignación de Mentores
  const assignSimpleBtn = document.getElementById("assign-mentors-simple");
  const assignResetBtn = document.getElementById("assign-mentors-reset");

  const runAssignment = async (reset: boolean) => {
    const btn = reset ? assignResetBtn : assignSimpleBtn;
    if (!btn) return;

    const ok = await showConfirm({
      title: reset ? "¿Resetear y reasignar mentores?" : "¿Asignar mentores?",
      text: reset
        ? "Se eliminarán todas las asignaciones actuales y se repartirán los equipos de nuevo entre los mentores aprobados."
        : "Se asignarán mentores a los equipos que aún no tienen uno.",
      confirmText: reset ? "Sí, resetear" : "Sí, asignar",
      cancelText: "Cancelar",
      destructive: reset,
      icon: "warning",
    });
    if (!ok) return;

    (btn as HTMLButtonElement).disabled = true;
    const originalText = btn.textContent;
    btn.textContent = "Procesando...";

    const { data, error } = await supabase.rpc("assign_mentors_randomly", { 
      reset_current: reset 
    });

    if (error) {
      console.error("RPC Error:", error);
      showToast(error.message || "Error al ejecutar la asignación", true);
    } else {
      showToast(`Éxito: ${data.teams_updated} equipos asignados a ${data.mentors_used} mentores.`);
      setTimeout(() => window.location.reload(), 1500);
    }

    btn.textContent = originalText;
    (btn as HTMLButtonElement).disabled = false;
  };

  assignSimpleBtn?.addEventListener("click", () => runAssignment(false));
  assignResetBtn?.addEventListener("click", () => runAssignment(true));

  const refreshMentorStatsBtn = document.getElementById("refresh-mentor-stats");
  refreshMentorStatsBtn?.addEventListener("click", () => window.location.reload());

  // --- Lógica del Dialog de Ayuda ---
  const helpDialog = document.getElementById("help-dialog") as HTMLDialogElement;
  const openHelpBtn = document.getElementById("help-guide-btn");
  const closeHelpBtn = document.getElementById("close-dialog-btn");

  openHelpBtn?.addEventListener("click", () => {
    helpDialog?.showModal();
    document.body.style.overflow = 'hidden';
  });

  closeHelpBtn?.addEventListener("click", () => {
    helpDialog?.close();
  });

  // Cerrar al hacer clic en el backdrop
  helpDialog?.addEventListener("click", (e) => {
    if (e.target === helpDialog) {
      helpDialog.close();
    }
  });

  // --- Lógica del Módulo de Comunicados ---
  const bulletinFilter = document.getElementById("bulletin-filter") as HTMLSelectElement;
  const recipientCountSpan = document.getElementById("recipient-count");
  const bulletinSubject = document.getElementById("bulletin-subject") as HTMLInputElement;
  const bulletinMessage = document.getElementById("bulletin-message") as HTMLTextAreaElement;
  const charCountSpan = document.getElementById("char-count");
  const sendBulletinBtn = document.getElementById("send-bulletin-btn") as HTMLButtonElement;

  // Elementos de la vista previa
  const previewSubjectText = document.getElementById("preview-subject-text");
  const previewMessageContent = document.getElementById("preview-message-content");
  const previewFname = document.getElementById("preview-fname");
  const previewBodyFname = document.getElementById("preview-body-fname");

  // Helper para escapar HTML en la vista previa del cliente
  function clientEscapeHtml(text: string): string {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // 1. Actualizar el badge dinámico según el filtro de rol
  bulletinFilter?.addEventListener("change", () => {
    const roleVal = bulletinFilter.value;
    let count = "0";

    if (roleVal === "all") {
      count = bulletinFilter.getAttribute("data-all") || "0";
      if (previewFname) previewFname.textContent = "Participante";
      if (previewBodyFname) previewBodyFname.textContent = "Participante";
    } else if (roleVal === "participant") {
      count = bulletinFilter.getAttribute("data-participants") || "0";
      if (previewFname) previewFname.textContent = "Participante";
      if (previewBodyFname) previewBodyFname.textContent = "Participante";
    } else if (roleVal === "mentor") {
      count = bulletinFilter.getAttribute("data-mentors") || "0";
      if (previewFname) previewFname.textContent = "Mentor";
      if (previewBodyFname) previewBodyFname.textContent = "Mentor";
    } else if (roleVal === "juez") {
      count = bulletinFilter.getAttribute("data-jueces") || "0";
      if (previewFname) previewFname.textContent = "Juez";
      if (previewBodyFname) previewBodyFname.textContent = "Juez";
    } else if (roleVal === "incompleto") {
      count = bulletinFilter.getAttribute("data-incompleto") || "0";
      // Estos perfiles no tienen nombre cargado — es justamente lo que les
      // falta — así que el saludo del mail les va a decir "Participante".
      // La vista previa lo muestra tal cual para que no sorprenda.
      if (previewFname) previewFname.textContent = "Participante";
      if (previewBodyFname) previewBodyFname.textContent = "Participante";
    }

    if (recipientCountSpan) {
      recipientCountSpan.textContent = count;
    }
  });

  // 2. Actualizar el contador de caracteres del textarea
  bulletinMessage?.addEventListener("input", () => {
    const len = bulletinMessage.value.length;
    if (charCountSpan) {
      charCountSpan.textContent = len.toString();
    }
    
    // Cambiar color del contador si llega al límite
    if (len >= 4900) {
      charCountSpan?.parentElement?.classList.add("warning");
    } else {
      charCountSpan?.parentElement?.classList.remove("warning");
    }
  });

  // 3. Actualizar la vista previa del asunto
  bulletinSubject?.addEventListener("input", () => {
    const value = bulletinSubject.value.trim();
    if (previewSubjectText) {
      if (value) {
        previewSubjectText.textContent = value;
        previewSubjectText.classList.remove("preview-placeholder");
      } else {
        previewSubjectText.textContent = "Sin asunto";
        previewSubjectText.classList.add("preview-placeholder");
      }
    }
  });

  // 4. Actualizar la vista previa del mensaje convirtiendo saltos de línea a párrafos
  bulletinMessage?.addEventListener("input", () => {
    const value = bulletinMessage.value;
    if (previewMessageContent) {
      if (value.trim()) {
        const paragraphs = value
          .split("\n")
          .map(p => p.trim() !== "" ? `<p style="margin-bottom: 16px; line-height: 1.6; color: #cbd5e1;">${clientEscapeHtml(p.trim())}</p>` : "")
          .filter(p => p !== "")
          .join("");
        
        previewMessageContent.innerHTML = paragraphs;
        previewMessageContent.classList.remove("preview-placeholder");
      } else {
        previewMessageContent.innerHTML = "El contenido de tu mensaje aparecerá aquí a medida que lo redactes...";
        previewMessageContent.classList.add("preview-placeholder");
      }
    }
  });

  // 5. Envío del boletín vía fetch
  sendBulletinBtn?.addEventListener("click", async () => {
    const subject = bulletinSubject.value.trim();
    const message = bulletinMessage.value.trim();
    const roleFilter = bulletinFilter.value;
    const count = recipientCountSpan?.textContent || "0";

    // Validaciones básicas
    if (!subject) {
      showToast("Por favor, ingresa el asunto del correo.", true);
      bulletinSubject.focus();
      return;
    }

    if (!message) {
      showToast("Por favor, ingresa el contenido del mensaje.", true);
      bulletinMessage.focus();
      return;
    }

    // Confirmación del envío
    const ok = await showConfirm({
      title: roleFilter === "incompleto"
        ? `¿Mandar el recordatorio a ${count} registros incompletos?`
        : `¿Enviar comunicado a ${count} destinatarios?`,
      text: roleFilter === "incompleto"
        ? "Le va a llegar a gente que creó su cuenta y NO completó el formulario, no a los inscriptos aprobados. No queda registro de a quién ya se le mandó: si repetís el envío, lo reciben de nuevo. Esta acción no se puede deshacer y consume cuota de Brevo."
        : "Esta acción no se puede deshacer y consumirá cuota de tu límite diario de Brevo.",
      confirmText: "Sí, enviar",
      cancelText: "Cancelar",
      destructive: true,
      icon: "warning",
    });
    if (!ok) return;

    // Estado de carga
    sendBulletinBtn.disabled = true;
    const originalBtnHTML = sendBulletinBtn.innerHTML;
    sendBulletinBtn.innerHTML = `
      <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem; animation: spin 1s linear infinite;"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>
      <span>Enviando...</span>
    `;

    try {
      const response = await fetch('/api/send-bulletin', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          subject,
          message,
          roleFilter
        })
      });

      const data = await response.json();

      if (!response.ok) {
        showToast(data.error || "Ocurrió un error al enviar el comunicado.", true);
      } else {
        showToast(`✓ Comunicado enviado con éxito a ${data.recipientCount} usuarios.`);
        // Limpiar formulario al enviar con éxito
        bulletinSubject.value = "";
        bulletinMessage.value = "";
        if (charCountSpan) charCountSpan.textContent = "0";
        
        // Resetear vista previa
        if (previewSubjectText) {
          previewSubjectText.textContent = "Sin asunto";
          previewSubjectText.classList.add("preview-placeholder");
        }
        if (previewMessageContent) {
          previewMessageContent.innerHTML = "El contenido de tu mensaje aparecerá aquí a medida que lo redactes...";
          previewMessageContent.classList.add("preview-placeholder");
        }
      }
    } catch (err) {
      console.error("Fetch error sending bulletin:", err);
      showToast("Error de conexión al servidor.", true);
    } finally {
      // Restaurar estado del botón
      sendBulletinBtn.disabled = false;
      sendBulletinBtn.innerHTML = originalBtnHTML;
    }
  });
</script>
