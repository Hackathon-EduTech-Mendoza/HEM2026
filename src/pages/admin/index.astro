          <div class="preview-email-body-wrapper">
            <!-- Template HTML renderizado -->
            <div class="preview-email-body-content">
              <div style="background-color: #0f172a; color: #f1f5f9; padding: 15px; margin: 0; font-family: sans-serif;">
                <table cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155;">
