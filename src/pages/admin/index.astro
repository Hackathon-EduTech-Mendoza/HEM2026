        <div class="admin-card card">
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th style="width: 40px;">
                    <label class="checkbox-label">
                      <input type="checkbox" id="select-all" />
                      <span class="custom-checkbox"></span>
                    </label>
                  </th>
                  <th>Nombre</th>
                  <th>DNI</th>
                  <th>Institución</th>
                  <th>Perfil</th>
                  <th>Egresado</th>
                  <th>Estado Inscripción</th>
                  <th>Rol</th>
                </tr>
              </thead>
              <tbody>
                {
                  profiles.length === 0 ? (
                    <tr>
                      <td colspan="8" class="empty-state">
                        No hay usuarios registrados aún.
                      </td>
                    </tr>
                  ) : (
                    profiles.map((p) => (
                      <tr
                        data-user-id={p.id}
                        class="user-row"
                        data-role={p.role}
                        data-status={p.registration_status}
                        data-completitud={isProfileComplete(p) ? "completo" : "incompleto"}
                        data-perfil={p.disciplinary_profile || "sin-perfil"}
                      >
                        <td data-label="Seleccionar">
                          <label class="checkbox-label">
                            <input
                              type="checkbox"
                              class="row-checkbox"
                              value={p.id}
                            />
                            <span class="custom-checkbox" />
                          </label>
                        </td>
                        <td data-label="Nombre">
                          <div class="user-info">
                            <strong>{p.full_name || "Sin nombre"}</strong>
                            <span class="user-email">{p.email}</span>
                            {!isProfileComplete(p) && (
                              <span
                                class="badge badge-incompleto"
                                title="Creó la cuenta pero nunca completó el formulario de inscripción. No hay nada que aprobar."
                              >
                                Sin completar
                              </span>
                            )}
                          </div>
                        </td>
                        <td data-label="DNI">{p.dni || "-"}</td>
                        <td
                          data-label="Institución"
                          class="cell-institucion"
                          title={p.institution === "otra" ? p.institution_other || "Otra" : undefined}
                        >
                          {p.institution === "ies_9023_maipu"
                            ? "IES 9-023"
                            : p.institution === "ies_edison"
                              ? "Edison"
                              : p.institution === "otra"
                                ? p.institution_other || "Otra"
                                : "-"}
                        </td>
                        <td data-label="Perfil">
                          {p.disciplinary_profile ? (
                            <span class={`badge-profile badge-profile-${p.disciplinary_profile}`}>
                              {p.disciplinary_profile === "tecnico"
                                ? "Técnico"
                                : p.disciplinary_profile === "docente"
                                  ? "Docente"
                                  : "Otro"}
                            </span>
                          ) : (
                            "-"
                          )}
                        </td>
                        <td data-label="Egresado">
                          {p.is_egresado ? (
                            <span class="badge badge-yes">Sí</span>
                          ) : (
                            <span class="badge badge-no">No</span>
                          )}
                        </td>
                        <td data-label="Estado">
                          <select
                            class="status-select"
                            data-original-val={p.registration_status}
                          >
                            <option
                              value="pendiente"
                              selected={p.registration_status === "pendiente"}
                            >
                              Pendiente
                            </option>
                            <option
                              value="aprobado"
                              selected={p.registration_status === "aprobado"}
                            >
                              Aprobado
                            </option>
                            <option
                              value="rechazado"
                              selected={p.registration_status === "rechazado"}
                            >
                              Rechazado
                            </option>
                          </select>
                        </td>
                        <td data-label="Rol">
                          <select
                            class="role-select"
                            data-original-val={p.role}
                            disabled={
                              p.role === "superadmin" &&
                              profile.role !== "superadmin"
                            }
                          >
                            {p.role === "superadmin" && (
                              <option value="superadmin" selected>
                                Superadmin
                              </option>
                            )}
                            <option
                              value="usuario"
                              selected={p.role === "usuario"}
                            >
                              Usuario
                            </option>
                            <option
                              value="mentor"
                              selected={p.role === "mentor"}
                            >
                              Mentor
                            </option>
                            <option value="juez" selected={p.role === "juez"}>
                              Juez
                            </option>
                            {(profile.role === "admin" || profile.role === "superadmin") && (
                              <option
                                value="admin"
                                selected={p.role === "admin"}
                              >
                                Admin
                              </option>
                            )}
                            {/* Si el current user es admin, no puede ver ni asignar superadmin */}
                          </select>
                        </td>
                      </tr>
                    ))
                  )
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <!-- End tab-usuarios -->

  <div class="tab-content" id="tab-configuracion">
    <!-- La pantalla se agrupa en dos bloques porque son decisiones de
         naturaleza distinta: lo que se ABRE y CIERRA durante el evento, y los
         NÚMEROS que casi no se tocan. Buscar una cosa u otra a las apuradas el
         día D es más rápido así. -->
    <h3 class="config-seccion">Etapas del evento</h3>
    <p class="config-seccion-sub">Lo que se abre y se cierra a medida que avanza la hackathon.</p>
    <div class="config-grid">
      <div class="config-card card">
        <div class="config-info">
          <h3>Formación de Equipos</h3>
          <p>
            Permite a los participantes crear o unirse a equipos mediante
            códigos.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="teams-enabled-toggle"
              checked={teamsEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Recepción de Proyectos</h3>
          <p>
            Habilita la entrega final de proyectos (El Día D) por parte de los
            líderes.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="projects-enabled-toggle"
              checked={projectsEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card config-card--stack card">
        <div class="config-info">
          <h3>Fase de Evaluación</h3>
          <p>
            Controla qué votación está habilitada para el jurado:
            preclasificación (todos los proyectos) o ronda final (solo finalistas).
          </p>
        </div>
        <div class="config-action">
          <select id="evaluation-phase-select" class="filter-select" data-original-val={evaluationPhase}>
            <option value="cerrada" selected={evaluationPhase === "cerrada"}>Cerrada</option>
            <option value="preclasificacion" selected={evaluationPhase === "preclasificacion"}>Preclasificación</option>
            <option value="deliberacion" selected={evaluationPhase === "deliberacion"}>Deliberación (votación pausada)</option>
            <option value="final" selected={evaluationPhase === "final"}>Ronda Final</option>
          </select>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Encuesta post evento</h3>
          <p>
            Muestra la encuesta de 4 preguntas a los participantes, en el panel
            y en /encuesta. Encenderla cuando termine la Hackathon.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="survey-enabled-toggle"
              checked={surveyEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>
    </div>

    <h3 class="config-seccion">Límites y cupos</h3>
    <p class="config-seccion-sub">Números que definen las reglas. Casi no se tocan durante el evento.</p>
    <div class="config-grid">
      <div class="config-card card">
        <div class="config-info">
          <h3>Mínimo de Integrantes por Equipo</h3>
          <p>
            Un equipo por debajo de este número <strong>no puede crear su entrega</strong>.
            Es la palanca de destrabe: si el día del evento un equipo queda trabado,
            bajalo a <strong>1</strong> para desactivar la regla y volvé a subirlo después.
            El cambio es instantáneo, no requiere despliegue.
          </p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="min-team-size-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={minTeamSize}
			min="1"
			max="10"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Cupo de Participantes</h3>
          <p>
            Al llegar a este número nadie más puede elegir el rol
            <strong>Participante</strong>. Mentores y jueces no ocupan cupo.
            Hoy ocupan lugar <strong>{byRole.usuario}</strong>; los <strong>{countAbandoned}</strong>
            sin completar todavía no. <strong>0</strong> desactiva el cupo.
          </p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-participants-input"
			class="filter-select"
			style="width: 90px; text-align: center;"
			value={maxParticipants}
			min="0"
			max="2000"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Cupo de Finalistas</h3>
          <p>Cantidad de proyectos que pasan a la ronda final (Top N de la preclasificación).</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="finalists-count-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={finalistsCount}
			min="1"
			max="50"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Máx. egresados por equipo</h3>
          <p>Límite máximo de miembros egresados permitidos por equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-egresados-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={maxEgresadosPerTeam}
			min="0"
			max="5"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Máx. técnicos por equipo</h3>
          <p>Límite máximo de miembros con perfil técnico por equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-tecnicos-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={maxTecnicosPerTeam}
			min="0"
			max="5"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Máx. docentes por equipo</h3>
          <p>Límite máximo de miembros con perfil docente por equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-docentes-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={maxDocentesPerTeam}
			min="0"
			max="5"
			step="1"
		/>
        </div>
      </div>
    </div>

    <!-- Oculto temporalmente: el sistema SOS no se usa en esta edición.
         Quitar el display:none de cada card para reactivarlo. -->
    <div class="config-grid">
      <div class="config-card card" style="display: none;">
        <div class="config-info">
          <h3>Pedidos de Ayuda SOS</h3>
          <p>
            Habilita el sistema de tickets en tiempo real para que los equipos pidan ayuda.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="help-enabled-toggle"
              checked={helpEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card" style="display: none;">
        <div class="config-info">
          <h3>Duración de Sesión (Minutos)</h3>
          <p>Tiempo estimado de atención por cada ticket SOS.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="mentor-duration-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={mentorSessionDuration}
			min="5"
			max="60"
			step="5"
		/>
        </div>
      </div>

      <div class="config-card card" style="display: none;">
        <div class="config-info">
          <h3>Cooldown SOS (Minutos)</h3>
          <p>Tiempo de espera entre pedidos de ayuda de un mismo equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="help-cooldown-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={helpCooldownMinutes}
			min="0"
			max="30"
			step="1"
		/>
        </div>
      </div>
    </div>
  </div>
  <!-- End tab-configuracion -->

  <div class="tab-content" id="tab-mentoria">
    <div class="admin-actions">
      <h2 style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem;">Asignación de Mentores</h2>
      <div style="display: flex; gap: 0.5rem;">
        <button id="save-all-mentors-btn" class="btn btn-primary">
          Guardar Asignaciones
        </button>
        <button id="assign-mentors-simple" class="btn btn-outline" style="display: none;">
          Asignar Nuevos (Equitativo)
        </button>
        <button id="assign-mentors-reset" class="btn btn-outline">
          Asignación Aleatoria (1 Mentor)
        </button>
      </div>
    </div>

    <div class="config-grid" style="margin-bottom: 2rem;">
      <div class="config-card card" style="border: 1px solid var(--c1); background: rgba(var(--c1r), 0.05);">
        <div class="config-info">
          <h3>Estado de Cobertura</h3>
          <p>
            {mentorsCount} mentores aprobados disponibles para {teams.length} equipos.
          </p>
          {unassignedTeamsCount > 0 && (
            <p style="color: var(--danger); font-weight: 600; margin-top: 0.5rem;">
