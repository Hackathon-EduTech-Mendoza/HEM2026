---
// src/pages/admin/index.astro
import Layout from "../../layouts/Layout.astro";
import { createServerClient, parseCookieHeader } from "@supabase/ssr";

const user = Astro.locals.user;
const profile = Astro.locals.profile;

// Doble validación de seguridad (el middleware ya lo hace)
if (!user || (profile?.role !== "admin" && profile?.role !== "superadmin")) {
  return Astro.redirect("/dashboard");
}

// Crear cliente SSR para obtener datos con los permisos del usuario actual
const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        try {
          return parseCookieHeader(Astro.request.headers.get("Cookie") ?? "");
        } catch {
          return [];
        }
      },
      setAll() {}, // No necesitamos setear cookies aquí, solo leer
    },
  },
);

// Obtener todos los perfiles
const { data: allProfiles, error } = await supabase
  .from("profiles")
  .select(
    "id, full_name, email, dni, institution, is_egresado, role, registration_status, created_at",
  )
  .order("created_at", { ascending: false });

if (error) {
  console.error("Error fetching profiles:", error);
}

const profiles = allProfiles || [];

// Obtener configuración del evento para teams, projects y evaluations
const { data: configData } = await supabase
  .from("event_config")
  .select("key, value")
  .in("key", [
    "teams_enabled",
    "project_submission_enabled",
    "evaluation_enabled",
    "help_enabled",
    "mentor_session_duration",
    "help_cooldown_minutes",
    "max_egresados_per_team",
    "max_tecnicos_per_team",
    "max_docentes_per_team",
  ]);

const teamsEnabled =
  configData?.find((c) => c.key === "teams_enabled")?.value === "true";
const projectsEnabled =
  configData?.find((c) => c.key === "project_submission_enabled")?.value ===
  "true";
const evaluationEnabled =
  configData?.find((c) => c.key === "evaluation_enabled")?.value === "true";
const helpEnabled =
  configData?.find((c) => c.key === "help_enabled")?.value === "true";
const mentorSessionDuration =
  configData?.find((c) => c.key === "mentor_session_duration")?.value || "15";
const helpCooldownMinutes =
	configData?.find((c) => c.key === "help_cooldown_minutes")?.value || "5";
const maxEgresadosPerTeam =
  configData?.find((c) => c.key === "max_egresados_per_team")?.value || "1";
const maxTecnicosPerTeam =
  configData?.find((c) => c.key === "max_tecnicos_per_team")?.value || "2";
const maxDocentesPerTeam =
  configData?.find((c) => c.key === "max_docentes_per_team")?.value || "2";

// Obtener datos del Leaderboard
const { data: leaderboardData, error: leaderboardError } = await supabase
  .from("project_leaderboard")
  .select("*")
  .order("final_score", { ascending: false });

if (leaderboardError) {
  console.error("Error fetching leaderboard:", leaderboardError);
}

const leaderboard = leaderboardData || [];

// Obtener mentores aprobados con datos de contacto
const { data: allMentors } = await supabase
  .from("profiles")
  .select("id, full_name, first_name, last_name, email, dni, institution, disciplinary_profile")
  .eq("role", "mentor")
  .eq("registration_status", "aprobado")
  .order("full_name", { ascending: true });

const mentors = allMentors || [];
const mentorsCount = mentors.length;

// Obtener todos los equipos con sus mentores y miembros
const { data: allTeams, error: teamsError } = await supabase
  .from("teams")
  .select(`
    id,
    name,
    mentor_id,
    mentor_id_2,
    profiles:profiles!team_id (
      id,
      full_name,
      first_name,
      last_name,
      disciplinary_profile
    )
  `)
  .order("name", { ascending: true });

if (teamsError) {
  console.error("Error fetching teams in admin index:", teamsError);
}

const teams = allTeams || [];
const unassignedTeamsCount = teams.filter(t => !t.mentor_id && !t.mentor_id_2).length;

// Procesar mentores con sus equipos asignados directamente en memoria
const mentorsWithTeams = mentors.map(m => {
  const slot1Teams = teams.filter(t => t.mentor_id === m.id).map(t => t.name);
  const slot2Teams = teams.filter(t => t.mentor_id_2 === m.id).map(t => t.name);
  
  return {
    ...m,
    slot1Teams,
    slot2Teams,
    totalTeamsCount: slot1Teams.length + slot2Teams.length
  };
});
---

<Layout title="Administración | HEM2026">
  <main class="admin-page">
    <div class="container admin-container">
      <div class="admin-header">
        <div>
          <h1>Centro de Comando</h1>
          <p class="admin-subtitle">Gestión de usuarios, roles e inscripciones</p>
        </div>
        <button id="help-guide-btn" class="btn btn-outline help-btn" aria-label="Ver guía rápida">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          Guía Rápida
        </button>
      </div>

      <div class="admin-tabs-nav">
        <button class="tab-btn active" data-target="tab-usuarios"
          >Usuarios</button
        >
        <button class="tab-btn" data-target="tab-configuracion"
          >Configuración</button
        >
        <button class="tab-btn" data-target="tab-mentoria">Mentoría</button>
        <button class="tab-btn" data-target="tab-resultados">Resultados</button>
      </div>

      <div class="tab-content active" id="tab-usuarios">
        <div class="admin-actions">
          <div class="filters">
            <input type="search" id="search-users" class="search-input" placeholder="Buscar por nombre o DNI..." autocomplete="off" />
            <select id="filter-role" class="filter-select">
              <option value="all">Todos los roles</option>
              <option value="usuario">Usuario</option>
              <option value="mentor">Mentor</option>
              <option value="juez">Juez</option>
              <option value="admin">Admin</option>
              <option value="superadmin">Superadmin</option>
            </select>
            <select id="filter-status" class="filter-select">
              <option value="all">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="aprobado">Aprobado</option>
              <option value="rechazado">Rechazado</option>
            </select>
          </div>
          <button id="bulk-approve-btn" class="btn btn-primary" disabled>
            Aprobar Seleccionados (0)
          </button>
        </div>

        <div class="admin-card card">
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th style="width: 40px;">
                    <label class="checkbox-label">
                      <input type="checkbox" id="select-all" />
                      <span class="custom-checkbox"></span>
                    </label>
                  </th>
                  <th>Nombre</th>
                  <th>DNI</th>
                  <th>Institución</th>
                  <th>Egresado</th>
                  <th>Estado Inscripción</th>
                  <th>Rol</th>
                </tr>
              </thead>
              <tbody>
                {
                  profiles.length === 0 ? (
                    <tr>
                      <td colspan="7" class="empty-state">
                        No hay usuarios registrados aún.
                      </td>
                    </tr>
                  ) : (
                    profiles.map((p) => (
                      <tr
                        data-user-id={p.id}
                        class="user-row"
                        data-role={p.role}
                        data-status={p.registration_status}
                      >
                        <td data-label="Seleccionar">
                          <label class="checkbox-label">
                            <input
                              type="checkbox"
                              class="row-checkbox"
                              value={p.id}
                            />
                            <span class="custom-checkbox" />
                          </label>
                        </td>
                        <td data-label="Nombre">
                          <div class="user-info">
                            <strong>{p.full_name || "Sin nombre"}</strong>
                            <span class="user-email">{p.email}</span>
                          </div>
                        </td>
                        <td data-label="DNI">{p.dni || "-"}</td>
                        <td data-label="Institución">
                          {p.institution === "ies_9023_maipu"
                            ? "IES 9-023"
                            : p.institution === "ies_edison"
                              ? "Edison"
                              : p.institution === "otra"
                                ? "Otra"
                                : "-"}
                        </td>
                        <td data-label="Egresado">
                          {p.is_egresado ? (
                            <span class="badge badge-yes">Sí</span>
                          ) : (
                            <span class="badge badge-no">No</span>
                          )}
                        </td>
                        <td data-label="Estado">
                          <select
                            class="status-select"
                            data-original-val={p.registration_status}
                          >
                            <option
                              value="pendiente"
                              selected={p.registration_status === "pendiente"}
                            >
                              Pendiente
                            </option>
                            <option
                              value="aprobado"
                              selected={p.registration_status === "aprobado"}
                            >
                              Aprobado
                            </option>
                            <option
                              value="rechazado"
                              selected={p.registration_status === "rechazado"}
                            >
                              Rechazado
                            </option>
                          </select>
                        </td>
                        <td data-label="Rol">
                          <select
                            class="role-select"
                            data-original-val={p.role}
                            disabled={
                              p.role === "superadmin" &&
                              profile.role !== "superadmin"
                            }
                          >
                            {p.role === "superadmin" && (
                              <option value="superadmin" selected>
                                Superadmin
                              </option>
                            )}
                            <option
                              value="usuario"
                              selected={p.role === "usuario"}
                            >
                              Usuario
                            </option>
                            <option
                              value="mentor"
                              selected={p.role === "mentor"}
                            >
                              Mentor
                            </option>
                            <option value="juez" selected={p.role === "juez"}>
                              Juez
                            </option>
                            {(profile.role === "admin" || profile.role === "superadmin") && (
                              <option
                                value="admin"
                                selected={p.role === "admin"}
                              >
                                Admin
                              </option>
                            )}
                            {/* Si el current user es admin, no puede ver ni asignar superadmin */}
                          </select>
                        </td>
                      </tr>
                    ))
                  )
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <!-- End tab-usuarios -->

  <div class="tab-content" id="tab-configuracion">
    <div class="config-grid">
      <div class="config-card card">
        <div class="config-info">
          <h3>Formación de Equipos</h3>
          <p>
            Permite a los participantes crear o unirse a equipos mediante
            códigos.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="teams-enabled-toggle"
              checked={teamsEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Recepción de Proyectos</h3>
          <p>
            Habilita la entrega final de proyectos (El Día D) por parte de los
            líderes.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="projects-enabled-toggle"
              checked={projectsEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Evaluación de Jurados</h3>
          <p>
            Permite a los jueces calificar los proyectos entregados según sus
            rúbricas.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="evaluation-enabled-toggle"
              checked={evaluationEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Pedidos de Ayuda SOS</h3>
          <p>
            Habilita el sistema de tickets en tiempo real para que los equipos pidan ayuda.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="help-enabled-toggle"
              checked={helpEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Duración de Sesión (Minutos)</h3>
          <p>Tiempo estimado de atención por cada ticket SOS.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="mentor-duration-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={mentorSessionDuration}
			min="5"
			max="60"
			step="5"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Cooldown SOS (Minutos)</h3>
          <p>Tiempo de espera entre pedidos de ayuda de un mismo equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="help-cooldown-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={helpCooldownMinutes}
			min="0"
			max="30"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Máx. egresados por equipo</h3>
          <p>Límite máximo de miembros egresados permitidos por equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-egresados-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={maxEgresadosPerTeam}
			min="0"
			max="5"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Máx. técnicos por equipo</h3>
          <p>Límite máximo de miembros con perfil técnico por equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-tecnicos-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={maxTecnicosPerTeam}
			min="0"
			max="5"
			step="1"
		/>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Máx. docentes por equipo</h3>
          <p>Límite máximo de miembros con perfil docente por equipo.</p>
        </div>
        <div class="config-action">
		<input
			type="number"
			id="max-docentes-input"
			class="filter-select"
			style="width: 80px; text-align: center;"
			value={maxDocentesPerTeam}
			min="0"
			max="5"
			step="1"
		/>
        </div>
      </div>
    </div>
  </div>
  <!-- End tab-configuracion -->

  <div class="tab-content" id="tab-mentoria">
    <div class="admin-actions">
      <h2 style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem;">Asignación de Mentores</h2>
      <div style="display: flex; gap: 0.5rem;">
        <button id="save-all-mentors-btn" class="btn btn-primary">
          Guardar Asignaciones
        </button>
        <button id="assign-mentors-simple" class="btn btn-outline" style="display: none;">
          Asignar Nuevos (Equitativo)
        </button>
        <button id="assign-mentors-reset" class="btn btn-outline">
          Asignación Aleatoria (1 Mentor)
        </button>
      </div>
    </div>

    <div class="config-grid" style="margin-bottom: 2rem;">
      <div class="config-card card" style="border-left: 4px solid var(--c1);">
        <div class="config-info">
          <h3>Estado de Cobertura</h3>
          <p>
            {mentorsCount} mentores aprobados disponibles para {teams.length} equipos.
          </p>
          {unassignedTeamsCount > 0 && (
            <p style="color: var(--danger); font-weight: 600; margin-top: 0.5rem;">
              ⚠️ {unassignedTeamsCount} equipos no tienen ningún mentor asignado.
            </p>
          )}
        </div>
      </div>
    </div>

    <div class="admin-card card" style="margin-bottom: 2.5rem;">
      <div class="table-responsive">
        <table class="admin-table mentor-assignment-table">
          <thead>
            <tr>
              <th>Equipo</th>
              <th>Mentor Técnico (Slot 1)</th>
              <th>Mentor Pedagógico (Slot 2)</th>
              <th>Miembros del Equipo</th>
            </tr>
          </thead>
          <tbody>
            {teams.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-state">No hay equipos creados aún.</td>
              </tr>
            ) : (
              teams.map((t) => (
                <tr data-team-id={t.id} class="team-mentor-row">
                  <td data-label="Equipo">
                    <strong>{t.name}</strong>
                  </td>
                  <td data-label="Mentor 1">
                    <select class="mentor-select-1" data-original-val={t.mentor_id || ""}>
                      <option value="">Sin mentor</option>
                      {mentors.map((m) => (
                        <option value={m.id} selected={t.mentor_id === m.id}>
                          {m.first_name || m.full_name} ({m.disciplinary_profile === "tecnico" ? "Técnico" : m.disciplinary_profile === "docente" ? "Docente" : "Otro"})
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="Mentor 2">
                    <select class="mentor-select-2" data-original-val={t.mentor_id_2 || ""}>
                      <option value="">Sin mentor</option>
                      {mentors.map((m) => (
                        <option value={m.id} selected={t.mentor_id_2 === m.id}>
                          {m.first_name || m.full_name} ({m.disciplinary_profile === "tecnico" ? "Técnico" : m.disciplinary_profile === "docente" ? "Docente" : "Otro"})
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="Miembros">
                    <div class="team-members-list">
                      {t.profiles && t.profiles.length > 0 ? (
                        t.profiles.map((p) => (
                          <div class="team-member-item">
                            <span>{p.first_name || p.full_name}</span>
                            <span class={`badge-profile badge-profile-${p.disciplinary_profile}`}>
                              {p.disciplinary_profile === 'tecnico' ? 'Técnico' : p.disciplinary_profile === 'docente' ? 'Docente' : 'Otro'}
                            </span>
                          </div>
                        ))
                      ) : (
                        <span class="empty-members">Sin miembros</span>
                      )}
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

	<div class="admin-actions" style="justify-content: space-between;">
		<h2 style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem;">Resumen de Mentoría</h2>
		<button id="refresh-mentor-stats" class="btn btn-outline" style="display: flex; align-items: center; gap: 0.5rem;">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
			Actualizar Datos
		</button>
	</div>

	<div class="admin-card card">
	<div class="table-responsive">
		<table class="admin-table">
		<thead>
			<tr>
			<th>Mentor</th>
			<th>Especialidad</th>
			<th>DNI / Institución</th>
			<th>Contacto</th>
			<th>Equipos Asignados</th>
			</tr>
		</thead>
		<tbody>
			{
			mentorsWithTeams.length === 0 ? (
				<tr><td colspan="5" class="empty-state">No hay mentores registrados o aprobados aún.</td></tr>
			) : (
				mentorsWithTeams.map((m: any) => (
				<tr>
					<td data-label="Mentor"><strong>{m.full_name || (m.first_name + " " + m.last_name)}</strong></td>
					<td data-label="Especialidad">
            <span class={`badge-profile badge-profile-${m.disciplinary_profile || 'otro'}`}>
              {m.disciplinary_profile === 'tecnico' ? 'Técnico' : m.disciplinary_profile === 'docente' ? 'Docente' : 'Otro'}
            </span>
          </td>
					<td data-label="DNI / Institución">
            <span style="font-size: 0.85rem; color: var(--txt-2); display: block;">DNI: {m.dni || 'Sin DNI'}</span>
            <span style="font-size: 0.8rem; color: var(--txt-m);">{m.institution || 'Sin Institución'}</span>
          </td>
					<td data-label="Contacto">
            <a href={`mailto:${m.email}`} class="support-email" style="font-size: 0.9rem;">{m.email}</a>
          </td>
					<td data-label="Equipos Asignados">
            <div style="display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem;">
              {m.slot1Teams.length > 0 && (
                <div>
                  <strong style="color: var(--c1); font-size: 0.75rem; text-transform: uppercase;">Slot 1 (Técnico):</strong>
                  <span style="color: var(--txt-1); margin-left: 0.25rem;">{m.slot1Teams.join(', ')}</span>
                </div>
              )}
              {m.slot2Teams.length > 0 && (
                <div>
                  <strong style="color: var(--c2); font-size: 0.75rem; text-transform: uppercase;">Slot 2 (Pedagógico):</strong>
                  <span style="color: var(--txt-1); margin-left: 0.25rem;">{m.slot2Teams.join(', ')}</span>
                </div>
              )}
              {m.totalTeamsCount === 0 && (
                <span class="text-muted" style="font-style: italic;">Sin equipos asignados</span>
              )}
            </div>
          </td>
				</tr>
				))
			)
			}
		</tbody>
		</table>
	</div>
	</div>
  </div>
  <!-- End tab-mentoria -->

  <div class="tab-content" id="tab-resultados">
    <div class="admin-actions" style="justify-content: space-between;">
      <h2
        style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem; display: flex; align-items: center; gap: 0.5rem;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy" style="color: var(--c1);"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
        Ranking de Proyectos
      </h2>
      <button class="btn btn-outline" onclick="window.location.reload();" style="display: flex; align-items: center; gap: 0.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
        Actualizar Ranking
      </button>
    </div>

    <div class="admin-card card">
      <div class="table-responsive">
        <table class="admin-table leaderboard-table">
          <thead>
            <tr>
              <th style="width: 60px;">Posición</th>
              <th>Proyecto</th>
              <th>Equipo</th>
              <th>Evaluaciones</th>
              <th class="desktop-only">Desglose (Inn / Via / UX / Pit)</th>
              <th>Puntaje Final</th>
            </tr>
          </thead>
          <tbody>
            {
              leaderboard.length === 0 ? (
                <tr>
                  <td colspan="6" class="empty-state">
                    Aún no hay proyectos evaluados.
                  </td>
                </tr>
              ) : (
                leaderboard.map((row, index) => {
                  const pos = index + 1;
                  let rowClass = "user-row";
                  let rankBadge = pos.toString();

                  if (pos === 1) {
                    rowClass += " podium-1";
                  } else if (pos === 2) {
                    rowClass += " podium-2";
                  } else if (pos === 3) {
                    rowClass += " podium-3";
                  }

                  return (
                    <tr class={rowClass}>
                      <td data-label="Posición">
                        <span class={`rank-badge rank-${pos}`}>
                          {pos === 1 && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="margin-right: 2px;"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
                          )}
                          {pos}
                        </span>
                      </td>
                      <td data-label="Proyecto">
                        <strong>{row.title}</strong>
                      </td>
                      <td data-label="Equipo">
                        <span style="color: var(--c1); font-weight: 500;">
                          {row.team_name}
                        </span>
                      </td>
                      <td data-label="Evaluaciones">{row.evaluations_count}</td>
                      <td data-label="Desglose" class="desktop-only">
                        <div style="font-size: 0.85rem; color: var(--txt-2);">
                          {Number(row.avg_innovation).toFixed(1)} /
                          {Number(row.avg_viability).toFixed(1)} /
                          {Number(row.avg_ux).toFixed(1)} /
                          {Number(row.avg_pitch).toFixed(1)}
                        </div>
                      </td>
                      <td data-label="Puntaje Final">
                        <strong style="font-size: 1.2rem; color: var(--txt-1);">
                          {Number(row.final_score).toFixed(2)}
                        </strong>
                      </td>
                    </tr>
                  );
                })
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

    </div>

    <!-- Dialog de Guía de Ayuda -->
    <dialog id="help-dialog" class="admin-dialog">
      <div class="dialog-content">
        <div class="dialog-header">
          <h2>💡 Guía Rápida de Administración</h2>
          <button id="close-dialog-btn" class="icon-btn" aria-label="Cerrar guía">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <div class="dialog-body">
          <div class="help-section">
            <h3>👥 Gestión de Usuarios y Roles</h3>
            <p>
              Todos los participantes (rol <strong>Usuario</strong>) se auto-aprueban automáticamente al registrarse. 
              En cambio, los roles especiales como <strong>Mentor</strong> y <strong>Juez</strong> requieren aprobación manual del administrador (estado <em>Pendiente</em>) para poder acceder al sistema.
            </p>
            <p>
              Podés usar la barra de búsqueda superior para filtrar por nombre o DNI. Para asignar o modificar un rol o estado de inscripción, simplemente usá los desplegables de la tabla. Los cambios se guardan al instante.
            </p>
          </div>

          <div class="help-section">
            <h3>⚙️ Configuración del Evento</h3>
            <p>
              Los límites para <strong>egresados, técnicos y docentes</strong> controlan en tiempo real quiénes y cuántos perfiles pueden unirse a cada equipo. Si un equipo excede el límite de un rol específico, el sistema bloqueará nuevas incorporaciones con dicho perfil.
            </p>
            <p>
              Los toggles te permiten habilitar o deshabilitar dinámicamente fases clave como la creación de equipos, la entrega de proyectos en el Día D, el sistema de evaluación de jurados y los tickets SOS de ayuda en tiempo real.
            </p>
          </div>

          <div class="help-section">
            <h3>🤝 Sistema de Mentoría (Doble Mentoring)</h3>
            <p>
              Cada equipo cuenta con dos espacios (Slot 1 y Slot 2) para mentores. Recomendamos asignar un <strong>Mentor Técnico (Slot 1)</strong> (perfil especialista en programación o infraestructura) y un <strong>Mentor Pedagógico (Slot 2)</strong> (perfil enfocado en metodología, diseño y comunicación).
            </p>
            <p>
              Al realizar las asignaciones manuales en los selectores desplegables, tené en cuenta que <strong>debés presionar el botón "Guardar Asignaciones"</strong> para que se apliquen en la base de datos.
            </p>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Toast Notification -->
    <div id="toast" class="toast">
      <span id="toast-msg">Cambios guardados</span>
    </div>
  </main>
</Layout>

