  <div class="tab-content" id="tab-resultados">
    <div class="admin-actions" style="justify-content: space-between;">
      <h2
        style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem; display: flex; align-items: center; gap: 0.5rem;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy" style="color: var(--c1);"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
        Ranking de Proyectos
      </h2>
      <button class="btn btn-outline" onclick="window.location.reload();" style="display: flex; align-items: center; gap: 0.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
        Actualizar Ranking
      </button>
    </div>

    <p style="margin: 0 0 1.5rem; font-size: 0.9rem; color: var(--txt-2); line-height: 1.6;">
      Cada criterio se puntúa de 1 a 5. El <strong>resultado oficial del concurso es el puntaje
      ponderado</strong>: aplica el peso de cada criterio y lo normaliza a 100. El ranking
      se ordena por ese puntaje. La <strong>suma directa</strong> —los criterios sumados sin
      pesos— se sigue mostrando solo como referencia y no define posiciones.
      <br />
      <strong>La rúbrica cambia según la fase.</strong> En preclasificación no se puntúa
      «Comunicación y pitch», porque no hay presentación en vivo, y su peso se reparte entre
      los otros cinco: {preCriteria.map((c) => `${c.short} ${Math.round(c.weight * 100)}%`).join(" · ")}.
      En la final entran los {finalCriteria.length} criterios:
      {finalCriteria.map((c) => `${c.short} ${Math.round(c.weight * 100)}%`).join(" · ")}.
      Ambas fases normalizan a 100, así que los puntajes son comparables.
    </p>

    <!-- Fase 1: Preclasificación -->
    <div class="admin-card card" style="margin-bottom: 2rem;">
      <div class="admin-card-header">
        <h3>Fase 1: Preclasificación</h3>
        <div class="admin-card-header-actions">
          <button id="autoselect-finalists-btn" class="btn btn-outline">
            Marcar Top {finalistsCount}
          </button>
          <button id="save-finalists-btn" class="btn btn-primary">
            Guardar Finalistas
          </button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="admin-table leaderboard-table">
          <thead>
            <tr>
              <th style="width: 60px;">Posición</th>
              <th>Proyecto</th>
              <th>Equipo</th>
              <th>Evaluaciones</th>
              <th class="desktop-only">Desglose ({preCriteria.map((c) => c.short).join(" / ")})</th>
              <th>Suma directa <span class="th-note">(referencia)</span></th>
              <th>Puntaje Ponderado <span class="th-note">(oficial)</span></th>
              <th>Finalista</th>
            </tr>
          </thead>
          <tbody>
            {
              leaderboardPre.length === 0 ? (
                <tr>
                  <td colspan="8" class="empty-state">
                    Aún no hay proyectos para evaluar.
                  </td>
                </tr>
              ) : (
                leaderboardPre.map((row, index) => {
                  const pos = index + 1;
                  let rowClass = "user-row";

                  if (pos === 1) {
                    rowClass += " podium-1";
                  } else if (pos === 2) {
                    rowClass += " podium-2";
                  } else if (pos === 3) {
                    rowClass += " podium-3";
                  }

                  return (
                    <tr class={rowClass}>
                      <td data-label="Posición">
                        <span class={`rank-badge rank-${pos}`}>
                          {pos === 1 && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="margin-right: 2px;"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
                          )}
                          {pos}
                        </span>
                      </td>
                      <td data-label="Proyecto">
                        <strong>{row.title}</strong>
                      </td>
                      <td data-label="Equipo">
                        <span style="color: var(--c1); font-weight: 500;">
                          {row.team_name}
                        </span>
                      </td>
                      <td data-label="Evaluaciones">{row.evaluations_count}</td>
                      <td data-label="Desglose" class="desktop-only">
                        <div style="font-size: 0.85rem; color: var(--txt-2);">
                          {preCriteria.map((c) => Number(row[`avg_${c.key}`]).toFixed(1)).join(" / ")}
                        </div>
                      </td>
                      <td data-label="Suma directa">
                        <span style="color: var(--txt-2);">
                          {Number(row.raw_score).toFixed(1)}/{preMaxRaw}
                        </span>
                      </td>
                      <td data-label="Puntaje Ponderado">
                        <strong style="font-size: 1.2rem; color: var(--txt-1);">
                          {Number(row.final_score).toFixed(2)}
                        </strong>
                      </td>
                      <td data-label="Finalista">
                        <input
                          type="checkbox"
                          class="finalist-checkbox"
                          data-project-id={row.project_id}
                          checked={row.is_finalist}
                          style="width: 18px; height: 18px; accent-color: var(--c1); cursor: pointer;"
                        />
                      </td>
                    </tr>
