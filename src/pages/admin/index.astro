              {m.disciplinary_profile === 'tecnico' ? 'Técnico' : m.disciplinary_profile === 'docente' ? 'Docente' : 'Otro'}
            </span>
          </td>
					<td data-label="DNI / Institución">
            <span style="font-size: 0.85rem; color: var(--txt-2); display: block;">DNI: {m.dni || 'Sin DNI'}</span>
            <span style="font-size: 0.8rem; color: var(--txt-m);">{m.institution || 'Sin Institución'}</span>
          </td>
					<td data-label="Contacto">
            <a href={`mailto:${m.email}`} class="support-email" style="font-size: 0.9rem;">{m.email}</a>
          </td>
					<td data-label="Equipos Asignados">
            <div style="display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem;">
              {m.slot1Teams.length > 0 && (
                <div>
                  <strong style="color: var(--c1); font-size: 0.75rem; text-transform: uppercase;">Slot 1 (Técnico):</strong>
                  <span style="color: var(--txt-1); margin-left: 0.25rem;">{m.slot1Teams.join(', ')}</span>
                </div>
              )}
              {m.slot2Teams.length > 0 && (
                <div>
                  <strong style="color: var(--c2); font-size: 0.75rem; text-transform: uppercase;">Slot 2 (Pedagógico):</strong>
                  <span style="color: var(--txt-1); margin-left: 0.25rem;">{m.slot2Teams.join(', ')}</span>
                </div>
              )}
              {m.totalTeamsCount === 0 && (
                <span class="text-muted" style="font-style: italic;">Sin equipos asignados</span>
              )}
            </div>
          </td>
				</tr>
				))
			)
			}
		</tbody>
		</table>
	</div>
	</div>
  </div>
  <!-- End tab-mentoria -->

  <div class="tab-content" id="tab-jurado">
    <div class="admin-actions">
      <h2 style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem;">Grupos de Jurado</h2>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button id="judge-groups-distribute" class="btn btn-outline">
          Repartir proyectos sin asignar
        </button>
        <button id="judge-groups-redistribute" class="btn btn-outline">
          Rebarajar todo
        </button>
      </div>
    </div>

    <div class="config-grid" style="margin-bottom: 2rem;">
      <div class="config-card card">
        <div class="config-info">
          <h3>Dividir la preclasificación</h3>
          <p>
            Con esto encendido, cada juez ve y puntúa solo los proyectos de su
            grupo durante la preclasificación. La ronda final no se divide nunca:
            los finalistas presentan en vivo y los evalúa todo el jurado.
          </p>
        </div>
        <div class="config-action">
          <label class="toggle-switch">
            <input
              type="checkbox"
              id="judge-groups-toggle"
              checked={judgeGroupsEnabled}
            />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="config-card card">
        <div class="config-info">
          <h3>Estado del reparto</h3>
          {judgeGroupCount === 0 ? (
            <p>
              No hay grupos armados. Todo el jurado evalúa los {projects.length} proyectos.
            </p>
          ) : (
            <p>
              {judgeGroupCount} grupos armados sobre {judges.length} jueces y {projects.length} proyectos.
            </p>
          )}
          {projectsWithoutGroup > 0 && judgeGroupCount > 0 && (
            <p style="margin-top: 0.5rem;">
              {projectsWithoutGroup} proyecto{projectsWithoutGroup === 1 ? "" : "s"} sin
              grupo: {projectsWithoutGroup === 1 ? "lo evalúa" : "los evalúa"} todo el jurado.
            </p>
          )}
          {judgeGroupCount > 0 && judgesWithoutGroup.length > 0 && (
            <p style="margin-top: 0.5rem;">
              {judgesWithoutGroup.map((j) => j.first_name || j.full_name).join(", ")}
              {judgesWithoutGroup.length === 1 ? " no tiene grupo" : " no tienen grupo"} y
              {judgesWithoutGroup.length === 1 ? " evalúa" : " evalúan"} todos los proyectos.
            </p>
          )}
          {judgesPending.length > 0 && (
            <p style="color: var(--danger); font-weight: 600; margin-top: 0.5rem;">
              ⚠️ {judgesPending.length} {judgesPending.length === 1 ? "juez no está aprobado y no va a poder votar" : "jueces no están aprobados y no van a poder votar"}.
            </p>
          )}
        </div>
      </div>
    </div>

    {judgeGroupCount > 0 && (
      <div class="config-grid" style="margin-bottom: 2rem;">
        {judgeGroupSummary.map((g) => (
          <div class="config-card card">
            <div class="config-info">
              <h3>Grupo {g.n}</h3>
              <p>
                {g.judges.length === 0
                  ? "Sin jueces: sus proyectos quedarían sin evaluar."
                  : g.judges.map((j) => j.first_name || j.full_name).join(", ")}
              </p>
              <p style="margin-top: 0.5rem;">
                {g.projectsCount} proyecto{g.projectsCount === 1 ? "" : "s"} asignado{g.projectsCount === 1 ? "" : "s"}.
              </p>
              {g.judges.length === 1 && (
                <p style="color: var(--danger); font-weight: 600; margin-top: 0.5rem;">
                  ⚠️ Un solo juez decide estos proyectos.
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="admin-card card" style="margin-bottom: 2.5rem;">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Juez</th>
              <th>Institución</th>
              <th>Estado</th>
              <th>Grupo</th>
            </tr>
          </thead>
          <tbody>
            {judges.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-state">No hay jueces cargados.</td>
              </tr>
            ) : (
              judges.map((j) => (
                <tr data-judge-id={j.id}>
                  <td data-label="Juez">
                    <strong>{j.first_name || j.full_name}</strong> {j.last_name}
                  </td>
                  <td data-label="Institución">{institutionLabel(j)}</td>
                  <td data-label="Estado">
                    {j.registration_status === "aprobado" ? (
                      "Aprobado"
                    ) : (
                      <span style="color: var(--danger); font-weight: 600;">Sin aprobar</span>
                    )}
                  </td>
                  <td data-label="Grupo">
                    <select class="judge-group-select" data-original-val={j.judge_group || ""}>
                      <option value="">Evalúa todo</option>
                      <option value="1" selected={j.judge_group === 1}>Grupo 1</option>
                      <option value="2" selected={j.judge_group === 2}>Grupo 2</option>
                      <option value="3" selected={j.judge_group === 3}>Grupo 3</option>
                      <option value="4" selected={j.judge_group === 4}>Grupo 4</option>
                    </select>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <div class="admin-card card">
      <div class="config-info" style="padding: 1.5rem;">
        <h3>Cómo se usa</h3>
        <p>
          Primero armá los grupos eligiendo a qué grupo va cada juez: para dos
          tríos usá los grupos 1 y 2, para tres duetos los grupos 1, 2 y 3.
          Después repartí los proyectos y recién ahí encendé la división.
        </p>
        <p style="margin-top: 0.75rem;">
          <strong>Repartir proyectos sin asignar</strong> es lo que se usa durante
          la jornada: toca solo las entregas nuevas y no le cambia los proyectos a
          un juez que ya venía evaluando. <strong>Rebarajar todo</strong> vuelve a
          sortear los {projects.length} proyectos desde cero.
        </p>
        <p style="margin-top: 0.75rem;">
          Si algo sale mal el día del evento, apagá la división: todo el jurado
          vuelve a ver todos los proyectos al instante, sin perder ninguna
          evaluación ya cargada.
        </p>
      </div>
    </div>
  </div>
  <!-- End tab-jurado -->

  <div class="tab-content" id="tab-resultados">
    <div class="admin-actions" style="justify-content: space-between;">
      <h2
        style="font-family: var(--font-heading); color: var(--txt-1); margin: 0; font-size: 1.5rem; display: flex; align-items: center; gap: 0.5rem;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy" style="color: var(--c1);"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
        Ranking de Proyectos
      </h2>
      <button class="btn btn-outline" onclick="window.location.reload();" style="display: flex; align-items: center; gap: 0.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
        Actualizar Ranking
      </button>
    </div>

    <p style="margin: 0 0 1.5rem; font-size: 0.9rem; color: var(--txt-2); line-height: 1.6;">
      Cada criterio se puntúa de 1 a 5. El <strong>resultado oficial del concurso es el puntaje
      ponderado</strong>: aplica el peso de cada criterio y lo normaliza a 100. El ranking
      se ordena por ese puntaje. La <strong>suma directa</strong> —los criterios sumados sin
      pesos— se sigue mostrando solo como referencia y no define posiciones.
      <br />
      <strong>La rúbrica cambia según la fase.</strong> En preclasificación no se puntúa
      «Comunicación y pitch», porque no hay presentación en vivo, y su peso se reparte entre
      los otros cinco: {preCriteria.map((c) => `${c.short} ${Math.round(c.weight * 100)}%`).join(" · ")}.
      En la final entran los {finalCriteria.length} criterios:
      {finalCriteria.map((c) => `${c.short} ${Math.round(c.weight * 100)}%`).join(" · ")}.
      Ambas fases normalizan a 100, así que los puntajes son comparables.
    </p>

    <!-- Fase 1: Preclasificación -->
    <div class="admin-card card" style="margin-bottom: 2rem;">
      <div class="admin-card-header">
        <h3>Fase 1: Preclasificación</h3>
        <div class="admin-card-header-actions">
          <button id="autoselect-finalists-btn" class="btn btn-outline">
            Marcar Top {finalistsCount}
          </button>
          {
            mostrarColumnaGrupo && (
              <button id="autoselect-by-group-btn" class="btn btn-outline">
                Marcar Top {finalistsCount} por grupo
              </button>
            )
          }
          <button id="save-finalists-btn" class="btn btn-primary">
            Guardar Finalistas
          </button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="admin-table leaderboard-table">
          <thead>
            <tr>
              <th style="width: 60px;">Posición</th>
              <th>Proyecto</th>
              <th>Equipo</th>
              {mostrarColumnaGrupo && <th>Grupo <span class="th-note">(pos. interna)</span></th>}
              <th>Evaluaciones</th>
              <th class="desktop-only">Desglose ({preCriteria.map((c) => c.short).join(" / ")})</th>
              <th>Suma directa <span class="th-note">(referencia)</span></th>
              <th>Puntaje Ponderado <span class="th-note">(oficial)</span></th>
              <th>Finalista</th>
            </tr>
          </thead>
          <tbody>
            {
              leaderboardPre.length === 0 ? (
                <tr>
                  <td colspan={preTableCols} class="empty-state">
                    Aún no hay proyectos para evaluar.
                  </td>
                </tr>
              ) : (
                leaderboardPre.map((row, index) => {
                  const pos = index + 1;
                  let rowClass = "user-row";

                  if (pos === 1) {
                    rowClass += " podium-1";
                  } else if (pos === 2) {
                    rowClass += " podium-2";
                  } else if (pos === 3) {
                    rowClass += " podium-3";
                  }

                  return (
                    <tr class={rowClass}>
                      <td data-label="Posición">
                        <span class={`rank-badge rank-${pos}`}>
                          {pos === 1 && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="margin-right: 2px;"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
                          )}
                          {pos}
                        </span>
                      </td>
                      <td data-label="Proyecto">
                        <strong>{row.title}</strong>
                      </td>
                      <td data-label="Equipo">
                        <span style="color: var(--c1); font-weight: 500;">
                          {row.team_name}
                        </span>
                      </td>
                      {mostrarColumnaGrupo && (
                        <td data-label="Grupo">
                          {(() => {
                            const sr = preSubrank.get(row.project_id);
                            if (!sr) return <span style="color: var(--txt-m);">—</span>;
                            return (
                              <span style="font-size: 0.85rem; color: var(--txt-2); white-space: nowrap;">
                                <strong style="color: var(--txt-1);">
                                  {sr.grupo === null ? "Todos" : `G${sr.grupo}`}
                                </strong>
                                {" · "}
                                {sr.posGrupo}º
                              </span>
                            );
                          })()}
                        </td>
                      )}
                      <td data-label="Evaluaciones">{row.evaluations_count}</td>
                      <td data-label="Desglose" class="desktop-only">
                        <div style="font-size: 0.85rem; color: var(--txt-2);">
                          {preCriteria.map((c) => Number(row[`avg_${c.key}`]).toFixed(1)).join(" / ")}
                        </div>
                      </td>
                      <td data-label="Suma directa">
                        <span style="color: var(--txt-2);">
                          {Number(row.raw_score).toFixed(1)}/{preMaxRaw}
                        </span>
                      </td>
                      <td data-label="Puntaje Ponderado">
                        <strong style="font-size: 1.2rem; color: var(--txt-1);">
                          {Number(row.final_score).toFixed(2)}
                        </strong>
                      </td>
                      <td data-label="Finalista">
                        <input
                          type="checkbox"
                          class="finalist-checkbox"
                          data-project-id={row.project_id}
                          data-judge-group={
                            preSubrank.get(row.project_id)?.grupo === null || preSubrank.get(row.project_id) === undefined
                              ? "todos"
                              : String(preSubrank.get(row.project_id)!.grupo)
                          }
                          data-evaluations={row.evaluations_count}
                          checked={row.is_finalist}
                          style="width: 18px; height: 18px; accent-color: var(--c1); cursor: pointer;"
                        />
                      </td>
                    </tr>
                  );
                })
              )
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Fase 2: Ronda Final -->
    <div class="admin-card card">
      <div class="admin-card-header">
        <h3>Fase 2: Ronda Final</h3>
      </div>
      <div class="table-responsive">
        <table class="admin-table leaderboard-table">
          <thead>
            <tr>
              <th style="width: 60px;">Posición</th>
              <th>Proyecto</th>
              <th>Equipo</th>
              <th>Evaluaciones</th>
              <th class="desktop-only">Desglose ({finalCriteria.map((c) => c.short).join(" / ")})</th>
              <th>Suma directa <span class="th-note">(referencia)</span></th>
              <th>Puntaje Ponderado <span class="th-note">(oficial)</span></th>
            </tr>
          </thead>
          <tbody>
            {
              leaderboardFinal.length === 0 ? (
                <tr>
                  <td colspan="7" class="empty-state">
                    Aún no hay finalistas seleccionados. Marcalos y guardalos en la tabla de preclasificación.
                  </td>
                </tr>
              ) : (
                leaderboardFinal.map((row, index) => {
                  const pos = index + 1;
                  let rowClass = "user-row";

                  if (pos === 1) {
                    rowClass += " podium-1";
                  } else if (pos === 2) {
                    rowClass += " podium-2";
                  } else if (pos === 3) {
                    rowClass += " podium-3";
                  }

                  return (
                    <tr class={rowClass}>
                      <td data-label="Posición">
                        <span class={`rank-badge rank-${pos}`}>
                          {pos === 1 && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="margin-right: 2px;"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
                          )}
                          {pos}
                        </span>
                      </td>
                      <td data-label="Proyecto">
                        <strong>{row.title}</strong>
                      </td>
                      <td data-label="Equipo">
                        <span style="color: var(--c1); font-weight: 500;">
                          {row.team_name}
                        </span>
                      </td>
                      <td data-label="Evaluaciones">{row.evaluations_count}</td>
                      <td data-label="Desglose" class="desktop-only">
                        <div style="font-size: 0.85rem; color: var(--txt-2);">
                          {finalCriteria.map((c) => Number(row[`avg_${c.key}`]).toFixed(1)).join(" / ")}
                        </div>
                      </td>
                      <td data-label="Suma directa">
                        <span style="color: var(--txt-2);">
                          {Number(row.raw_score).toFixed(1)}/{finalMaxRaw}
                        </span>
                      </td>
                      <td data-label="Puntaje Ponderado">
                        <strong style="font-size: 1.2rem; color: var(--txt-1);">
                          {Number(row.final_score).toFixed(2)}
                        </strong>
                      </td>
                    </tr>
                  );
                })
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Tab Comunicados -->
  <div class="tab-content" id="tab-comunicados">
    <div class="bulletin-section">
      <div class="bulletin-card card">
