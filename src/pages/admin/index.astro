            <div class="preview-dot green"></div>
            <span class="preview-email-title-text">Nuevo Mensaje — Vista Previa</span>
          </div>
          <div class="preview-email-meta">
            <div><strong>De:</strong> Hackathon EduTech Mendoza &lt;hackathonedutech@gmail.com&gt;</div>
            <div><strong>Para:</strong> <span id="preview-fname">Participante</span> &lt;usuario@ejemplo.com&gt;</div>
