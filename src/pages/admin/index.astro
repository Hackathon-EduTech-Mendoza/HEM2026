---
// src/pages/admin/index.astro
import Layout from "../../layouts/Layout.astro";
import { createServerClient, parseCookieHeader } from "@supabase/ssr";
import { criteriaFor, maxRawScore } from "../../lib/rubric";

// La rúbrica depende de la fase: en preclasificación no se puntúa el pitch.
const preCriteria = criteriaFor("preclasificacion");
const finalCriteria = criteriaFor("final");
const preMaxRaw = maxRawScore("preclasificacion");
const finalMaxRaw = maxRawScore("final");
import { isProfileComplete } from "../../utils/perfil";

const user = Astro.locals.user;
const profile = Astro.locals.profile;

// Doble validación de seguridad (el middleware ya lo hace)
if (!user || (profile?.role !== "admin" && profile?.role !== "superadmin")) {
  return Astro.redirect("/dashboard");
}

// Crear cliente SSR para obtener datos con los permisos del usuario actual
const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        try {
          return parseCookieHeader(Astro.request.headers.get("Cookie") ?? "");
        } catch {
          return [];
        }
      },
      setAll() {}, // No necesitamos setear cookies aquí, solo leer
    },
  },
);

// Obtener todos los perfiles
const { data: allProfiles, error } = await supabase
  .from("profiles")
  .select(
    "id, full_name, first_name, last_name, email, dni, institution, institution_other, is_egresado, role, registration_status, created_at, disciplinary_profile",
  )
  .order("created_at", { ascending: false });

if (error) {
  console.error("Error fetching profiles:", error);
}

const profiles = allProfiles || [];

/** Inscriptos de verdad: los que completaron el formulario. */
const registeredProfiles = profiles.filter(isProfileComplete);
/** Cuentas creadas que nunca llenaron el formulario. No hay nada que aprobarles. */
const abandonedProfiles = profiles.filter((p) => !isProfileComplete(p));

// ──────────────────────────────────────────────────
// Consultas del formulario público (pestaña "Consultas")
// Las escribe /api/consulta con la service role key; acá se leen con los
// permisos del admin (policy "admins_read_consultas").
// ──────────────────────────────────────────────────
const { data: consultasData, error: consultasError } = await supabase
  .from("consultas")
  .select("id, nombre, email, mensaje, estado, created_at, responded_at")
  .order("created_at", { ascending: false });

if (consultasError) {
  console.error("Error fetching consultas:", consultasError);
}

const consultas = consultasData || [];
const consultasNuevas = consultas.filter((c) => c.estado === "nueva").length;

const fmtFechaHora = (iso: string) =>
  new Date(iso).toLocaleString("es-AR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });

// Conteos para el módulo de comunicados masivos
const approvedProfiles = profiles.filter(p => p.registration_status === 'aprobado');
const countAllApproved = approvedProfiles.length;
const countParticipantsApproved = approvedProfiles.filter(p => p.role === 'usuario').length;
const countMentorsApproved = approvedProfiles.filter(p => p.role === 'mentor').length;
const countJudgesApproved = approvedProfiles.filter(p => p.role === 'juez').length;

// ──────────────────────────────────────────────────
// Métricas de inscripción (pestaña "Métricas")
// Todo se calcula sobre `profiles`, que ya está en memoria.
// ──────────────────────────────────────────────────
const INSTITUTION_LABELS: Record<string, string> = {
  ies_9023_maipu: "IES 9-023 (Maipú)",
  ies_edison: "IES Tomás Alva Edison",
};

/** Etiqueta legible de la institución de un perfil */
function institutionLabel(p: { institution: string | null; institution_other: string | null }) {
  if (!p.institution) return "Sin especificar";
  if (p.institution === "otra") return p.institution_other?.trim() || "Otra institución";
  return INSTITUTION_LABELS[p.institution] || p.institution;
}

// ⚠️ Todos los conteos de acá para abajo van sobre `registeredProfiles`, NO sobre
// `profiles`: los registros abandonados se cuentan aparte, en `countAbandoned`.
// Mezclarlos era lo que hacía que "Pendientes de revisión" mostrara una cola de
// trabajo que en su mayoría no existía.
const totalRegistrations = registeredProfiles.length;
const countAbandoned = abandonedProfiles.length;

const byStatus = {
  pendiente: registeredProfiles.filter((p) => p.registration_status === "pendiente").length,
  aprobado: registeredProfiles.filter((p) => p.registration_status === "aprobado").length,
  rechazado: registeredProfiles.filter((p) => p.registration_status === "rechazado").length,
};

const byRole = {
  usuario: registeredProfiles.filter((p) => p.role === "usuario").length,
  mentor: registeredProfiles.filter((p) => p.role === "mentor").length,
  juez: registeredProfiles.filter((p) => p.role === "juez").length,
  staff: registeredProfiles.filter((p) => p.role === "admin" || p.role === "superadmin").length,
};

const countEgresados = registeredProfiles.filter((p) => p.is_egresado).length;

// Ranking de instituciones (las 3 fijas suelen ser pocas, pero "otra" es campo libre)
const institutionCounts = registeredProfiles.reduce<Record<string, number>>((acc, p) => {
  const label = institutionLabel(p);
  acc[label] = (acc[label] || 0) + 1;
  return acc;
}, {});
const institutionRanking = Object.entries(institutionCounts).sort((a, b) => b[1] - a[1]);

// Inscripciones por día de los últimos 14 días, para ver el ritmo de anotaciones.
// Se arma la grilla completa así los días sin inscriptos también se dibujan.
const DAYS_WINDOW = 14;
const today = new Date();
today.setHours(0, 0, 0, 0);

const dailyRegistrations = Array.from({ length: DAYS_WINDOW }, (_, i) => {
  const day = new Date(today);
  day.setDate(day.getDate() - (DAYS_WINDOW - 1 - i));
  const next = new Date(day);
  next.setDate(next.getDate() + 1);

  const count = registeredProfiles.filter((p) => {
    if (!p.created_at) return false;
    const created = new Date(p.created_at);
    return created >= day && created < next;
  }).length;

  return {
    date: day,
    label: day.toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit" }),
    count,
  };
});

const maxDaily = Math.max(1, ...dailyRegistrations.map((d) => d.count));
const countLast7Days = dailyRegistrations.slice(-7).reduce((sum, d) => sum + d.count, 0);
const countToday = dailyRegistrations[dailyRegistrations.length - 1].count;

// Última inscripción registrada (los perfiles vienen ordenados por created_at desc)
const lastRegistrationAt = registeredProfiles[0]?.created_at
  ? new Date(registeredProfiles[0].created_at).toLocaleString("es-AR", {
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    })
  : null;

/** Porcentaje sobre el total de inscriptos, listo para mostrar */
function pctOfTotal(n: number) {
  if (totalRegistrations === 0) return "0%";
  return `${Math.round((n / totalRegistrations) * 100)}%`;
}

// Obtener configuración del evento para teams, projects y evaluations
const { data: configData } = await supabase
  .from("event_config")
  .select("key, value")
  .in("key", [
    "teams_enabled",
    "project_submission_enabled",
    "evaluation_phase",
    "finalists_count",
    "help_enabled",
    "mentor_session_duration",
    "help_cooldown_minutes",
    "max_egresados_per_team",
    "max_tecnicos_per_team",
    "max_docentes_per_team",
    "min_team_size",
    "max_participants",
    "judge_groups_enabled",
    "survey_enabled",
  ]);

const teamsEnabled =
  configData?.find((c) => c.key === "teams_enabled")?.value === "true";
const projectsEnabled =
  configData?.find((c) => c.key === "project_submission_enabled")?.value ===
  "true";
const evaluationPhase =
  configData?.find((c) => c.key === "evaluation_phase")?.value || "cerrada";
const finalistsCount = parseInt(
  configData?.find((c) => c.key === "finalists_count")?.value || "10",
  10,
);
const helpEnabled =
  configData?.find((c) => c.key === "help_enabled")?.value === "true";
const mentorSessionDuration =
  configData?.find((c) => c.key === "mentor_session_duration")?.value || "15";
const helpCooldownMinutes =
	configData?.find((c) => c.key === "help_cooldown_minutes")?.value || "5";
const maxEgresadosPerTeam =
  configData?.find((c) => c.key === "max_egresados_per_team")?.value || "1";
const maxTecnicosPerTeam =
  configData?.find((c) => c.key === "max_tecnicos_per_team")?.value || "3";
const maxDocentesPerTeam =
  configData?.find((c) => c.key === "max_docentes_per_team")?.value || "3";
const minTeamSize =
  configData?.find((c) => c.key === "min_team_size")?.value || "5";
const maxParticipants =
  configData?.find((c) => c.key === "max_participants")?.value || "300";
const surveyEnabled =
  configData?.find((c) => c.key === "survey_enabled")?.value === "true";

// Resultados de la encuesta post evento. Una sola fila de agregados: la vista
// no expone ninguna respuesta individual atada a una persona, porque no existe
// esa relación. Con 0 respuestas devuelve total=0 y los promedios en NULL.
const { data: encuestaData, error: encuestaError } = await supabase
  .from("encuesta_resultados")
  .select("*")
  .maybeSingle();

// "0 respuestas" y "no se pudo leer la vista" se ven igual en pantalla. El día
// del evento eso es indiagnosticable, así que se distinguen explícitamente.
// El caso esperado hoy es que la migración todavía no esté aplicada en prod.
if (encuestaError) {
  console.error("[admin] No se pudo leer encuesta_resultados:", encuestaError.message);
}

// Los textos de la pregunta 4.
//
// ⚠️ EL .order("id") NO ES COSMÉTICO, SOSTIENE EL ANONIMATO. Sin ORDER BY,
// Postgres devuelve las filas en orden físico, que acá es el orden de
// inserción: el último comentario de la lista sería siempre el de la última
// persona que respondió, y un admin que refresca la pestaña mientras alguien
// contesta lo mapea con certeza. `id` es gen_random_uuid() v4, o sea aleatorio
// y sin relación con el momento de la respuesta: ordenar por él baraja.
const { data: encuestaComentarios } = await supabase
  .from("encuesta_respuestas")
  .select("p4_cambiaria")
  .not("p4_cambiaria", "is", null)
  .order("id", { ascending: true })
  .limit(500);

const encuestaSinDatos = !!encuestaError;

// Obtener datos del Leaderboard (una fila por proyecto y fase)
const { data: leaderboardData, error: leaderboardError } = await supabase
  .from("project_leaderboard")
  .select("*")
  .order("final_score", { ascending: false });

if (leaderboardError) {
  console.error("Error fetching leaderboard:", leaderboardError);
}

const leaderboardPre = (leaderboardData || []).filter(
  (row) => row.phase === "preclasificacion",
);
const leaderboardFinal = (leaderboardData || []).filter(
  (row) => row.phase === "final" && row.is_finalist,
);

// Obtener mentores aprobados con datos de contacto
const { data: allMentors } = await supabase
  .from("profiles")
  .select("id, full_name, first_name, last_name, email, dni, institution, disciplinary_profile")
  .eq("role", "mentor")
  .eq("registration_status", "aprobado")
  .order("full_name", { ascending: true });

const mentors = allMentors || [];
const mentorsCount = mentors.length;

// Obtener todos los equipos con sus mentores y miembros
const { data: allTeams, error: teamsError } = await supabase
  .from("teams")
  .select(`
    id,
    name,
    mentor_id,
    mentor_id_2,
    profiles:profiles!team_id (
      id,
      full_name,
      first_name,
      last_name,
      disciplinary_profile
    )
  `)
  .order("name", { ascending: true });

if (teamsError) {
  console.error("Error fetching teams in admin index:", teamsError);
}

const teams = allTeams || [];
const unassignedTeamsCount = teams.filter(t => !t.mentor_id && !t.mentor_id_2).length;

// Procesar mentores con sus equipos asignados directamente en memoria
const mentorsWithTeams = mentors.map(m => {
  const slot1Teams = teams.filter(t => t.mentor_id === m.id).map(t => t.name);
  const slot2Teams = teams.filter(t => t.mentor_id_2 === m.id).map(t => t.name);
  
  return {
    ...m,
    slot1Teams,
    slot2Teams,
    totalTeamsCount: slot1Teams.length + slot2Teams.length
  };
});

// Obtener proyectos con los nombres de sus equipos
const { data: allProjects, error: projectsError } = await supabase
  .from("projects")
  .select(`
    id,
    title,
    url_prototype,
    url_support_material,
    team_id,
    judge_group,
    teams (
      name
    )
  `)
  .order("title", { ascending: true });

if (projectsError) {
  console.error("Error fetching projects in admin index:", projectsError);
}

const projects = allProjects || [];

// ──────────────────────────────────────────────────
// Grupos de jurado (pestaña "Jurado")
// La división corre solo en preclasificación: en la final los 10 finalistas
// presentan en vivo ante los 6 jueces, así que ahí todos evalúan todo.
// ──────────────────────────────────────────────────
const { data: allJudges } = await supabase
  .from("profiles")
  .select("id, full_name, first_name, last_name, email, institution, registration_status, judge_group")
  .eq("role", "juez")
  .order("first_name", { ascending: true });

const judges = allJudges || [];
const judgesPending = judges.filter((j) => j.registration_status !== "aprobado");

const judgeGroupsEnabled =
  configData?.find((c) => c.key === "judge_groups_enabled")?.value === "true";

/**
 * Cuántos grupos hay armados. Sale de los jueces, no de un número guardado: el
 * grupo más alto que alguien tenga asignado es la cantidad de grupos que existe.
 * Así "2 tríos" y "3 duetos" son el mismo mecanismo y se pasa de uno a otro
 * reasignando personas, sin ninguna configuración aparte que pueda desfasarse.
 */
const judgeGroupCount = judges.reduce(
  (max, j) => Math.max(max, j.judge_group || 0),
  0,
);

/** Resumen por grupo, para ver de un vistazo si quedó algo desparejo. */
const judgeGroupSummary = Array.from({ length: judgeGroupCount }, (_, i) => {
  const n = i + 1;
  return {
    n,
    judges: judges.filter((j) => j.judge_group === n),
    projectsCount: projects.filter((p) => p.judge_group === n).length,
  };
});

/** Sin grupo: los evalúa todo el jurado. Es el estado por defecto y la salida de emergencia. */
const judgesWithoutGroup = judges.filter((j) => !j.judge_group);
const projectsWithoutGroup = projects.filter((p) => !p.judge_group).length;

// ──────────────────────────────────────────────────
// Subranking por grupo (ranking de preclasificación)
//
// Con el jurado dividido, cada grupo puntúa con su propia vara. Medido en dev
// con tres grupos calibrados distinto (duro / normal / generoso), el ranking
// global dejaba al grupo exigente con 1 finalista de 10: su mejor proyecto
// salía décimo con 64,6 y el peor del generoso salía cuarto con 89,5. El
// cálculo no está mal —todos promedian con avg() en la misma escala—, el
// problema es de equidad: un proyecto compite contra la severidad de su jurado
// y no solo contra los otros proyectos.
//
// La posición dentro del grupo sí es limpia: ahí todos fueron medidos con la
// misma vara. Por eso se muestra al lado de la global y por eso existe el
// reparto por grupo.
//
// ⚠️ Esto NO reordena la tabla ni toca el puntaje. El ranking se sigue
// ordenando por `final_score`, que es el resultado oficial. El subranking es
// información y un criterio de reparto; los finalistas se marcan igual, a mano
// o con los botones, y no se guarda nada hasta "Guardar Finalistas".
// ──────────────────────────────────────────────────

/** `judge_group` por proyecto. Sale de `projects`, que ya se trae más arriba:
 *  la vista `project_leaderboard` no expone la columna y no hace falta tocarla. */
const projectJudgeGroup = new Map<string, number | null>(
  projects.map((p) => [p.id as string, (p.judge_group as number | null) ?? null]),
);

/**
 * Posición dentro del grupo, contada sobre el mismo orden del ranking global
 * (las filas ya vienen ordenadas por `final_score`). `null` = sin grupo, que
 * significa "lo evaluó todo el jurado": son su propia bolsa, no un grupo más.
 */
const preSubrank = new Map<string, { grupo: number | null; posGrupo: number }>();
{
  const contador = new Map<string, number>();
  for (const row of leaderboardPre) {
    const grupo = projectJudgeGroup.get(row.project_id as string) ?? null;
    const clave = grupo === null ? "todos" : String(grupo);
    const posGrupo = (contador.get(clave) || 0) + 1;
    contador.set(clave, posGrupo);
    preSubrank.set(row.project_id as string, { grupo, posGrupo });
  }
}

/** La columna de grupo solo tiene sentido si hay grupos armados. */
const mostrarColumnaGrupo = judgeGroupCount > 0;
const preTableCols = mostrarColumnaGrupo ? 9 : 8;
---

<Layout title="Administración | HEM2026" noindex>
  <div class="admin-page">
    <div class="container admin-container">
      <div class="admin-header">
        <div>
          <h1>Centro de Comando</h1>
          <p class="admin-subtitle">Gestión de usuarios, roles e inscripciones</p>
        </div>
        <button id="help-guide-btn" class="btn btn-outline help-btn" aria-label="Ver guía rápida">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          Guía Rápida
        </button>
      </div>

      <div class="admin-tabs-nav">
        <button class="tab-btn active" data-target="tab-metricas">Métricas</button>
        <button class="tab-btn" data-target="tab-usuarios"
          >Usuarios</button
        >
        <button class="tab-btn" data-target="tab-configuracion"
          >Configuración</button
        >
        <button class="tab-btn" data-target="tab-mentoria">Mentoría</button>
        <button class="tab-btn" data-target="tab-jurado">Jurado</button>
        <button class="tab-btn" data-target="tab-resultados">Resultados</button>
        <button class="tab-btn" data-target="tab-comunicados">Comunicados</button>
        <button class="tab-btn" data-target="tab-encuesta">Encuesta</button>
        <button class="tab-btn" data-target="tab-presentaciones">Presentaciones</button>
        <button class="tab-btn" data-target="tab-consultas">
          Consultas
          {consultasNuevas > 0 && <span class="tab-badge">{consultasNuevas}</span>}
        </button>
      </div>

      <div class="tab-content active" id="tab-metricas">
        <div class="admin-actions">
          <h2 class="tab-title">Estadísticas de inscripción</h2>
          {lastRegistrationAt && (
            <p class="metrics-updated">Última inscripción: {lastRegistrationAt}</p>
          )}
        </div>

        <div class="metrics-kpis">
          <div class="metric-card card metric-card-hero">
            <span class="metric-label">Inscriptos totales</span>
            <strong class="metric-value">{totalRegistrations}</strong>
            <span class="metric-hint">
              {countToday > 0 ? `+${countToday} hoy` : "Sin inscripciones hoy"}
            </span>
          </div>
          <div class="metric-card card">
            <span class="metric-label">Aprobados</span>
            <strong class="metric-value">{byStatus.aprobado}</strong>
            <span class="metric-hint">{pctOfTotal(byStatus.aprobado)} del total</span>
          </div>
          <div class="metric-card card">
            <span class="metric-label">Pendientes de revisión</span>
            <strong class="metric-value" style={byStatus.pendiente > 0 ? "color: var(--danger);" : undefined}>
              {byStatus.pendiente}
            </strong>
            <span class="metric-hint">
              {byStatus.pendiente > 0 ? "Requieren tu aprobación" : "Todo al día"}
            </span>
          </div>
          <div class="metric-card card">
            <span class="metric-label">Registro incompleto</span>
            <strong class="metric-value">{countAbandoned}</strong>
            <span class="metric-hint">
              {countAbandoned > 0
                ? "Crearon la cuenta y no completaron el formulario"
                : "Nadie quedó a mitad de camino"}
            </span>
          </div>
          <div class="metric-card card">
            <span class="metric-label">Últimos 7 días</span>
            <strong class="metric-value">{countLast7Days}</strong>
            <span class="metric-hint">Nuevas inscripciones</span>
          </div>
        </div>

        {countAbandoned > 0 && (
          <p class="metrics-callout">
            <strong>{countAbandoned}</strong>{" "}
            {countAbandoned === 1
              ? "persona creó su cuenta y nunca completó el formulario de inscripción, así que no cuenta como inscripta ni aparece en los números de abajo. No hay nada que aprobarle: su ficha está vacía."
              : "personas crearon su cuenta y nunca completaron el formulario de inscripción, así que no cuentan como inscriptas ni aparecen en los números de abajo. No hay nada que aprobarles: sus fichas están vacías."}
            <button type="button" class="link-btn" data-goto-incompletos>
              Ver quiénes son
            </button>
          </p>
        )}

        <div class="admin-card card metrics-panel metrics-chart-card">
            <h3 class="metrics-card-title">Inscripciones por día</h3>
            {totalRegistrations === 0 ? (
              <p class="empty-state">Todavía no hay inscripciones registradas.</p>
            ) : (
              <div class="chart-bars" role="img" aria-label="Inscripciones diarias de los últimos 14 días">
                {dailyRegistrations.map((d) => (
                  <div class="chart-bar-col" title={`${d.label}: ${d.count} inscripciones`}>
                    <span class="chart-bar-count">{d.count > 0 ? d.count : ""}</span>
                    <div
                      class="chart-bar"
                      style={`height: ${Math.max(2, (d.count / maxDaily) * 100)}%`}
                      data-empty={d.count === 0 ? "true" : "false"}
                    ></div>
                    <span class="chart-bar-label">{d.label}</span>
                  </div>
                ))}
              </div>
            )}
        </div>

        <div class="metrics-grid">
          <div class="admin-card card metrics-panel">
            <h3 class="metrics-card-title">Por rol</h3>
            <ul class="metrics-list">
              <li>
                <span>Participantes</span>
                <strong>{byRole.usuario}</strong>
              </li>
              <li>
                <span>Mentores</span>
                <strong>{byRole.mentor}</strong>
              </li>
              <li>
                <span>Jueces</span>
                <strong>{byRole.juez}</strong>
              </li>
              <li>
                <span>Staff (admin)</span>
                <strong>{byRole.staff}</strong>
              </li>
            </ul>

            <h3 class="metrics-card-title" style="margin-top: 1.5rem;">Por estado</h3>
            <ul class="metrics-list">
              <li>
                <span>Aprobados</span>
                <strong>{byStatus.aprobado}</strong>
              </li>
              <li>
                <span>Pendientes</span>
                <strong>{byStatus.pendiente}</strong>
              </li>
              <li>
                <span>Rechazados</span>
                <strong>{byStatus.rechazado}</strong>
              </li>
              <li class="metrics-list-aside">
                <span>Registro incompleto <em>(no cuenta como inscripto)</em></span>
                <strong>{countAbandoned}</strong>
              </li>
            </ul>
          </div>

          <div class="admin-card card metrics-panel">
            <h3 class="metrics-card-title">Por institución</h3>
            {institutionRanking.length === 0 ? (
              <p class="empty-state">Sin datos de institución.</p>
