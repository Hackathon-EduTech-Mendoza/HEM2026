---
// src/pages/__test-alerts.astro
//
// Página de smoke test del wrapper de SweetAlert2.
// Sólo se renderiza en modo desarrollo. En producción responde 404.
//
// Para probarla: npm run dev → http://localhost:4321/__test-alerts
// Esta página se eliminará una vez aprobado el wrapper (Épica 1, Tarea 1.4).

import Layout from '../layouts/Layout.astro';

if (!import.meta.env.DEV) {
    return new Response('Not Found', { status: 404 });
}
---

<Layout title="Smoke Test · Alerts">
    <main class="container" style="padding: 6rem 1.5rem; max-width: 720px;">
        <h1>Smoke Test — Alerts Wrapper</h1>
        <p>Página efímera para verificar las 4 funciones del wrapper. Se elimina tras aprobación.</p>

        <div style="display: grid; gap: 0.75rem; margin-top: 2rem;">
            <button id="t-error" class="btn btn-primary">1 · showError()</button>
            <button id="t-success" class="btn btn-primary">2 · showSuccess()</button>
            <button id="t-confirm" class="btn btn-primary">3 · showConfirm()</button>
            <button id="t-toast" class="btn btn-primary">4 · showToast()</button>
        </div>

        <pre id="t-output" style="margin-top: 2rem; padding: 1rem; background: var(--bg-2); border-radius: 8px; min-height: 4rem; font-size: 0.85rem;"></pre>
    </main>

    <script>
        import { showError, showSuccess, showConfirm, showToast } from '../utils/alerts.js';

        const out = document.getElementById('t-output')!;
        const log = (msg: string) => {
            out.textContent = `[${new Date().toLocaleTimeString()}] ${msg}\n` + out.textContent;
        };

        document.getElementById('t-error')!.addEventListener('click', async () => {
            log('Invocando showError…');
            await showError('Las contraseñas no coinciden', 'Verificá ambos campos.');
            log('showError cerrado.');
        });

        document.getElementById('t-success')!.addEventListener('click', async () => {
            log('Invocando showSuccess…');
            await showSuccess('Enlace de recuperación enviado', 'Revisá tu bandeja de entrada.');
            log('showSuccess cerrado.');
        });

        document.getElementById('t-confirm')!.addEventListener('click', async () => {
            log('Invocando showConfirm (destructivo)…');
            const ok = await showConfirm({
                title: '¿Enviar comunicado a 150 personas?',
                text: 'Esta acción no se puede deshacer.',
                confirmText: 'Sí, enviar',
                cancelText: 'Cancelar',
                destructive: true,
                icon: 'warning',
            });
            log(`showConfirm → ${ok ? 'CONFIRMADO' : 'CANCELADO'}`);
        });

        document.getElementById('t-toast')!.addEventListener('click', () => {
            log('Lanzando showToast…');
            showToast('success', 'Operación completada', 2000);
        });
    </script>
</Layout>
