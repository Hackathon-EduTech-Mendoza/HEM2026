---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { createServerClient, parseCookieHeader } from '@supabase/ssr';
import { CRITERIA, SCALE, MAX_RAW_SCORE, rawScore, weightedScore } from '../lib/rubric';

const user = Astro.locals.user;
const profile = Astro.locals.profile;

// Doble validación de seguridad (el middleware ya protege, pero es buena práctica)
if (!user || (profile?.role !== 'juez' && profile?.role !== 'admin' && profile?.role !== 'superadmin')) {
  return Astro.redirect('/dashboard');
}

// Un juez sin inscripción aprobada no puede ver ni evaluar proyectos
const isApprovedJudge = profile.role !== 'juez' || profile.registration_status === 'aprobado';

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        try {
          return parseCookieHeader(Astro.request.headers.get('Cookie') ?? '');
        } catch {
          return [];
        }
      },
      setAll() {}
    }
  }
);

// Obtener la fase de evaluación activa: cerrada | preclasificacion | deliberacion | final
const { data: configData } = await supabase
  .from('event_config')
  .select('key, value')
  .in('key', ['evaluation_phase', 'finalists_count']);

const evaluationPhase = configData?.find(c => c.key === 'evaluation_phase')?.value || 'cerrada';
const finalistsCount = configData?.find(c => c.key === 'finalists_count')?.value || '10';
const isVotingOpen = evaluationPhase === 'preclasificacion' || evaluationPhase === 'final';
const phaseLabel = evaluationPhase === 'preclasificacion' ? 'Preclasificación' : 'Ronda Final';

// Obtener los proyectos a evaluar (en fase final, solo los finalistas)
let projectsQuery = supabase
  .from('projects')
  .select('*, teams(name)')
  .order('created_at', { ascending: true });

if (evaluationPhase === 'final') {
  projectsQuery = projectsQuery.eq('is_finalist', true);
}

const { data: projectsData, error: projectsError } = await projectsQuery;

// Obtener las evaluaciones hechas por ESTE juez en la fase activa
const { data: evaluationsData } = await supabase
  .from('evaluations')
  .select('*')
  .eq('judge_id', user.id)
  .eq('phase', evaluationPhase);

const projects = projectsData || [];
const evaluations = evaluationsData || [];

// Mapa de evaluaciones para saber si ya evaluó el proyecto
const evaluationsMap = evaluations.reduce((acc, ev) => {
  acc[ev.project_id] = ev;
  return acc;
}, {} as Record<string, any>);

// Separar proyectos evaluados de los pendientes (opcional, pero útil para UX)
const pendingProjects = projects.filter(p => !evaluationsMap[p.id]);
const completedProjects = projects.filter(p => evaluationsMap[p.id]);
---

<Layout title="Panel de Evaluación | HEM2026" noindex>
  <div class="eval-page">
    <div class="container eval-container">
      <div class="eval-header">
        <h1>Panel de Evaluación</h1>
        <p class="eval-subtitle">Bienvenido, {profile?.full_name || 'Juez'}.</p>
        {isVotingOpen && (
          <span class={`phase-badge ${evaluationPhase === 'final' ? 'phase-final' : 'phase-pre'}`}>
            Fase activa: {phaseLabel}
          </span>
        )}
      </div>

      {!isApprovedJudge ? (
        <div class="card warning-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--c1); margin-bottom: 1rem;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <h3>Tu solicitud está en revisión</h3>
          <p>El equipo organizador está revisando tu perfil como Juez. Vas a poder evaluar proyectos cuando tu registro sea aprobado.</p>
        </div>
      ) : !isVotingOpen && profile?.role === 'juez' ? (
        <div class="card warning-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--c1); margin-bottom: 1rem;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <h3>Evaluaciones Cerradas</h3>
          {evaluationPhase === 'deliberacion' ? (
            <p>La preclasificación finalizó. El jurado está deliberando la selección de finalistas; la votación final se habilitará pronto.</p>
          ) : (
            <p>El administrador aún no ha habilitado la etapa de evaluación.</p>
          )}
        </div>
      ) : (
        <>
        <details class="card instructivo" open={completedProjects.length === 0}>
          <summary>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>Instructivo para el jurado: cómo evaluar</span>
          </summary>

          <div class="instructivo-body">
            <section>
              <h3>1. Cuándo y cómo se evalúa</h3>
              <ul>
                <li><strong>Preclasificación:</strong> recorrés los stands de todos los equipos. Podés escuchar la explicación del proyecto, hacer preguntas, pedir aclaraciones y ver la demo o prototipo. Cargás la evaluación desde este panel, con el celular o la notebook, apenas terminás de visitar cada stand.</li>
                <li><strong>Deliberación:</strong> la votación se pausa. El jurado se reúne con la organización, revisa el orden de mérito y se confirman los {finalistsCount} equipos finalistas.</li>
                <li><strong>Ronda final:</strong> los finalistas presentan su pitch en el escenario y volvés a evaluarlos, esta vez solo a ellos, con los mismos criterios.</li>
              </ul>
              <p class="instructivo-note">Evaluá cada proyecto <strong>ni bien lo visitás</strong>, no al final de todo: la impresión fresca es más justa que la memoria. Podés recorrer en conjunto con el resto del jurado o a tu propio ritmo, pero cada proyecto debe recibir la totalidad de las evaluaciones previstas.</p>
            </section>

            <section>
              <h3>2. Los {CRITERIA.length} criterios y qué mirar en cada uno</h3>
              <p class="instructivo-note">Cada criterio se puntúa de <strong>1 a 5</strong>, donde 1 es insuficiente y 5 es excelente. No todos pesan igual: el peso indica cuánto influye ese criterio en el puntaje final.</p>
              <div class="criteria-guide">
                {CRITERIA.map(c => (
                  <div class="criteria-guide-item">
                    <div class="criteria-guide-head">
                      <h4>{c.label}</h4>
                      <span class="weight-pill">{Math.round(c.weight * 100)}%</span>
                    </div>
                    <p class="criteria-guide-q">{c.question}</p>
                    <ul>
                      {c.lookFor.map(item => <li>{item}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </section>

            <section>
              <h3>3. Qué significa cada puntaje</h3>
              <ul class="scale-guide">
                {SCALE.map(s => (
                  <li><strong>{s.value} — {s.label}:</strong> {s.hint}</li>
                ))}
              </ul>
            </section>

            <section>
              <h3>4. Criterios de justicia</h3>
              <ul>
                <li>Usá <strong>toda la escala</strong>. Si todos los proyectos reciben 4 y 5, el ranking no distingue nada.</li>
                <li>Evaluá lo que el equipo <strong>muestra y explica</strong>, no lo que suponés que quiso hacer.</li>
                <li>Recordá que son 3 días de trabajo: se valora el avance real logrado en la hackathon, no un producto terminado.</li>
                <li>Si conocés personalmente a un equipo o tenés relación con la institución, avisale a la organización antes de evaluarlo.</li>
                <li>El <strong>feedback</strong> es opcional pero muy valioso: es lo que se llevan los equipos que no ganan.</li>
              </ul>
            </section>
          </div>
        </details>

        {projects.length === 0 ? (
        <div class="card empty-state">
          <p>Aún no hay proyectos entregados para evaluar.</p>
        </div>
      ) : (
        <div class="eval-sections">
          
          <div class="eval-section">
            <h2 class="section-title">Pendientes de Evaluación <span class="badge badge-pending">{pendingProjects.length}</span></h2>
            <div class="projects-grid">
              {pendingProjects.map(project => (
                <div class="project-card card" data-project={JSON.stringify(project)}>
                  <div class="project-header">
                    <h3>{project.title}</h3>
                    <span class="team-name">Equipo: {project.teams?.name}</span>
                  </div>
                  <div class="project-body">
                    <p class="project-desc">{project.description_problem ? project.description_problem.substring(0, 100) + '...' : 'Sin descripción'}</p>
                  </div>
                  <div class="project-footer">
                    <button class="btn btn-primary evaluate-btn" data-id={project.id}>Evaluar Proyecto</button>
                  </div>
                </div>
              ))}
              {pendingProjects.length === 0 && <p class="text-muted">¡Excelente! Has evaluado todos los proyectos asignados.</p>}
            </div>
          </div>

          <div class="eval-section">
            <h2 class="section-title">Evaluados <span class="badge badge-completed">{completedProjects.length}</span></h2>
            <div class="projects-grid">
              {completedProjects.map(project => {
                const ev = evaluationsMap[project.id];
                const scores = Object.fromEntries(
                  CRITERIA.map(c => [c.key, ev[`score_${c.key}`]])
                );
                const totalScore = rawScore(scores);
                const weighted = weightedScore(scores);
                // El voto ya guardado viaja con la tarjeta para poder precargarlo
                // en el modal cuando el jurado quiere corregirlo.
                const votoGuardado = {
                  ...scores,
                  feedback: ev.feedback || '',
                  updated_at: ev.updated_at || ev.created_at,
                };
                return (
                  <div
                    class="project-card card completed"
                    data-project={JSON.stringify(project)}
                    data-evaluacion={JSON.stringify(votoGuardado)}
                  >
                    <div class="project-header">
                      <h3>{project.title}</h3>
                      <span class="team-name">Equipo: {project.teams?.name}</span>
                    </div>
                    <div class="project-footer score-footer">
                      <div class="score-display">
                        <span class="score-label">Tu puntuación:</span>
                        <span class="score-value">{totalScore}/{MAX_RAW_SCORE}</span>
                        <span class="score-weighted">({weighted.toFixed(1)} pts ponderados)</span>
                      </div>
                      <div class="score-actions">
                        <span class="badge badge-yes">Completado</span>
                        <button class="btn btn-outline btn-sm evaluate-btn" data-id={project.id}>
                          Corregir
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

        </div>
        )}
        </>
      )}
    </div>

    <!-- Modal de Evaluación -->
    <div id="eval-modal" class="modal-backdrop">
      <div class="modal-content">
        <div class="modal-header">
          <h2 id="modal-project-title">Título del Proyecto</h2>
          <button id="close-modal" class="icon-btn" aria-label="Cerrar modal">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <div class="modal-body">
          <!-- Solo visible cuando se está corrigiendo un voto ya guardado -->
          <div id="modal-editando" class="eval-editing-notice" hidden>
            <strong>Estás corrigiendo tu evaluación.</strong>
            <span id="modal-editando-fecha"></span>
            Al guardar se reemplazan los puntajes anteriores.
          </div>
          <div class="project-details">
            <h4>Problema</h4>
            <p id="modal-problem"></p>
            <h4>Solución</h4>
            <p id="modal-solution"></p>
            
            <div class="links-grid">
              <a href="#" id="modal-prototype" target="_blank" class="link-item" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                Ver Prototipo
              </a>
              <a href="#" id="modal-material" target="_blank" class="link-item" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Material de Apoyo
              </a>
            </div>
          </div>

          <form id="evaluation-form" class="evaluation-form">
            <input type="hidden" id="form-project-id" name="project_id" />
            <input type="hidden" id="form-judge-id" name="judge_id" value={user?.id || ''} />
            <input type="hidden" id="form-phase" name="phase" value={evaluationPhase} />

            <div class="rubric-grid">
              {CRITERIA.map(c => (
                <div class="rubric-item">
                  <div class="rubric-header">
                    <span class="rubric-legend" id={`label-${c.key}`}>{c.label}</span>
                    <span class="weight-pill" title="Peso de este criterio en el puntaje final">
                      {Math.round(c.weight * 100)}%
                    </span>
                  </div>
                  <p class="rubric-desc">{c.question}</p>
                  <div class="scale-group" role="radiogroup" aria-labelledby={`label-${c.key}`}>
                    {SCALE.map(s => (
                      <label class="scale-option" title={`${s.value} · ${s.label}: ${s.hint}`}>
                        <input
                          type="radio"
                          name={`score_${c.key}`}
                          value={s.value}
                          data-criterion={c.key}
                        />
                        <span class="scale-box">{s.value}</span>
                      </label>
                    ))}
                  </div>
                  <div class="scale-legend">
                    <span>1 · Insuficiente</span>
                    <span>5 · Excelente</span>
                  </div>
                </div>
              ))}
            </div>

            <div class="running-total" id="running-total" aria-live="polite">
              <div class="running-total-item">
                <span class="running-total-label">Suma directa</span>
                <span class="running-total-value"><span id="total-raw">—</span>/{MAX_RAW_SCORE}</span>
              </div>
              <div class="running-total-item">
                <span class="running-total-label">Puntaje ponderado</span>
                <span class="running-total-value"><span id="total-weighted">—</span>/100</span>
              </div>
              <p class="running-total-hint" id="total-hint">Faltan criterios por puntuar.</p>
            </div>

            <div class="form-group">
              <label for="feedback">Feedback Constructivo (Opcional)</label>
              <textarea id="feedback" name="feedback" rows="3" placeholder="Deja un comentario constructivo para el equipo..." class="feedback-textarea"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100" id="submit-eval-btn">Guardar Evaluación</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Toast -->
    <div id="toast" class="toast" role="status" aria-live="polite">
      <span id="toast-msg"></span>
    </div>

  </div>
</Layout>

<style>
  .eval-page {
    min-height: calc(100vh - var(--nav-h));
    padding: calc(var(--nav-h) + 2rem) 0 4rem;
    background: var(--bg-3);
  }

  .eval-container {
    max-width: 1200px;
  }

  .eval-header {
    margin-bottom: 2rem;
  }

  .eval-header h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--txt-1);
  }

  .eval-subtitle {
    color: var(--txt-2);
    font-size: 1.1rem;
  }

  .phase-badge {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .phase-pre { background: rgba(var(--c1r), 0.15); color: var(--c1); }
  .phase-final { background: rgba(var(--c2r), 0.15); color: var(--c2); }

  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    color: var(--txt-m);
    border: 1px dashed var(--brd);
  }

  .warning-card {
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(var(--c1r), 0.3);
    background: rgba(var(--c1r), 0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eval-sections {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    font-size: 1.5rem;
    color: var(--txt-1);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .badge-pending { background: rgba(var(--c1r), 0.15); color: var(--c1); }
  .badge-completed { background: rgba(var(--c2r), 0.15); color: var(--c2); }
  .badge-yes { background: rgba(var(--c2r), 0.15); color: var(--c2); padding: 0.25rem 0.75rem; font-size: 0.8rem; }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--t-fast);
    padding: 1.5rem;
  }
  .project-card:not(.completed):hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .project-header {
    margin-bottom: 1rem;
  }
  .project-header h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.25rem;
    color: var(--txt-1);
  }
  .team-name {
    font-size: 0.9rem;
    color: var(--c1);
    font-weight: 600;
  }

  .project-desc {
    color: var(--txt-2);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .project-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--brd-s);
  }
  .score-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* Badge "Completado" + botón "Corregir" */
  .score-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Aviso de que se está corrigiendo un voto ya guardado */
  .eval-editing-notice {
    background: rgba(var(--c1r), 0.08);
    border: 1px solid var(--c1);
    border-radius: var(--r-md);
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    color: var(--txt-1);
    line-height: 1.5;
  }
  .eval-editing-notice[hidden] {
    display: none;
  }
  .score-display {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .score-label { color: var(--txt-2); font-size: 0.9rem; }
  .score-value { font-weight: 700; font-size: 1.2rem; color: var(--txt-1); }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
    opacity: 0;
    transition: opacity var(--t-fast);
  }
  .modal-backdrop.show {
    display: flex;
    opacity: 1;
  }

  .modal-content {
    background: var(--bg-card);
    width: 100%;
    max-width: 800px;
    border-radius: var(--r-lg);
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    overflow: hidden;
  }

  @media (max-width: 576px) {
    .modal-backdrop {
      padding: 0.5rem;
    }
    .modal-content {
      max-height: 95vh;
      border-radius: var(--r-md);
    }
    .modal-header {
      padding: 1rem !important;
    }
    .modal-body {
      padding: 1rem !important;
    }
    .project-details {
      padding: 1rem !important;
      margin-bottom: 1.5rem !important;
    }
    .rubric-item {
      padding: 1rem !important;
    }
  }

  .modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--brd);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .modal-header h2 { margin: 0; font-size: 1.5rem; color: var(--txt-1); }
  
  .icon-btn {
    background: none; border: none; color: var(--txt-2);
    cursor: pointer; padding: 0.5rem; border-radius: 50%;
    transition: all var(--t-fast);
  }
  .icon-btn:hover { background: var(--bg-input); color: var(--txt-1); }

  .modal-body {
    padding: 1.5rem;
    overflow-y: auto;
    flex: 1;
  }

  .project-details {
    background: var(--bg-input);
    padding: 1.5rem;
    border-radius: var(--r-md);
    margin-bottom: 2rem;
  }
  .project-details h4 { margin: 0 0 0.5rem 0; color: var(--txt-1); font-size: 1rem;}
  .project-details p { margin: 0 0 1.5rem 0; color: var(--txt-2); line-height: 1.6; font-size: 0.95rem; }
  
  .links-grid {
    display: flex; gap: 1rem; flex-wrap: wrap;
  }
  .link-item {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; background: var(--bg-card);
    border: 1px solid var(--brd); border-radius: var(--r-sm);
    color: var(--txt-1); text-decoration: none; font-size: 0.9rem; font-weight: 500;
    transition: border-color var(--t-fast);
  }
  .link-item:hover { border-color: var(--c1); color: var(--c1); }

  .rubric-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .rubric-grid { grid-template-columns: 1fr 1fr; }
  }

  .rubric-item {
    background: var(--bg-card);
    border: 1px solid var(--brd);
    padding: 1.5rem;
    border-radius: var(--r-md);
    margin: 0;
  }
  
  .rubric-header {
    display: flex; justify-content: space-between; align-items: center;
    gap: 0.75rem; margin-bottom: 0.5rem;
  }
  .rubric-legend {
    font-weight: 600; color: var(--txt-1);
    font-size: 1rem; line-height: 1.3;
  }
  .weight-pill {
    background: rgba(var(--c1r), 0.1); color: var(--c1);
    font-weight: 700; font-size: 0.8rem;
    padding: 0.2rem 0.6rem; border-radius: 999px;
    flex-shrink: 0;
  }

  .rubric-desc { font-size: 0.85rem; color: var(--txt-m); margin-bottom: 1rem; line-height: 1.4; clear: both; }

  /* Escala 1 a 5 */
  .scale-group {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .scale-option {
    margin: 0;
    cursor: pointer;
  }
  .scale-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .scale-box {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--brd);
    border-radius: var(--r-sm);
    background: var(--bg-input);
    color: var(--txt-2);
    font-weight: 700;
    font-size: 1.05rem;
    transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .scale-option:hover .scale-box { border-color: var(--c1); color: var(--c1); }
  .scale-option input:checked + .scale-box {
    background: var(--c1);
    border-color: var(--c1);
    color: #fff;
  }
  .scale-option input:focus-visible + .scale-box {
    outline: 2px solid var(--c1);
    outline-offset: 2px;
  }
  .scale-legend {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--txt-m);
  }

  /* Totales en vivo */
  .running-total {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    background: var(--bg-input);
    border-radius: var(--r-md);
  }
  .running-total-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .running-total-label { font-size: 0.85rem; color: var(--txt-2); }
  .running-total-value { font-size: 1.5rem; font-weight: 700; color: var(--txt-1); }
  .running-total-hint {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.85rem;
    color: var(--txt-m);
  }

  .score-weighted { font-size: 0.8rem; color: var(--txt-m); }

  /* Instructivo del jurado */
  .instructivo {
    padding: 0;
    margin-bottom: 2.5rem;
    border: 1px solid var(--brd);
    overflow: hidden;
  }
  .instructivo summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-weight: 700;
    color: var(--txt-1);
    list-style: none;
  }
  .instructivo summary::-webkit-details-marker { display: none; }
  .instructivo summary::after {
    content: '';
    margin-left: auto;
    width: 8px; height: 8px;
    border-right: 2px solid var(--txt-2);
    border-bottom: 2px solid var(--txt-2);
    transform: rotate(45deg);
    transition: transform var(--t-fast);
  }
  .instructivo[open] summary::after { transform: rotate(-135deg); }
  .instructivo summary svg { color: var(--c1); flex-shrink: 0; }

  .instructivo-body {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--brd-s);
  }
  .instructivo-body section { margin-top: 1.75rem; }
  .instructivo-body h3 {
    font-size: 1.05rem;
    color: var(--txt-1);
    margin: 0 0 0.75rem 0;
  }
  .instructivo-body ul { margin: 0; padding-left: 1.25rem; }
  .instructivo-body li {
    color: var(--txt-2);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  .instructivo-note {
    color: var(--txt-2);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0.75rem 0 0;
  }
  .criteria-guide {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (min-width: 768px) {
    .criteria-guide { grid-template-columns: 1fr 1fr; }
  }
  .criteria-guide-item {
    background: var(--bg-input);
    border-radius: var(--r-md);
    padding: 1rem 1.25rem;
  }
  .criteria-guide-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }
  .criteria-guide-head h4 {
    margin: 0;
    font-size: 0.98rem;
    color: var(--txt-1);
  }
  .criteria-guide-q {
    margin: 0 0 0.6rem;
    font-size: 0.88rem;
    color: var(--txt-2);
    line-height: 1.5;
  }
  .criteria-guide-item li { font-size: 0.85rem; }
  .scale-guide { list-style: none; padding-left: 0; }

  .w-100 { width: 100%; }

  .feedback-textarea {
    width: 100%;
    background: var(--bg-input);
    color: var(--txt-1);
    border: 1px solid var(--brd);
    border-radius: var(--r-md);
    padding: 0.75rem;
    resize: vertical;
    min-height: 80px;
    font-family: inherit;
    margin-top: 0.5rem;
    transition: border-color var(--t-fast);
  }
  .feedback-textarea:focus {
    outline: none;
    border-color: var(--c1);
  }

  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--c1);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: var(--r-md);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transform: translateY(100px);
    opacity: 0;
    transition: all var(--t-normal);
    z-index: 2000;
    pointer-events: none;
  }
  .toast.show {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  import { createBrowserClient } from '@supabase/ssr';
  import { CRITERIA, rawScore, weightedScore } from '../lib/rubric';

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // --- Modal Logic ---
  const modal = document.getElementById('eval-modal');
  const closeBtn = document.getElementById('close-modal');
  const evalBtns = document.querySelectorAll('.evaluate-btn');
  
  const modalTitle = document.getElementById('modal-project-title');
  const modalProblem = document.getElementById('modal-problem');
  const modalSolution = document.getElementById('modal-solution');
  const modalPrototype = document.getElementById('modal-prototype') as HTMLAnchorElement;
  const modalMaterial = document.getElementById('modal-material') as HTMLAnchorElement;
  const formProjectId = document.getElementById('form-project-id') as HTMLInputElement;
  const editingNotice = document.getElementById('modal-editando') as HTMLElement;
  const editingDate = document.getElementById('modal-editando-fecha') as HTMLElement;

  /**
   * Voto ya guardado que se está corrigiendo, o null si es una evaluación nueva.
   * Decide si el submit inserta o actualiza, y el texto del botón.
   */
  let votoEnEdicion: Record<string, any> | null = null;

  function openModal(project: any, votoGuardado: Record<string, any> | null = null) {
    if (!modal || !modalTitle || !modalProblem || !modalSolution || !formProjectId) return;

    // Limpiar la puntuación del proyecto anterior (los radios conservan estado)
    form?.reset();
    refreshTotals();

    modalTitle.textContent = project.title;
    modalProblem.textContent = project.description_problem || 'Sin descripción del problema.';
    modalSolution.textContent = project.description_solution || 'Sin descripción de la solución.';
    
    if (project.url_prototype && modalPrototype) {
      modalPrototype.href = project.url_prototype;
      modalPrototype.style.display = 'inline-flex';
    } else if (modalPrototype) {
      modalPrototype.style.display = 'none';
    }

    if (project.url_support_material && modalMaterial) {
      modalMaterial.href = project.url_support_material;
      modalMaterial.style.display = 'inline-flex';
    } else if (modalMaterial) {
      modalMaterial.style.display = 'none';
    }

    formProjectId.value = project.id;

    // Corrección: precargar los puntajes y el feedback ya guardados.
    votoEnEdicion = votoGuardado;

    if (votoGuardado) {
      for (const c of CRITERIA) {
        const valor = votoGuardado[c.key];
        if (valor == null) continue;
        const radio = form?.querySelector<HTMLInputElement>(
          `input[name="score_${c.key}"][value="${valor}"]`,
        );
        if (radio) radio.checked = true;
      }

      const feedbackEl = form?.querySelector<HTMLTextAreaElement>('#feedback');
      if (feedbackEl) feedbackEl.value = votoGuardado.feedback || '';

      // Los totales se recalculan recién ahora, con los radios ya marcados.
      refreshTotals();
    }

    if (editingNotice) editingNotice.hidden = !votoGuardado;
    if (editingDate) {
      editingDate.textContent = votoGuardado?.updated_at
        ? `Guardada el ${new Date(votoGuardado.updated_at).toLocaleString('es-AR')}.`
        : '';
    }
    if (submitBtn) {
      submitBtn.textContent = votoGuardado ? 'Actualizar Evaluación' : 'Guardar Evaluación';
    }

    modal.classList.add('show');
    document.body.style.overflow = 'hidden'; // prevent background scrolling
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('show');
    document.body.style.overflow = '';
  }

  evalBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.project-card');
      if (card) {
        const projectData = JSON.parse(card.getAttribute('data-project') || '{}');
        // Las tarjetas ya evaluadas traen el voto guardado; las pendientes no.
        const raw = card.getAttribute('data-evaluacion');
        openModal(projectData, raw ? JSON.parse(raw) : null);
      }
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // --- Totales en vivo (suma directa y ponderado) ---
  const totalRawEl = document.getElementById('total-raw');
  const totalWeightedEl = document.getElementById('total-weighted');
  const totalHintEl = document.getElementById('total-hint');

  function currentScores(): Record<string, number> {
    const scores: Record<string, number> = {};
    CRITERIA.forEach(c => {
      const checked = document.querySelector<HTMLInputElement>(
        `input[name="score_${c.key}"]:checked`
      );
      if (checked) scores[c.key] = parseInt(checked.value, 10);
    });
    return scores;
  }

  function refreshTotals() {
    const scores = currentScores();
    const answered = Object.keys(scores).length;
    const complete = answered === CRITERIA.length;

    if (totalRawEl) totalRawEl.textContent = complete ? String(rawScore(scores)) : '—';
    if (totalWeightedEl) totalWeightedEl.textContent = complete ? weightedScore(scores).toFixed(1) : '—';
    if (totalHintEl) {
      const missing = CRITERIA.length - answered;
      totalHintEl.textContent = complete
        ? 'Todos los criterios puntuados. Ya podés guardar.'
        : `Falta${missing === 1 ? '' : 'n'} ${missing} criterio${missing === 1 ? '' : 's'} por puntuar.`;
    }
  }

  document.querySelectorAll('.scale-group input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', refreshTotals);
  });

  // --- Form Submission ---
  const form = document.getElementById('evaluation-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-eval-btn') as HTMLButtonElement;
  
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toast-msg');

  function showToast(message: string, isError = false) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.style.background = isError ? 'var(--er)' : 'var(--c1)';
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    // Los radios están ocultos visualmente: validamos acá en lugar de con `required`,
    // que en ese caso bloquea el submit sin mostrar ningún mensaje.
    const missing = CRITERIA.filter(c => !document.querySelector(`input[name="score_${c.key}"]:checked`));
    if (missing.length > 0) {
      showToast(`Falta puntuar: ${missing.map(c => c.label).join(', ')}`, true);
      document
        .querySelector(`input[name="score_${missing[0].key}"]`)
        ?.closest('.rubric-item')
        ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const estabaEditando = Boolean(votoEnEdicion);
    submitBtn.disabled = true;
    submitBtn.textContent = estabaEditando ? 'Actualizando...' : 'Guardando...';

    const formData = new FormData(form);
    const evaluationData: Record<string, unknown> = {
      project_id: formData.get('project_id'),
      judge_id: formData.get('judge_id'),
      phase: formData.get('phase'),
      feedback: formData.get('feedback')
    };
    CRITERIA.forEach(c => {
      evaluationData[`score_${c.key}`] = parseInt(formData.get(`score_${c.key}`) as string, 10);
    });

    // upsert en vez de insert: un solo camino para votar y para corregir.
    // El conflicto lo resuelve el UNIQUE(project_id, judge_id, phase) de la
    // tabla, y la policy RLS "Judges can update own evaluations" ya permite el
    // UPDATE si el voto es propio, el juez está aprobado y la fase es la activa.
    const { error } = await supabase
      .from('evaluations')
      .upsert(evaluationData, { onConflict: 'project_id,judge_id,phase' });

    if (error) {
      console.error('Error saving evaluation:', error);
      showToast('Error al guardar la evaluación. ' + error.message, true);
      submitBtn.disabled = false;
      submitBtn.textContent = estabaEditando ? 'Actualizar Evaluación' : 'Guardar Evaluación';
    } else {
      showToast(estabaEditando ? '¡Evaluación actualizada!' : '¡Evaluación guardada con éxito!');
      closeModal();
      // Recargar la página para mover el proyecto a "Completados"
      setTimeout(() => {
        window.location.reload();
      }, 1000);
    }
  });
</script>
