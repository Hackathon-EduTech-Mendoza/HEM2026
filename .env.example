# ====================================
# Variables de entorno - HEM2026
# ====================================
# Copiá este archivo como .env y completá con tus valores reales.
# NUNCA subas el archivo .env al repositorio.

# Supabase
PUBLIC_SUPABASE_URL=tu_url_aqui
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase — credenciales privadas de mantenimiento (NO usar desde el navegador).
# Solo para scripts de administración: limpieza de usuarios, migraciones.
# SERVICE_ROLE saltea todas las políticas RLS: tratala como una contraseña de root.
# Dashboard → Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
# Dashboard → Settings → Database → Connection string (URI). Sirve para `supabase db push`.
SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Sentry
PUBLIC_SENTRY_DSN=tu_dsn_aqui

# Brevo (Comunicados masivos) — SIN prefijo PUBLIC_, son privadas
BREVO_API_KEY=tu_api_key_de_brevo
BREVO_SENDER_EMAIL=tu_email_remitente_aqui
BREVO_SENDER_NAME=tu_nombre_remitente_aqui
